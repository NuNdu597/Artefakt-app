    "The Mandalorian (2019)","Succession (2018)","The Boys (2019)","Ted Lasso (2020)","The Last of Us (2023)","Wednesday (2022)"
  ];
  const EXPENSE_TYPES = {
    "Storage": "#d6735f", "Shipping": "#c77fa0", "Customs/Duty": "#dcc07a",
    "Insurance": "#7aa3d6", "Restoration/Repair": "#9cc26f", "Authentication/Appraisal": "#9585d6",
    "Cleaning/Maintenance": "#5fb3a6", "Other": "#96938c"
  };
  const CURRENCIES = ["USD","EUR","GBP"];
  const CURRENCY_SYMBOL = {USD:"$", EUR:"\u20AC", GBP:"\u00A3"};

  function escapeHtml(s){ const d=document.createElement('div'); d.textContent = s==null?'':s; return d.innerHTML; }
  function typeColor(type){ return (TYPES[type]||{}).color || '#6b6558'; }
  function accessionNumber(it){
    const year = (it.date && it.date.slice(0,4)) || (it.acquisitionDate && it.acquisitionDate.slice(0,4)) || new Date().getFullYear();
    const idNum = Math.floor(Math.abs(Number(it.id) || 0));
    const seq = String(idNum % 10000).padStart(4,'0');
    return `ARF-${year}-${seq}`;
  }
  function fmtMoney(n, currency){
    const sym = CURRENCY_SYMBOL[currency] || '$';
    return sym + num(n).toLocaleString(undefined, {minimumFractionDigits:0, maximumFractionDigits:2});
  }
  const prefersReducedMotion = (()=>{ try{ return window.matchMedia('(prefers-reduced-motion: reduce)').matches; }catch(e){ return false; } })();
  function animateNumber(el, toValue, formatFn, duration){
    if(!el) return;
    duration = duration || 650;
    const fromValue = parseFloat(el.dataset.rawValue || '0') || 0;
    el.dataset.rawValue = String(toValue);
    if(prefersReducedMotion || Math.abs(toValue - fromValue) < 0.005){
      el.textContent = formatFn(toValue);
      return;
    }
    const start = performance.now();
    function tick(now){
      const elapsed = now - start;
      const progress = Math.min(1, elapsed / duration);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = fromValue + (toValue - fromValue) * eased;
      el.textContent = formatFn(current);
      if(progress < 1) requestAnimationFrame(tick);
      else el.textContent = formatFn(toValue);
    }
    requestAnimationFrame(tick);
  }
  const MONTH_ABBR = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  function fmtDate(d){
    if(!d) return '\u2014';
    const dt = new Date(d + 'T00:00:00');
    if(isNaN(dt.getTime())) return '\u2014';
    return `${MONTH_ABBR[dt.getMonth()]} ${dt.getDate()}, ${dt.getFullYear()}`;
  }
  function num(v){
    const n = Number(v);
    return isNaN(n) ? 0 : n;
  }
  function holdingPeriod(dateStr){
    if(!dateStr) return '';
    const start = new Date(dateStr + 'T00:00:00');
    const now = new Date();
    if(isNaN(start.getTime()) || start > now) return '';
    let years = now.getFullYear() - start.getFullYear();
    let months = now.getMonth() - start.getMonth();
    let days = now.getDate() - start.getDate();
    if(days < 0){
      months -= 1;
      const prevMonthLastDay = new Date(now.getFullYear(), now.getMonth(), 0).getDate();
      days += prevMonthLastDay;
    }
    if(months < 0){ years -= 1; months += 12; }
    if(years > 0) return `Held ${years}y ${months}mo`;
    if(months > 0) return `Held ${months}mo ${days}d`;
    return `Held ${days}d`;
  }
  function initials(name){
    const words = (name||'').replace(/[^a-zA-Z0-9\s]/g,'').split(/\s+/).filter(Boolean);
    const stop = new Set(['the','a','an','of','and']);
    const sig = words.filter(w=>!stop.has(w.toLowerCase()));
    const use = (sig.length?sig:words).slice(0,2);
    let ini = use.map(w=>w[0].toUpperCase()).join('');
    if(!ini) ini = (name||'??').slice(0,2).toUpperCase();
    return ini;
  }
  function hasOffer(it){ return num(it.minOffer) > 0 && num(it.price) > 0; }
  function profitAmount(it){ return num(it.minOffer) - num(it.price); }
  function profitPct(it){ return num(it.price) > 0 ? (profitAmount(it) / num(it.price)) * 100 : null; }
  function profitClass(v){ return v > 0.001 ? 'profit-pos' : (v < -0.001 ? 'profit-neg' : 'profit-flat'); }
  function soldProfitInfo(it){
    if(!it.soldPrice) return null;
    const paidUSD = convertToUSD(num(it.price), it.currency||'USD');
    const soldUSD = convertToUSD(num(it.soldPrice), it.soldCurrency||'USD');
    if(paidUSD <= 0) return null;
    const pct = ((soldUSD - paidUSD)/paidUSD)*100;
    return { pct, text: `${pct>=0?'+':''}${pct.toFixed(1)}%`, cls: profitClass(pct) };
  }
  function fmtPct(v){ if(v===null || v===undefined || isNaN(v)) return '\u2014'; return (v>0?'+':'') + v.toFixed(1) + '%'; }

  /* ---------- Tabs ---------- */
  document.querySelectorAll('.tabbtn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('.tabbtn').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.tabpane').forEach(p=>p.classList.remove('active'));
      btn.classList.add('active');
      const pane = document.getElementById('tab-'+btn.dataset.tab);
      pane.classList.add('active');
      pane.classList.remove('tab-fade-in');
      requestAnimationFrame(()=>{ requestAnimationFrame(()=>{ pane.classList.add('tab-fade-in'); }); });
      if(btn.dataset.tab==='expenses') renderExpenses();
      if(btn.dataset.tab==='wishlist') renderWishlist();
      if(btn.dataset.tab==='catalogue') renderCatalogue();
      if(btn.dataset.tab==='exit') renderExit();
      if(btn.dataset.tab==='ledger') renderContactCards();
      if(btn.dataset.tab==='consign'){ populateConsignItemSelect(); updateHouseSuggestions(); renderConsignHouseFilter(); renderConsignStatusChips(); renderConsignments(); }
      if(btn.dataset.tab==='loans'){ populateLoanItemSelect(); updateBorrowerSuggestions(); renderLoanStatusChips(); renderLoans(); }
      if(btn.dataset.tab==='overview'){ renderOverview(); checkBackupReminder(); }
    });
  });

  /* ---------- View toggle (gallery / list) ---------- */
  const VIEW_KEY = 'rackLedgerView_v1';
  let viewMode = 'gallery';
  try{ viewMode = localStorage.getItem(VIEW_KEY) || 'gallery'; }catch(e){}
  function syncViewButtons(){
    document.querySelectorAll('.vt-btn').forEach(b=> b.classList.toggle('active', b.dataset.view===viewMode));
  }
  document.querySelectorAll('.vt-btn').forEach(b=>{
    b.addEventListener('click', ()=>{
      viewMode = b.dataset.view;
      try{ localStorage.setItem(VIEW_KEY, viewMode); }catch(e){}
      syncViewButtons(); render();
    });
  });

  /* ---------- Exchange rates ---------- */
  const RATES_KEY = 'rackLedgerRates_v2';
  let usdPerUnit = {EUR:null, GBP:null};
  let ratesDate = null;
  let ratesLive = false;

  const eurRateInput = document.getElementById('eurRateInput');
  const gbpRateInput = document.getElementById('gbpRateInput');

  function loadCachedRates(){
    try{
      const raw = localStorage.getItem(RATES_KEY);
      if(raw){ const parsed = JSON.parse(raw); usdPerUnit = parsed.usdPerUnit; ratesDate = parsed.date; }
    }catch(e){}
  }
  function persistRates(){
    try{ localStorage.setItem(RATES_KEY, JSON.stringify({usdPerUnit, date:ratesDate})); }catch(e){}
  }
  function syncRateInputs(){
    if(document.activeElement !== eurRateInput) eurRateInput.value = usdPerUnit.EUR ? usdPerUnit.EUR.toFixed(4) : '';
    if(document.activeElement !== gbpRateInput) gbpRateInput.value = usdPerUnit.GBP ? usdPerUnit.GBP.toFixed(4) : '';
  }

  async function fetchRates(){
    const rateInfoEl = document.getElementById('rateInfo');
    rateInfoEl.textContent = 'fetching live rates...';
    try{
      const [eurRes, gbpRes] = await Promise.all([
        fetch('https://api.frankfurter.app/latest?from=EUR&to=USD'),
        fetch('https://api.frankfurter.app/latest?from=GBP&to=USD')
      ]);
      if(!eurRes.ok || !gbpRes.ok) throw new Error('bad response');
      const eurData = await eurRes.json();
      const gbpData = await gbpRes.json();
      usdPerUnit = {EUR: eurData.rates.USD, GBP: gbpData.rates.USD};
      ratesDate = eurData.date; ratesLive = true;
      rateInfoEl.dataset.errorShown = 'false';
      persistRates();
    }catch(e){
      ratesLive = false;
      if(!usdPerUnit.EUR && !usdPerUnit.GBP) loadCachedRates();
      rateInfoEl.dataset.errorShown = 'true';
      rateInfoEl.textContent = "Couldn't reach the rate service from here \u2014 enter rates by hand above, or open the downloaded file directly in Safari/Chrome and try 'fetch live' again.";
    }
    syncRateInputs();
    renderAll();
  }

  eurRateInput.addEventListener('change', ()=>{
    const v = parseFloat(eurRateInput.value);
    usdPerUnit.EUR = v > 0 ? v : null;
    ratesDate = 'manual entry'; ratesLive = false;
    document.getElementById('rateInfo').dataset.errorShown = 'false';
    persistRates(); renderAll();
  });
  gbpRateInput.addEventListener('change', ()=>{
    const v = parseFloat(gbpRateInput.value);
    usdPerUnit.GBP = v > 0 ? v : null;
    ratesDate = 'manual entry'; ratesLive = false;
    document.getElementById('rateInfo').dataset.errorShown = 'false';
    persistRates(); renderAll();
  });

  function convertToUSD(amount, currency){
    if(currency==='USD' || !currency) return amount;
    const r = usdPerUnit[currency];
    if(!r) return amount;
    return amount * r;
  }
  function renderAll(){
    if(editingId === null){
      render();
    } else {
      renderCurrencyCards();
      renderGoal();
      renderTypeBars();
    }
    if(document.getElementById('tab-expenses').classList.contains('active')){
      if(typeof editingExpenseId === 'undefined' || editingExpenseId === null){
        renderExpenses();
      } else {
        renderExpenseStats();
        renderExpenseBars();
      }
    }
    if(document.getElementById('tab-wishlist').classList.contains('active')){
      if(typeof editingWishlistId === 'undefined' || editingWishlistId === null){
        renderWishlist();
      } else if(typeof renderWishlistStats === 'function'){
        renderWishlistStats();
      }
    }
  }

  /* ================= COLLECTION (items) ================= */
  const nameInput = document.getElementById('fName');
  const brandInput = document.getElementById('fBrand');
  const productionInput = document.getElementById('fProduction');
  const sourceInput = document.getElementById('fSource');
  const typeSelect = document.getElementById('fType');
  const catSelect = document.getElementById('fCat');
  const catHint = document.getElementById('catHint');
  const dateInput = document.getElementById('fDate');
  dateInput.value = new Date().toISOString().slice(0,10);

  const SOURCE_STARTERS = ["Propstore","Heritage Auctions","Julien's Auctions","Bonhams","Christie's","Sotheby's","RR Auction","Prop Store of London","eBay","Reverb","Charity Auction","Private Sale","Estate Sale","Direct from Artist/Team","Gallery"];
  function uniqueCaseInsensitive(list){
    const seen = new Set();
    return list.filter(s=>{
      const key = s.toLowerCase();
      if(seen.has(key)) return false;
      seen.add(key); return true;
    });
  }
  function updateSourceSuggestions(){
    const dl = document.getElementById('sourceSuggestions');
    const used = items.map(it=>it.source).filter(Boolean);
    const unique = uniqueCaseInsensitive([...SOURCE_STARTERS, ...used]);
    dl.innerHTML = unique.map(s=>`<option value="${escapeHtml(s)}">`).join('');
  }
  function updateBrandSuggestions(){
    const dl = document.getElementById('brandSuggestions');
    const used = items.map(it=>it.brand).filter(Boolean);
    const unique = uniqueCaseInsensitive(used);
    dl.innerHTML = unique.map(s=>`<option value="${escapeHtml(s)}">`).join('');
  }
  function updateLocationSuggestions(){
    const dl = document.getElementById('locationSuggestions');
    const used = items.map(it=>it.location).filter(Boolean);
    const unique = uniqueCaseInsensitive(used);
    dl.innerHTML = unique.map(s=>`<option value="${escapeHtml(s)}">`).join('');
  }
  function updateSetSuggestions(){
    const dl = document.getElementById('setSuggestions');
    const used = items.map(it=>it.set).filter(Boolean);
    const unique = uniqueCaseInsensitive(used);
    dl.innerHTML = unique.map(s=>`<option value="${escapeHtml(s)}">`).join('');
  }
  function updateAppraiserSuggestions(){
    const dl = document.getElementById('appraiserSuggestions');
    const used = items.map(it=>it.appraisedBy).filter(Boolean);
    const unique = uniqueCaseInsensitive(used);
    dl.innerHTML = unique.map(s=>`<option value="${escapeHtml(s)}">`).join('');
  }

  Object.keys(TYPES).forEach(t=>{
    const opt = document.createElement('option'); opt.value=t; opt.textContent=t; typeSelect.appendChild(opt);
  });

  function populateSubcategories(selectEl, type, selected){
    selectEl.innerHTML = '';
    const subs = TYPES[type] ? Object.keys(TYPES[type].subs) : [];
    subs.forEach(s=>{
      const opt = document.createElement('option'); opt.value=s; opt.textContent=s; selectEl.appendChild(opt);
    });
    if(selected && subs.includes(selected)) selectEl.value = selected;
  }
  populateSubcategories(catSelect, typeSelect.value);
  typeSelect.addEventListener('change', ()=>{ populateSubcategories(catSelect, typeSelect.value); updateProductionSuggestions(typeSelect.value); });
  function updateProductionSuggestions(type){
    const dl = document.getElementById('productionSuggestions');
    let curated = [];
    if(type === 'Movie Memorabilia') curated = MOVIE_LIST;
    else if(type === 'TV Memorabilia') curated = TV_LIST;
    const used = items.map(it=>it.production).filter(Boolean);
    const unique = uniqueCaseInsensitive([...used, ...curated]);
    dl.innerHTML = unique.map(t=>`<option value="${escapeHtml(t)}">`).join('');
  }

  function detectCategory(text, preferredType){
    const lower = " " + text.toLowerCase() + " ";
    if(preferredType && TYPES[preferredType]){
      for(const [sub, keys] of Object.entries(TYPES[preferredType].subs)){
        if(keys.some(k => lower.includes(k))) return {type: preferredType, sub};
      }
    }
    for(const [type, def] of Object.entries(TYPES)){
      if(type === preferredType) continue;
      for(const [sub, keys] of Object.entries(def.subs)){
        if(keys.some(k => lower.includes(k))) return {type, sub};
      }
    }
    return null;
  }
  let autoDetected = false;
  nameInput.addEventListener('input', ()=>{
    const guess = detectCategory(nameInput.value + ' ' + brandInput.value, typeSelect.value);
    if(guess){
      typeSelect.value = guess.type;
      populateSubcategories(catSelect, guess.type, guess.sub);
      catHint.textContent = "Auto-tagged as " + guess.type + " \u2192 " + guess.sub + " - change it if that's wrong";
      autoDetected = true;
    } else if(autoDetected){
      catHint.textContent = "\u00A0"; autoDetected = false;
    }
  });

  /* ===== Google Drive sync config =====
     Fill in your own OAuth Client ID from Google Cloud Console (see setup guide).
     This app uses only the 'drive.file' scope — it can only see/edit files it creates itself. */
  const GOOGLE_CLIENT_ID = '204663395661-fti8kprd19aaimv0paeqa29a6t16oddt.apps.googleusercontent.com';

  const STORAGE_KEY = 'rackLedgerItems_v3';
  let storageOK = true;
  let items = [];
  function loadItems(){
    try{ const raw = localStorage.getItem(STORAGE_KEY); items = raw ? JSON.parse(raw) : []; }
    catch(e){ storageOK = false; items = []; }
  }
  function saveItems(){
    try{
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      if(!localStorage.getItem(STORAGE_KEY)) storageOK = false;
    }catch(e){ storageOK = false; }
    document.getElementById('storageNotice').classList.toggle('show', !storageOK);
    document.getElementById('storageNotice').textContent = "Bu tarayici oturumu kalici depolamayi guvenilir tutmuyor olabilir, bu yuzden liste sayfa yenilendiginde sifirlanabilir. En guvenlisi: bu dosyayi indirip Safari/Chrome'da dogrudan acmak, ve arada bir Backup (JSON) ile yedek almak.";
    schedulePersist();
  }

  function migrateOldConsignmentsAndLoans(){
    const MIGRATION_FLAG = 'rackLedgerMigratedConsignLoan_v1';
    try{ if(localStorage.getItem(MIGRATION_FLAG)) return; }catch(e){ return; }
    let migratedAny = false;

    function findOrCreateItem(name, fallbackDate){
      let matched = items.find(it => it.name === name && (!it.itemStatus || it.itemStatus === 'collection'));
      if(!matched){
        matched = {
          id: Date.now()+Math.random(), name, brand:'', production:'', source:'',
          type:'Music Memorabilia', category:'Other', price:0, currency:'USD',
          insuredValue:0, minOffer:0, location:'', date: fallbackDate || new Date().toISOString().slice(0,10)
        };
        items.push(matched);
      }
      return matched;
    }

    try{
      const raw = localStorage.getItem('rackLedgerConsignments_v1');
      if(raw){
        const old = JSON.parse(raw);
        if(Array.isArray(old) && old.length){
          old.forEach(c=>{
            if(!c || !c.name) return;
            const it = findOrCreateItem(c.name, c.saleDate);
            it.itemStatus = 'consigned';
            it.consignHouse = c.house || '';
            it.consignLot = c.lot || '';
            it.consignSaleDate = c.saleDate || '';
            it.consignEstLow = num(c.estLow);
            it.consignEstHigh = num(c.estHigh);
            it.consignCurrency = c.currency || 'USD';
            it.consignSaleStatus = c.status || 'listed';
            it.consignListingType = c.listingType || 'auction';
            it.consignCurrentLoc = c.currentLoc || '';
            it.consignSoldPrice = num(c.soldPrice);
            it.consignNote = c.note || '';
          });
          migratedAny = true;
        }
      }
    }catch(e){}

    try{
      const raw = localStorage.getItem('rackLedgerLoans_v1');
      if(raw){
        const old = JSON.parse(raw);
        if(Array.isArray(old) && old.length){
          old.forEach(l=>{
            if(!l || !l.name) return;
            const it = findOrCreateItem(l.name, l.loanDate);
            it.itemStatus = 'loaned';
            it.loanBorrower = l.borrower || '';
            it.loanDate = l.loanDate || '';
            it.loanReturnDate = l.returnDate || '';
            it.loanReturnedDate = l.returnedDate || '';
            it.loanNote = l.note || '';
          });
          migratedAny = true;
        }
      }
    }catch(e){}

    if(migratedAny){ saveItems(); }
    try{ localStorage.setItem(MIGRATION_FLAG, '1'); }catch(e){}
  }
  loadItems();
  migrateOldConsignmentsAndLoans();
  updateSourceSuggestions();
  updateBrandSuggestions();
  updateLocationSuggestions();
  updateSetSuggestions();
  updateAppraiserSuggestions();
  updateProductionSuggestions(typeSelect.value);

  const GOAL_KEY = 'rackLedgerGoal_v1';
  const goalInput = document.getElementById('goalInput');
  try{ const savedGoal = localStorage.getItem(GOAL_KEY); if(savedGoal) goalInput.value = savedGoal; }catch(e){}
  goalInput.addEventListener('change', ()=>{ try{ localStorage.setItem(GOAL_KEY, goalInput.value); }catch(e){} renderGoal(); schedulePersist(); });
  document.getElementById('refreshRates').addEventListener('click', fetchRates);
  document.getElementById('goalSettingsToggle').addEventListener('click', ()=>{
    const panel = document.getElementById('goalSettingsPanel');
    const btn = document.getElementById('goalSettingsToggle');
    const open = panel.classList.toggle('open');
    btn.textContent = open ? 'Close settings' : 'Settings';
  });

  let activeType = 'All';
  let editingId = null;

  const typeFilterSelect = document.getElementById('typeFilterSelect');
  function populateTypeFilterOptions(){
    const opts = ['All', ...Object.keys(TYPES)];
    typeFilterSelect.innerHTML = opts.map(t=>`<option value="${escapeHtml(t)}">${t==='All'?'All types':escapeHtml(t)}</option>`).join('');
    typeFilterSelect.value = activeType;
  }
  typeFilterSelect.addEventListener('change', ()=>{
    activeType = typeFilterSelect.value;
    renderSubFilter();
    render();
  });

  const subFilterEl = document.getElementById('subFilter');
  function renderSubFilter(){
    subFilterEl.innerHTML = '';
    const allOpt = document.createElement('option'); allOpt.value='All'; allOpt.textContent='All subcategories';
    subFilterEl.appendChild(allOpt);
    const types = activeType==='All' ? Object.keys(TYPES) : [activeType];
    const seen = new Set();
    types.forEach(t=>{
      Object.keys(TYPES[t].subs).forEach(s=>{
        if(!seen.has(s)){ seen.add(s); const opt=document.createElement('option'); opt.value=s; opt.textContent=s; subFilterEl.appendChild(opt); }
      });
    });
  }
  renderSubFilter();
  subFilterEl.addEventListener('change', render);

  const locationFilterSelect = document.getElementById('locationFilterSelect');
  function populateLocationFilterOptions(){
    const current = locationFilterSelect.value;
    const locs = uniqueCaseInsensitive(items.map(it=>it.location).filter(Boolean));
    locationFilterSelect.innerHTML = '<option value="All">All locations</option>' + locs.map(l=>`<option value="${escapeHtml(l)}">${escapeHtml(l)}</option>`).join('');
    if(locs.includes(current)) locationFilterSelect.value = current;
  }
  locationFilterSelect.addEventListener('change', render);

  const itemStatusFilterSelect = document.getElementById('itemStatusFilterSelect');
  itemStatusFilterSelect.addEventListener('change', render);

  /* Filter popovers: open/close on trigger click, close on outside click */
  document.querySelectorAll('.filter-dd').forEach(dd=>{
    const trigger = dd.querySelector('.filter-trigger');
    const pop = dd.querySelector('.filter-popover');
    trigger.addEventListener('click', (e)=>{
      e.stopPropagation();
      const willOpen = !pop.classList.contains('open');
      document.querySelectorAll('.filter-popover.open').forEach(p=>p.classList.remove('open'));
      document.querySelectorAll('.filter-trigger.open').forEach(t=>t.classList.remove('open'));
      if(willOpen){ pop.classList.add('open'); trigger.classList.add('open'); }
    });
  });
  document.addEventListener('click', ()=>{
    document.querySelectorAll('.filter-popover.open').forEach(p=>p.classList.remove('open'));
    document.querySelectorAll('.filter-trigger.open').forEach(t=>t.classList.remove('open'));
  });
  document.querySelectorAll('.filter-popover').forEach(p=> p.addEventListener('click', e=> e.stopPropagation()));

  function renderActiveFilters(){
    const box = document.getElementById('activeFilters');
    if(!box) return;
    const tags = [];
    if(activeType !== 'All') tags.push({ label: `Type: ${activeType}`, clear: ()=>{ activeType='All'; typeFilterSelect.value='All'; renderSubFilter(); render(); } });
    if(subFilterEl.value !== 'All') tags.push({ label: `Category: ${subFilterEl.value}`, clear: ()=>{ subFilterEl.value='All'; render(); } });
    if(locationFilterSelect.value !== 'All') tags.push({ label: `Location: ${locationFilterSelect.value}`, clear: ()=>{ locationFilterSelect.value='All'; render(); } });
    if(itemStatusFilterSelect.value !== 'all'){
      const labels = { collection:'In collection', consigned:'Consigned', loaned:'On loan', sold:'Sold' };
      tags.push({ label: `Status: ${labels[itemStatusFilterSelect.value]}`, clear: ()=>{ itemStatusFilterSelect.value='all'; render(); } });
    }
    if(document.getElementById('unverifiedOnly').checked) tags.push({ label: 'Unverified only', clear: ()=>{ document.getElementById('unverifiedOnly').checked=false; render(); } });

    document.getElementById('catFilterTrigger').classList.toggle('has-value', activeType!=='All' || subFilterEl.value!=='All');
    document.getElementById('locFilterTrigger').classList.toggle('has-value', locationFilterSelect.value!=='All');
    document.getElementById('statusFilterTrigger').classList.toggle('has-value', itemStatusFilterSelect.value!=='all' || document.getElementById('unverifiedOnly').checked);

    box.innerHTML = '';
    tags.forEach(t=>{
      const tag = document.createElement('span');
      tag.className = 'filter-tag';
      tag.innerHTML = `${escapeHtml(t.label)} <button type="button">&times;</button>`;
      tag.querySelector('button').addEventListener('click', t.clear);
      box.appendChild(tag);
    });
    if(tags.length > 1){
      const clearAll = document.createElement('button');
      clearAll.type = 'button'; clearAll.className = 'clear-all-filters'; clearAll.textContent = 'Clear all';
      clearAll.addEventListener('click', ()=>{
        activeType='All'; typeFilterSelect.value='All'; renderSubFilter(); subFilterEl.value='All';
        locationFilterSelect.value='All'; itemStatusFilterSelect.value='all';
        document.getElementById('unverifiedOnly').checked=false;
        render();
      });
      box.appendChild(clearAll);
    }
  }

  const listEl = document.getElementById('list');
  const searchEl = document.getElementById('search');
  const sortEl = document.getElementById('sort');

  function renderCurrencyCards(){
    document.getElementById('itemCount').textContent = `${items.length} item${items.length===1?'':'s'} logged`;
    const screenCountEl = document.getElementById('collectionScreenCount');
    if(screenCountEl) screenCountEl.textContent = `${items.length} OBJECT${items.length===1?'':'S'}`;
  }

  function renderGoal(){
    const totalUSD = items.reduce((s,it)=> s + convertToUSD(num(it.price), it.currency||'USD'), 0);
    const goal = parseFloat(goalInput.value) || 1000000;
    const pct = Math.min(100, (totalUSD/goal)*100);
    document.getElementById('goalPct').textContent = pct.toFixed(pct<10?2:1) + '%';
    document.getElementById('goalFill').style.width = Math.max(pct,0) + '%';
    const remaining = Math.max(goal-totalUSD,0);
    document.getElementById('goalSub').textContent = `${fmtMoney(totalUSD,'USD')} of ${fmtMoney(goal,'USD')} \u2014 ${fmtMoney(remaining,'USD')} to go`;
    const rateInfoEl = document.getElementById('rateInfo');
    if(rateInfoEl.dataset.errorShown === 'true') return;
    if(!usdPerUnit.EUR && !usdPerUnit.GBP){
      rateInfoEl.textContent = 'no EUR/GBP rate set \u2014 enter one above, or click "fetch live"';
    } else {
      rateInfoEl.textContent = ratesDate === 'manual entry' ? 'using your rates' : `live rates as of ${ratesDate}`;
    }
  }

  var typeBarsShowAll = false, expenseBarsShowAll = false;
  function barRowsHtml(sums, colorOf, showAll, emptyMsg, emptyNoun){
    const entries = Object.entries(sums);
    const filled = entries.filter(([,v])=>v>0), empty = entries.filter(([,v])=>!(v>0));
    const max = Math.max(1, ...filled.map(([,v])=>v));
    const row = ([t,v])=> `
      <div class="bar-row">
        <div class="bar-label">${escapeHtml(t)}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${(v/max*100)}%;background:${colorOf(t)}"></div></div>
        <div class="bar-amount">${fmtMoney(v,'USD')}</div>
      </div>`;
    let h = filled.length ? filled.map(row).join('') : `<div class="cat-sub" style="padding:6px 0;">${emptyMsg}</div>`;
    if(empty.length){
      h += `<div style="margin-top:10px;"><button type="button" class="cat-btn" data-bars-toggle="1">${showAll ? 'Hide' : 'Show'} ${empty.length} ${emptyNoun}${empty.length===1?'':'s'} with no value</button></div>`;
      if(showAll) h += `<div style="margin-top:8px;opacity:.7;">${empty.map(row).join('')}</div>`;
    }
    return h;
  }
  function renderTypeBars(){
    const box = document.getElementById('typeBars');
    const sums = {};
    Object.keys(TYPES).forEach(t=> sums[t]=0);
    items.forEach(it=>{ sums[it.type] = (sums[it.type]||0) + convertToUSD(num(it.price), it.currency||'USD'); });
    box.innerHTML = barRowsHtml(sums, typeColor, typeBarsShowAll, 'No value logged yet.', 'type');
  }
  document.getElementById('typeBars').addEventListener('click', e=>{ if(e.target.closest('[data-bars-toggle]')){ typeBarsShowAll = !typeBarsShowAll; renderTypeBars(); } });

  function render(){
    const unverifiedOnlyEl = document.getElementById('unverifiedOnly');
    populateLocationFilterOptions();
    let filtered = items.filter(it=>{
      const matchesType = activeType==='All' || it.type===activeType;
      const matchesSub = subFilterEl.value==='All' || it.category===subFilterEl.value;
      const q = searchEl.value.trim().toLowerCase();
      const hay = [it.name,it.brand,it.production,it.source,it.location].filter(Boolean).join(' ').toLowerCase();
      const matchesSearch = !q || hay.includes(q);
      const matchesVerify = !unverifiedOnlyEl || !unverifiedOnlyEl.checked || !it.verifiedDate;
      const matchesLocation = locationFilterSelect.value==='All' || it.location===locationFilterSelect.value;
      const statusVal = itemStatusFilterSelect.value;
      const matchesStatus = statusVal==='all' || (statusVal==='collection' ? (!it.itemStatus||it.itemStatus==='collection') : it.itemStatus===statusVal);
      return matchesType && matchesSub && matchesSearch && matchesVerify && matchesLocation && matchesStatus;
    });
    const sortVal = sortEl.value;
    filtered.sort((a,b)=>{
      if(sortVal==='date-desc') return b.date.localeCompare(a.date) || b.id-a.id;
      if(sortVal==='date-asc') return a.date.localeCompare(b.date) || a.id-b.id;
      if(sortVal==='price-desc') return b.price-a.price;
      if(sortVal==='price-asc') return a.price-b.price;
      if(sortVal==='name-asc') return a.name.localeCompare(b.name);
      return 0;
    });

    listEl.style.opacity = '0.35';
    listEl.className = viewMode==='gallery' ? 'grid-view' : 'list-view';
    const catalogueHead = document.getElementById('catalogueHead');
    if(catalogueHead) catalogueHead.style.display = (viewMode==='list' && filtered.length>0) ? 'grid' : 'none';
    syncViewButtons();
    renderActiveFilters();

    listEl.innerHTML = '';
    if(filtered.length===0){
      const empty = document.createElement('div'); empty.className='empty';
      empty.textContent = items.length===0 ? "No pieces logged yet. Add your first one above." : "Nothing matches that search or filter.";
      listEl.appendChild(empty);
    } else {
      filtered.forEach(it=>{
        if(it.id===editingId){
          { const er = buildEditRow(it, viewMode==='gallery'); attachPhotoManager(er, it); listEl.appendChild(er); }
        } else {
          listEl.appendChild(viewMode==='gallery' ? buildCard(it) : buildRow(it));
        }
      });
    }
    document.getElementById('visCount').textContent = `${filtered.length} of ${items.length} shown`;
    renderCurrencyCards();
    renderGoal();
    renderTypeBars();
    refreshLinkedItemOptions();
    populateConsignItemSelect();
    populateLoanItemSelect();
    requestAnimationFrame(()=>{ listEl.style.opacity = '1'; });
  }

  /* ================= PHOTOS (multi-photo, stored in IndexedDB) ================= */
  const photoCache = {};
  function photoDbOpen(){ return new Promise((res,rej)=>{ const r=indexedDB.open('artefaktPhotos',1); r.onupgradeneeded=()=>r.result.createObjectStore('photos'); r.onsuccess=()=>res(r.result); r.onerror=()=>rej(r.error); }); }
  async function photoDbPut(id,data){ try{ const db=await photoDbOpen(); await new Promise((res,rej)=>{ const tx=db.transaction('photos','readwrite'); tx.objectStore('photos').put(data,id); tx.oncomplete=res; tx.onerror=()=>rej(tx.error); }); }catch(e){} }
  async function photoDbDel(id){ try{ const db=await photoDbOpen(); await new Promise((res,rej)=>{ const tx=db.transaction('photos','readwrite'); tx.objectStore('photos').delete(id); tx.oncomplete=res; tx.onerror=()=>rej(tx.error); }); }catch(e){} }
  async function photoDbLoadAll(){ try{ const db=await photoDbOpen(); await new Promise((res,rej)=>{ const tx=db.transaction('photos','readonly'); const cur=tx.objectStore('photos').openCursor(); cur.onsuccess=()=>{ const c=cur.result; if(c){ photoCache[c.key]=c.value; c.continue(); } }; tx.oncomplete=res; tx.onerror=()=>rej(tx.error); }); }catch(e){} }
  function compressImage(file){ return new Promise((resolve,reject)=>{ const url=URL.createObjectURL(file); const img=new Image(); img.onload=()=>{ const sc=Math.min(1,1400/Math.max(img.width,img.height)); const c=document.createElement('canvas'); c.width=Math.round(img.width*sc); c.height=Math.round(img.height*sc); c.getContext('2d').drawImage(img,0,0,c.width,c.height); URL.revokeObjectURL(url); resolve(c.toDataURL('image/jpeg',0.8)); }; img.onerror=()=>{ URL.revokeObjectURL(url); reject(new Error('bad image')); }; img.src=url; }); }
  async function storePhotos(files){ const ids=[]; for(const f of files){ if(!/^image\//.test(f.type)) continue; try{ const data=await compressImage(f); const id='p'+Date.now().toString(36)+Math.random().toString(36).slice(2,7); photoCache[id]=data; await photoDbPut(id,data); ids.push(id); }catch(e){} } return ids; }
  function itemPhotoIds(it){ return Array.isArray(it.photoIds) ? it.photoIds.filter(id=>photoCache[id]) : []; }
  function coverUrl(it){ const ids=itemPhotoIds(it); return ids.length ? photoCache[ids[0]] : (it.imageUrl||''); }
  function openLightbox(it,start){
    const ids=itemPhotoIds(it); if(!ids.length) return; let i=start||0;
    const ov=document.createElement('div'); ov.className='photo-lightbox';
    ov.innerHTML='<button class="lb-prev">&lsaquo;</button><img alt=""><button class="lb-next">&rsaquo;</button><button class="lb-close">&times;</button><div class="lb-count"></div>';
    const img=ov.querySelector('img'), cnt=ov.querySelector('.lb-count');
    const show=()=>{ img.src=photoCache[ids[i]]; cnt.textContent=(i+1)+' / '+ids.length; };
    const step=d=>{ i=(i+d+ids.length)%ids.length; show(); };
    const close=()=>{ document.removeEventListener('keydown',onKey); ov.remove(); };
    const onKey=e=>{ if(e.key==='Escape') close(); else if(e.key==='ArrowLeft') step(-1); else if(e.key==='ArrowRight') step(1); };
    ov.querySelector('.lb-prev').onclick=e=>{ e.stopPropagation(); step(-1); };
    ov.querySelector('.lb-next').onclick=e=>{ e.stopPropagation(); step(1); };
    ov.querySelector('.lb-close').onclick=close;
    ov.onclick=e=>{ if(e.target===ov) close(); };
    document.addEventListener('keydown',onKey); document.body.appendChild(ov); show();
  }
  listEl.addEventListener('click', e=>{
    const t=e.target.closest('[data-photo-item]'); if(!t) return;
    const it=items.find(x=>String(x.id)===t.getAttribute('data-photo-item')); if(it) openLightbox(it,0);
  });
  function attachPhotoManager(wrap,it,saveFn){
    saveFn = saveFn || saveItems;
    const sec=document.createElement('div'); sec.className='photo-mgr';
    sec.innerHTML='<div class="photo-strip"></div><label class="btn-ghost photo-add">+ Add photos<input type="file" accept="image/*" multiple hidden></label><span class="photo-hint">First photo is the cover. Click to view, \u2605 sets cover, \u00D7 removes. Photo changes save immediately.</span>';
    const strip=sec.querySelector('.photo-strip'), input=sec.querySelector('input');
    const draw=()=>{ const ids=itemPhotoIds(it); strip.innerHTML='';
      ids.forEach((id,i)=>{ const t=document.createElement('div'); t.className='photo-tile'+(i===0?' cover':''); t.style.backgroundImage="url('"+photoCache[id]+"')";
        t.innerHTML='<button type="button" class="pt-star" title="Set as cover">\u2605</button><button type="button" class="pt-del" title="Remove">\u00D7</button>';
        t.onclick=e=>{ if(!e.target.closest('button')) openLightbox(it,i); };
        t.querySelector('.pt-star').onclick=()=>{ it.photoIds=[id].concat(ids.filter(x=>x!==id)); saveFn(); draw(); };
        t.querySelector('.pt-del').onclick=()=>{ it.photoIds=ids.filter(x=>x!==id); delete photoCache[id]; photoDbDel(id); saveFn(); draw(); };
        strip.appendChild(t); }); };
    input.onchange=async()=>{ const nu=await storePhotos(Array.from(input.files)); input.value=''; it.photoIds=itemPhotoIds(it).concat(nu); saveFn(); draw(); };
    draw(); wrap.insertBefore(sec,wrap.firstChild);
  }

  function purgePhotos(ids){ (ids||[]).forEach(id=>{ delete photoCache[id]; photoDbDel(id); }); }
  function createPhotoStage(host){
    const staged = [];
    host.classList.add('photo-mgr');
    host.innerHTML = '<div class="photo-strip"></div><label class="btn-ghost photo-add">+ Add photos<input type="file" accept="image/*" multiple hidden></label><span class="photo-hint">The first photo is the cover. \u2605 sets the cover, \u00D7 removes.</span>';
    const strip = host.querySelector('.photo-strip'), input = host.querySelector('input'), hint = host.querySelector('.photo-hint');
    const draw = ()=>{
      strip.innerHTML = ''; hint.style.display = staged.length ? '' : 'none';
      staged.forEach((st,i)=>{
        const t = document.createElement('div'); t.className = 'photo-tile' + (i===0 ? ' cover' : ''); t.style.backgroundImage = "url('" + st.url + "')"; t.style.cursor = 'default';
        t.innerHTML = '<button type="button" class="pt-star" title="Set as cover">\u2605</button><button type="button" class="pt-del" title="Remove">\u00D7</button>';
        t.querySelector('.pt-star').onclick = ()=>{ staged.splice(i,1); staged.unshift(st); draw(); };
        t.querySelector('.pt-del').onclick = ()=>{ URL.revokeObjectURL(st.url); staged.splice(i,1); draw(); };
        strip.appendChild(t);
      });
    };
    input.onchange = ()=>{ Array.from(input.files).forEach(f=>{ if(/^image\//.test(f.type)) staged.push({ file:f, url:URL.createObjectURL(f) }); }); input.value = ''; draw(); };
    draw();
    return { files:()=>staged.map(x=>x.file), clear:()=>{ staged.forEach(x=>URL.revokeObjectURL(x.url)); staged.length = 0; draw(); } };
  }
  const logPhotoStage = createPhotoStage(document.getElementById('logPhotoStage'));
  const wishPhotoStage = createPhotoStage(document.getElementById('wishPhotoStage'));
  function wishThumbHtml(w){
    const ids = itemPhotoIds(w);
    return ids.length ? `<div class="wish-thumb" data-photo-wish="${w.id}" style="background-image:url('${escapeHtml(photoCache[ids[0]])}')"></div>` : '';
  }
  document.getElementById('wishlist-list').addEventListener('click', e=>{
    const t = e.target.closest('[data-photo-wish]'); if(!t) return;
    const w = wishlist.find(x=>String(x.id) === t.getAttribute('data-photo-wish')); if(w) openLightbox(w,0);
  });

  function buildRow(it){
    const color = typeColor(it.type);
    const subParts = [it.brand, it.production, it.source ? ('via '+it.source) : null].filter(Boolean).join(' \u00B7 ');
    const setCount = it.set ? items.filter(i=>i.set===it.set).length : 0;
    const row = document.createElement('div');
    row.className = 'row collection-row' + (it.verifiedDate ? ' verified' : '');
    const thumbHtml = coverUrl(it)
      ? `<div class="row-thumb" data-photo-item="${it.id}" style="cursor:zoom-in;background-image:url('${escapeHtml(coverUrl(it))}');background-size:cover;background-position:center;"></div>`
      : `<div class="row-thumb row-thumb-empty">NO<br>IMAGE</div>`;
    row.innerHTML = `
      ${thumbHtml}
      <div class="col-name">
        <div class="accession-mark">${accessionNumber(it)}</div>
        <div class="item-name">${escapeHtml(it.name)}</div>
        ${subParts ? `<div class="provenance-line">${escapeHtml(subParts)}</div>` : ''}
        <div class="item-sub">${holdingPeriod(it.date)}</div>
        ${it.set ? `<div class="set-tag">SET \u00B7 ${escapeHtml(it.set)} (${setCount} piece${setCount===1?'':'s'})</div>` : ''}
        ${it.verifiedDate ? `<div class="verified-tag">\u2713 Verified ${fmtDate(it.verifiedDate)}</div>` : ''}
        ${it.hasCoa ? `<span class="coa-badge">COA</span>` : ''}
        ${it.screenMatched === true ? `<span class="sm-badge active">\u2713 Screen-matched</span>` : ''}
        ${it.itemStatus==='consigned' ? `<div class="item-status-tag consigned">At ${escapeHtml(it.consignHouse||'auction')}</div>` : ''}
        ${it.itemStatus==='loaned' ? `<div class="item-status-tag loaned">On loan to ${escapeHtml(it.loanBorrower||'\u2014')}</div>` : ''}
        ${it.itemStatus==='sold' ? (()=>{ const p = soldProfitInfo(it); return `<div class="item-status-tag sold">SOLD ${fmtMoney(num(it.soldPrice), it.soldCurrency)}${p ? ' \u00B7 ' + p.text : ''}</div>`; })() : ''}
        ${it.notes ? `<div class="item-note">${escapeHtml(it.notes)}</div>` : ''}
      </div>
      <div class="col-cat">
        <span class="badge" style="color:${color}">${escapeHtml(it.type)}</span>
        <span class="badge-sub">${escapeHtml(it.category)}</span>
      </div>
      <div class="col-price price"><span class="price-num">${fmtMoney(it.price, it.currency)}</span>${hasOffer(it) ? `<div class="item-sub ${profitClass(profitPct(it))}">${fmtPct(profitPct(it))} at ${fmtMoney(it.minOffer, it.currency)}</div>` : ''}</div>
      <div class="col-loc loc">${escapeHtml(it.location || '\u2014')}</div>
      <div class="col-date date">${fmtDate(it.date)}</div>
      <div class="row-actions">
        <button class="icon-btn verify ${it.verifiedDate ? 'checked' : ''}" title="${it.verifiedDate ? 'Unmark as counted' : 'Mark as counted / present'}">\u2713</button>
        <button class="icon-btn edit">Edit</button>
        <button class="icon-btn del">&times;</button>
      </div>
    `;
    row.querySelector('.verify').onclick = ()=>{ it.verifiedDate = it.verifiedDate ? null : new Date().toISOString().slice(0,10); saveItems(); render(); };
    const smBadgeEl = row.querySelector('.sm-badge');
    if(smBadgeEl) smBadgeEl.onclick = ()=>{ it.screenMatched = !it.screenMatched; saveItems(); render(); };
    row.querySelector('.edit').onclick = ()=>{ editingId = it.id; render(); };
    row.querySelector('.del').onclick = ()=>{ purgePhotos(it.photoIds); items = items.filter(i=>i.id!==it.id); saveItems(); render(); };
    return row;
  }

  function buildCard(it){
    const color = typeColor(it.type);
    const subParts = [it.brand, it.production, it.source ? ('via '+it.source) : null].filter(Boolean).join(' \u00B7 ');
    const setCount = it.set ? items.filter(i=>i.set===it.set).length : 0;
    const card = document.createElement('div');
    card.className = 'card' + (it.verifiedDate ? ' verified' : '');
    const plateHtml = coverUrl(it)
      ? `<div class="card-plate" data-photo-item="${it.id}" style="cursor:zoom-in;background-image:url('${escapeHtml(coverUrl(it))}');background-size:cover;background-position:center;">${itemPhotoIds(it).length>1 ? `<div class="photo-count">\u25A3 ${itemPhotoIds(it).length}</div>` : ''}<div class="plate-tag">${escapeHtml(it.category)}</div></div>`
      : `<div class="card-plate card-plate-empty"><div class="plate-tag">${escapeHtml(it.category)}</div><div class="plate-mono-empty">NO IMAGE</div></div>`;
    card.innerHTML = `
      ${plateHtml}
      <div class="card-body">
        <div class="card-badge" style="color:${color}">${escapeHtml(it.type)}</div>
        <div class="accession-mark">${accessionNumber(it)}</div>
        <div class="card-title">${escapeHtml(it.name)}</div>
        <div class="provenance-line">${subParts ? escapeHtml(subParts) + ' \u00B7 ' : ''}${holdingPeriod(it.date)}</div>
        ${it.set ? `<div class="set-tag">SET \u00B7 ${escapeHtml(it.set)} (${setCount} piece${setCount===1?'':'s'})</div>` : ''}
        ${it.verifiedDate ? `<div class="verified-tag">\u2713 Verified ${fmtDate(it.verifiedDate)}</div>` : ''}
        ${it.hasCoa ? `<span class="coa-badge">COA</span>` : ''}
        ${it.screenMatched === true ? `<span class="sm-badge active">\u2713 Screen-matched</span>` : ''}
        ${it.itemStatus==='consigned' ? `<div class="item-status-tag consigned">At ${escapeHtml(it.consignHouse||'auction')}</div>` : ''}
        ${it.itemStatus==='loaned' ? `<div class="item-status-tag loaned">On loan to ${escapeHtml(it.loanBorrower||'\u2014')}</div>` : ''}
        ${it.itemStatus==='sold' ? (()=>{ const p = soldProfitInfo(it); return `<div class="item-status-tag sold">SOLD ${fmtMoney(num(it.soldPrice), it.soldCurrency)}${p ? ' \u00B7 ' + p.text : ''}</div>`; })() : ''}
        ${it.notes ? `<div class="item-note">${escapeHtml(it.notes)}</div>` : ''}
        <div class="card-stats">
          <div class="stat"><div class="stat-val">${fmtMoney(it.price, it.currency)}</div><div class="stat-lbl">Paid</div></div>
          <div class="stat-divider"></div>
          <div class="stat"><div class="stat-val muted">${escapeHtml(it.location || '\u2014')}</div><div class="stat-lbl">Location</div></div>
          ${hasOffer(it) ? `<div class="stat-divider"></div><div class="stat"><div class="stat-val ${profitClass(profitPct(it))}">${fmtPct(profitPct(it))}</div><div class="stat-lbl">If sold</div></div>` : ''}
        </div>
        <div class="card-actions">
          <button class="icon-btn verify ${it.verifiedDate ? 'checked' : ''}" title="${it.verifiedDate ? 'Unmark as counted' : 'Mark as counted / present'}">\u2713</button>
          <button class="icon-btn edit">Edit</button>
          <button class="icon-btn del">&times;</button>
        </div>
      </div>
    `;
    card.querySelector('.verify').onclick = ()=>{ it.verifiedDate = it.verifiedDate ? null : new Date().toISOString().slice(0,10); saveItems(); render(); };
    const smBadgeElCard = card.querySelector('.sm-badge');
    if(smBadgeElCard) smBadgeElCard.onclick = ()=>{ it.screenMatched = !it.screenMatched; saveItems(); render(); };
    card.querySelector('.edit').onclick = ()=>{ editingId = it.id; render(); };
    card.querySelector('.del').onclick = ()=>{ items = items.filter(i=>i.id!==it.id); saveItems(); render(); };
    return card;
  }

  function buildEditRow(it, spanFull){
    const wrap = document.createElement('div');
    wrap.className = 'edit-row' + (spanFull ? ' edit-row-span' : '');
    const typeOptsHtml = Object.keys(TYPES).map(t=> `<option value="${t}" ${t===it.type?'selected':''}>${t}</option>`).join('');
    wrap.innerHTML = `
      <div class="edit-grid-4">
        <div class="field"><label>Item</label><input type="text" class="e-name" value="${escapeHtml(it.name)}"></div>
        <div class="field"><label>Brand</label><input type="text" class="e-brand" list="brandSuggestions" value="${escapeHtml(it.brand||'')}"></div>
        <div class="field"><label>Production</label><input type="text" class="e-production" list="productionSuggestions" value="${escapeHtml(it.production||'')}"></div>
        <div class="field"><label>Source</label><input type="text" class="e-source" list="sourceSuggestions" value="${escapeHtml(it.source||'')}"></div>
      </div>
      <div class="edit-grid-2">
        <div class="field"><label>Type</label><select class="e-type">${typeOptsHtml}</select></div>
        <div class="field"><label>Category</label><select class="e-cat"></select></div>
        <div class="field"><label>Paid</label>
          <div class="price-row">
            <select class="e-currency"><option value="USD" ${it.currency==='USD'?'selected':''}>$ USD</option><option value="EUR" ${it.currency==='EUR'?'selected':''}>EUR</option><option value="GBP" ${it.currency==='GBP'?'selected':''}>GBP</option></select>
            <input type="number" class="e-price" value="${it.price}" min="0" step="0.01">
          </div>
        </div>
        <div class="field"><label>Insured value</label><input type="number" class="e-insured" value="${it.insuredValue||''}" min="0" step="0.01"></div>
      </div>
      <div class="edit-grid-3">
        <div class="field"><label>Location</label><input type="text" class="e-loc" list="locationSuggestions" value="${escapeHtml(it.location||'')}"></div>
        <div class="field"><label>Date acquired</label><input type="date" class="e-date" value="${it.date||''}"></div>
        <div class="field"><label>Min offer</label><input type="number" class="e-minoffer" value="${it.minOffer||''}" min="0" step="0.01"></div>
      </div>
      <div class="edit-grid-2">
        <div class="field" style="grid-column: span 2;"><label>Part of a set (optional)</label><input type="text" class="e-set" list="setSuggestions" value="${escapeHtml(it.set||'')}" placeholder="Pieces sharing this name link together"></div>
      </div>
      <div class="edit-grid-4">
        <div class="field" style="align-self:center;padding-top:18px;">
          <label style="display:flex;align-items:center;gap:7px;cursor:pointer;">
            <input type="checkbox" class="e-hascoa" style="width:auto;" ${it.hasCoa?'checked':''}> Has COA / certificate
          </label>
        </div>
        <div class="field"><label>Appraisal date</label><input type="date" class="e-appraisaldate" value="${it.appraisalDate||''}"></div>
        <div class="field"><label>Appraised by</label><input type="text" class="e-appraisedby" list="appraiserSuggestions" value="${escapeHtml(it.appraisedBy||'')}"></div>
        <div class="field"><label>Provenance</label><input type="text" class="e-provenance" value="${escapeHtml(it.provenance||'')}"></div>
      </div>
      <div class="edit-grid-2">
        <div class="field" style="grid-column: span 2;"><label>Notes</label><input type="text" class="e-notes" value="${escapeHtml(it.notes||'')}"></div>
      </div>
      <div class="edit-grid-4">
        <div class="field" style="align-self:center;padding-top:18px;">
          <label style="display:flex;align-items:center;gap:7px;cursor:pointer;">
            <input type="checkbox" class="e-screenmatched" style="width:auto;" ${it.screenMatched?'checked':''}> Screen-matched / photo-matched
          </label>
        </div>
      </div>
      <div class="field" style="margin-bottom:12px;">
        <label>Item status</label>
        <div class="ledger-type-toggle" style="margin-top:6px;">
          <button type="button" class="item-status-btn ${(!it.itemStatus||it.itemStatus==='collection')?'active':''}" data-status="collection">In Collection</button>
          <button type="button" class="item-status-btn ${it.itemStatus==='consigned'?'active':''}" data-status="consigned">At Auction House</button>
          <button type="button" class="item-status-btn ${it.itemStatus==='loaned'?'active':''}" data-status="loaned">On Loan</button>
          <button type="button" class="item-status-btn ${it.itemStatus==='sold'?'active':''}" data-status="sold">Sold</button>
        </div>
      </div>
      <div class="status-fields-sold" style="display:${it.itemStatus==='sold'?'block':'none'};">
        <div class="form-grid-4">
          <div class="field"><label>Sold price</label><input type="number" class="e-soldprice" value="${it.soldPrice||''}" min="0" step="0.01"></div>
          <div class="field"><label>Currency</label>
            <select class="e-soldcurrency">
              <option value="USD" ${it.soldCurrency==='USD'?'selected':''}>$ USD</option>
              <option value="EUR" ${it.soldCurrency==='EUR'?'selected':''}>EUR</option>
              <option value="GBP" ${it.soldCurrency==='GBP'?'selected':''}>GBP</option>
            </select>
          </div>
          <div class="field"><label>Sold date</label><input type="date" class="e-solddate" value="${it.soldDate||''}"></div>
          <div class="field"><label>Sold to (optional)</label><input type="text" class="e-soldto" value="${escapeHtml(it.soldTo||'')}"></div>
        </div>
        <div class="form-grid-2">
          <div class="field" style="grid-column:span 2;"><label>Note</label><input type="text" class="e-soldnote" value="${escapeHtml(it.soldNote||'')}"></div>
        </div>
      </div>
      <div class="status-fields-consign" style="display:${it.itemStatus==='consigned'?'block':'none'};">
        <div class="form-grid-4">
          <div class="field"><label>Auction house</label><input type="text" class="e-consignhouse" list="houseSuggestions" value="${escapeHtml(it.consignHouse||'')}"></div>
          <div class="field"><label>Lot number</label><input type="text" class="e-consignlot" value="${escapeHtml(it.consignLot||'')}"></div>
          <div class="field"><label>Sale date</label><input type="date" class="e-consignsaledate" value="${it.consignSaleDate||''}"></div>
          <div class="field"><label>Listing type</label>
            <select class="e-consignlistingtype">
              <option value="auction" ${it.consignListingType!=='buyNow'?'selected':''}>Auction (range)</option>
              <option value="buyNow" ${it.consignListingType==='buyNow'?'selected':''}>Buy Now (fixed)</option>
            </select>
          </div>
        </div>
        <div class="form-grid-4">
          <div class="field"><label class="e-consignestlow-label">Estimate low</label><input type="number" class="e-consignestlow" value="${it.consignEstLow||''}" min="0" step="0.01"></div>
          <div class="field e-consignesthigh-field"><label>Estimate high</label><input type="number" class="e-consignesthigh" value="${it.consignEstHigh||''}" min="0" step="0.01"></div>
          <div class="field"><label>Currency</label>
            <select class="e-consigncurrency">
              <option value="USD" ${it.currency==='USD'?'selected':''}>$ USD</option>
              <option value="EUR" ${it.currency==='EUR'?'selected':''}>EUR</option>
              <option value="GBP" ${it.currency==='GBP'?'selected':''}>GBP</option>
            </select>
          </div>
          <div class="field"><label>Sale status</label>
            <select class="e-consignstatus">
              <option value="listed" ${it.consignSaleStatus==='listed'?'selected':''}>Awaiting sale</option>
              <option value="sold" ${it.consignSaleStatus==='sold'?'selected':''}>Sold</option>
              <option value="unsold" ${it.consignSaleStatus==='unsold'?'selected':''}>Unsold (passed)</option>
              <option value="returning" ${it.consignSaleStatus==='returning'?'selected':''}>Returning to me</option>
            </select>
          </div>
        </div>
        <div class="form-grid-2">
          <div class="field"><label>Sold price</label><input type="number" class="e-consignsoldprice" value="${it.consignSoldPrice||''}" min="0" step="0.01"></div>
          <div class="field"><label>Current location</label><input type="text" class="e-consignloc" list="locationSuggestions" value="${escapeHtml(it.consignCurrentLoc||'')}" placeholder="Leave blank to assume still at the house"></div>
        </div>
        <div class="form-grid-2">
          <div class="field" style="grid-column:span 2;"><label>Note</label><input type="text" class="e-consignnote" value="${escapeHtml(it.consignNote||'')}"></div>
        </div>
      </div>
      <div class="status-fields-loan" style="display:${it.itemStatus==='loaned'?'block':'none'};">
        <div class="form-grid-4">
          <div class="field"><label>Borrower / exhibition</label><input type="text" class="e-loanborrower" list="borrowerSuggestions" value="${escapeHtml(it.loanBorrower||'')}"></div>
          <div class="field"><label>Loan date</label><input type="date" class="e-loandate" value="${it.loanDate||''}"></div>
          <div class="field"><label>Expected return</label><input type="date" class="e-loanreturndate" value="${it.loanReturnDate||''}"></div>
          <div class="field"><label>Returned on</label><input type="date" class="e-loanreturneddate" value="${it.loanReturnedDate||''}"></div>
        </div>
        <div class="form-grid-2">
          <div class="field" style="grid-column:span 2;"><label>Note</label><input type="text" class="e-loannote" value="${escapeHtml(it.loanNote||'')}"></div>
        </div>
      </div>
      <div class="edit-actions">
        <button class="btn-cancel">Cancel</button>
        <button class="btn-save">Save changes</button>
      </div>
    `;
    let editItemStatus = it.itemStatus || 'collection';
    wrap.querySelectorAll('.item-status-btn').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        editItemStatus = btn.dataset.status;
        wrap.querySelectorAll('.item-status-btn').forEach(b=>b.classList.toggle('active', b===btn));
        wrap.querySelector('.status-fields-consign').style.display = editItemStatus==='consigned' ? 'block' : 'none';
        wrap.querySelector('.status-fields-loan').style.display = editItemStatus==='loaned' ? 'block' : 'none';
        wrap.querySelector('.status-fields-sold').style.display = editItemStatus==='sold' ? 'block' : 'none';
      });
    });
    const eListingType = wrap.querySelector('.e-consignlistingtype');
    if(eListingType){
      const syncListingType = ()=>{
        const isBuyNow = eListingType.value === 'buyNow';
        wrap.querySelector('.e-consignestlow-label').textContent = isBuyNow ? 'Price' : 'Estimate low';
        wrap.querySelector('.e-consignesthigh-field').style.display = isBuyNow ? 'none' : '';
      };
      eListingType.addEventListener('change', syncListingType);
      syncListingType();
    }
    const eType = wrap.querySelector('.e-type');
    const eCat = wrap.querySelector('.e-cat');
    populateSubcategories(eCat, it.type, it.category);
    eType.addEventListener('change', ()=> populateSubcategories(eCat, eType.value));
    wrap.querySelector('.btn-cancel').onclick = ()=>{ editingId=null; render(); };
    wrap.querySelector('.btn-save').onclick = ()=>{
      it.name = wrap.querySelector('.e-name').value.trim() || it.name;
      it.brand = wrap.querySelector('.e-brand').value.trim();
      it.production = wrap.querySelector('.e-production').value.trim();
      it.source = wrap.querySelector('.e-source').value.trim();
      it.type = eType.value;
      it.category = eCat.value;
      it.price = parseFloat(wrap.querySelector('.e-price').value) || 0;
      it.currency = wrap.querySelector('.e-currency').value;
      it.insuredValue = parseFloat(wrap.querySelector('.e-insured').value) || 0;
      it.location = wrap.querySelector('.e-loc').value.trim();
      it.date = wrap.querySelector('.e-date').value || it.date;
      it.minOffer = parseFloat(wrap.querySelector('.e-minoffer').value) || 0;
      it.set = wrap.querySelector('.e-set').value.trim();
      it.hasCoa = wrap.querySelector('.e-hascoa').checked;
      it.appraisalDate = wrap.querySelector('.e-appraisaldate').value;
      it.appraisedBy = wrap.querySelector('.e-appraisedby').value.trim();
      it.provenance = wrap.querySelector('.e-provenance').value.trim();
      it.notes = wrap.querySelector('.e-notes').value.trim();
      it.screenMatched = wrap.querySelector('.e-screenmatched').checked;
      it.itemStatus = editItemStatus;
      if(editItemStatus === 'consigned'){
        it.consignHouse = wrap.querySelector('.e-consignhouse').value.trim();
        it.consignLot = wrap.querySelector('.e-consignlot').value.trim();
        it.consignSaleDate = wrap.querySelector('.e-consignsaledate').value;
        it.consignListingType = wrap.querySelector('.e-consignlistingtype').value;
        const consignPrice = parseFloat(wrap.querySelector('.e-consignestlow').value) || 0;
        it.consignEstLow = consignPrice;
        it.consignEstHigh = it.consignListingType==='buyNow' ? consignPrice : (parseFloat(wrap.querySelector('.e-consignesthigh').value) || 0);
        it.consignCurrency = wrap.querySelector('.e-consigncurrency').value;
        it.consignSaleStatus = wrap.querySelector('.e-consignstatus').value;
        it.consignSoldPrice = parseFloat(wrap.querySelector('.e-consignsoldprice').value) || 0;
        it.consignCurrentLoc = wrap.querySelector('.e-consignloc').value.trim();
        it.consignNote = wrap.querySelector('.e-consignnote').value.trim();
        updateHouseSuggestions();
      } else if(editItemStatus === 'loaned'){
        it.loanBorrower = wrap.querySelector('.e-loanborrower').value.trim();
        it.loanDate = wrap.querySelector('.e-loandate').value;
        it.loanReturnDate = wrap.querySelector('.e-loanreturndate').value;
        it.loanReturnedDate = wrap.querySelector('.e-loanreturneddate').value;
        it.loanNote = wrap.querySelector('.e-loannote').value.trim();
        updateBorrowerSuggestions();
      } else if(editItemStatus === 'sold'){
        it.soldPrice = parseFloat(wrap.querySelector('.e-soldprice').value) || 0;
        it.soldCurrency = wrap.querySelector('.e-soldcurrency').value;
        it.soldDate = wrap.querySelector('.e-solddate').value || new Date().toISOString().slice(0,10);
        it.soldTo = wrap.querySelector('.e-soldto').value.trim();
        it.soldNote = wrap.querySelector('.e-soldnote').value.trim();
      }
      editingId = null; saveItems(); updateSourceSuggestions(); updateBrandSuggestions(); updateProductionSuggestions(typeSelect.value); updateLocationSuggestions(); updateSetSuggestions(); updateAppraiserSuggestions(); render();
    };
    return wrap;
  }

  document.getElementById('addBtn').addEventListener('click', ()=>{
    const name = nameInput.value.trim();
    if(!name){ nameInput.focus(); return; }
    const price = parseFloat(document.getElementById('fPrice').value) || 0;
    const currency = document.getElementById('fCurrency').value;
    const insuredValue = parseFloat(document.getElementById('fInsured').value) || 0;
    const minOffer = parseFloat(document.getElementById('fMinOffer').value) || 0;
    const location = document.getElementById('fLoc').value.trim();
    const type = typeSelect.value;
    const category = catSelect.value || 'Other';
    const brand = brandInput.value.trim();
    const production = productionInput.value.trim();
    const source = sourceInput.value.trim();
    const setName = document.getElementById('fSet').value.trim();
    const acquiredDate = dateInput.value || new Date().toISOString().slice(0,10);
    const hasCoa = document.getElementById('fHasCoa').checked;
    const appraisalDate = document.getElementById('fAppraisalDate').value;
    const appraisedBy = document.getElementById('fAppraisedBy').value.trim();
    const provenance = document.getElementById('fProvenance').value.trim();
    const notes = document.getElementById('fNotes').value.trim();
    items.push({ id: Date.now()+Math.random(), name, brand, production, source, type, category, price, currency, insuredValue, minOffer, location, date: acquiredDate, set: setName, hasCoa, appraisalDate, appraisedBy, provenance, notes });
    { const newItem = items[items.length-1]; applyPendingCatalogueLink(newItem); const photoFiles = logPhotoStage.files(); if(photoFiles.length){ logPhotoStage.clear(); storePhotos(photoFiles).then(ids=>{ newItem.photoIds = ids; saveItems(); render(); }); } }
    saveItems();
    updateSourceSuggestions();
    updateBrandSuggestions();
    updateProductionSuggestions(typeSelect.value);
    updateLocationSuggestions();
    updateSetSuggestions();
    updateAppraiserSuggestions();
    nameInput.value=''; brandInput.value=''; productionInput.value=''; sourceInput.value='';
    document.getElementById('fPrice').value=''; document.getElementById('fInsured').value=''; document.getElementById('fMinOffer').value='';
    document.getElementById('fLoc').value=''; dateInput.value = new Date().toISOString().slice(0,10);
    document.getElementById('fHasCoa').checked = false;
    document.getElementById('fAppraisalDate').value = '';
    document.getElementById('fAppraisedBy').value = '';
    document.getElementById('fProvenance').value = '';
    document.getElementById('fNotes').value = '';
    logPhotoStage.clear();
    populateSubcategories(catSelect, typeSelect.value);
    catHint.textContent = '\u00A0';
    nameInput.focus();
    render();
  });
  document.getElementById('docToggle').addEventListener('click', ()=>{
    const sec = document.getElementById('docSection');
    const open = sec.classList.toggle('open');
    document.getElementById('docToggle').textContent = open ? '\u2212 Documentation & notes (optional)' : '+ Documentation & notes (optional)';
  });
  document.getElementById('logPieceToggle').addEventListener('click', ()=>{
    const form = document.getElementById('logPieceForm');
    const toggle = document.getElementById('logPieceToggle');
    const willOpen = !form.classList.contains('open');
    toggle.classList.toggle('open', willOpen);
    toggle.textContent = willOpen ? '\u2212 Log a new piece' : '+ Log a new piece';
    if(willOpen){
      form.classList.add('open');
      form.style.maxHeight = form.scrollHeight + 'px';
      setTimeout(()=>{ if(form.classList.contains('open')){ form.style.maxHeight = 'none'; form.style.overflow = 'visible'; } }, 380);
      if(!prefersReducedMotion) nameInput.focus();
    } else {
      form.style.overflow = 'hidden';
      form.style.maxHeight = form.scrollHeight + 'px';
      requestAnimationFrame(()=>{ requestAnimationFrame(()=>{ form.style.maxHeight = '0px'; }); });
      form.classList.remove('open');
    }
  });
  const addFormFieldOrder = [nameInput,brandInput,productionInput,sourceInput,document.getElementById('fPrice'),document.getElementById('fLoc')];
  addFormFieldOrder.forEach((el, idx)=>{
    el.addEventListener('keydown', e=>{
      if(e.key!=='Enter') return;
      e.preventDefault();
      const next = addFormFieldOrder[idx+1];
      if(next){ next.focus(); } else { document.getElementById('addBtn').click(); }
    });
  });
  searchEl.addEventListener('input', render);
  sortEl.addEventListener('change', render);
  document.getElementById('unverifiedOnly').addEventListener('change', render);

  document.getElementById('exportCsv').addEventListener('click', (e)=>{
    const header = ['Item','Brand','Production','Source','Type','Category','Price','Currency','Insured Value','Min Offer','Profit %','Location','Date Acquired','Held','Verified','Set','Has COA','Appraisal Date','Appraised By','Provenance','Notes'];
    const rows = items.map(it=>[it.name,it.brand,it.production,it.source,it.type,it.category,it.price,it.currency,it.insuredValue,it.minOffer,hasOffer(it)&&profitPct(it)!==null?profitPct(it).toFixed(1):'',it.location,it.date,holdingPeriod(it.date),it.verifiedDate||'',it.set||'',it.hasCoa?'Yes':'No',it.appraisalDate||'',it.appraisedBy||'',it.provenance||'',it.notes||'']);
    const csv = [header,...rows].map(r=> r.map(v=>`"${String(v==null?'':v).replace(/"/g,'""')}"`).join(',')).join('\n');
    prepareDownloadLink(e.currentTarget, csv, 'text/csv');
  });
  function buildFullBackupObject(){
    return {
      artefaktBackup: true,
      version: 2,
      exportedAt: new Date().toISOString(),
      items,
      wishlist,
      expenses,
      contacts,
      ledgerEntries,
      goal: goalInput.value,
      catalogues,
      photos: (()=>{ const o={}; [...items, ...wishlist].forEach(it=>itemPhotoIds(it).forEach(id=>{ o[id]=photoCache[id]; })); return o; })()
    };
  }
  document.getElementById('exportJson').addEventListener('click', (e)=>{
    prepareDownloadLink(e.currentTarget, JSON.stringify(buildFullBackupObject(),null,2), 'application/json');
    markBackedUp();
  });
  function prepareDownloadLink(anchorEl, content, type){
    const blob = new Blob([content], {type});
    const url = URL.createObjectURL(blob);
    if(anchorEl.dataset.prevUrl) URL.revokeObjectURL(anchorEl.dataset.prevUrl);
    anchorEl.href = url;
    anchorEl.dataset.prevUrl = url;
    setTimeout(()=>{ if(anchorEl.dataset.prevUrl === url) URL.revokeObjectURL(url); }, 60000);
  }
  function applyFullBackupData(parsed){
    /* ===== Version 2 full backup: authoritative, complete restore ===== */
    const validationErrors = [];
    if(!Array.isArray(parsed.items)) validationErrors.push('items is missing or not an array');
    ['wishlist','expenses','contacts','ledgerEntries'].forEach(k=>{
      if(parsed[k] !== undefined && !Array.isArray(parsed[k])) validationErrors.push(`${k} is present but not an array`);
    });
    if(validationErrors.length){
      return { ok:false, error: validationErrors.join('; ') };
    }

    const sanitizedItems = parsed.items.map(it => ({
      ...it,
      price: num(it.price),
      insuredValue: num(it.insuredValue),
      minOffer: num(it.minOffer)
    }));

    // Complete, unconditional replace — imported state IS the new state.
    // No per-ID existence checks, no skipping, no merging old fields over new ones,
    // regardless of itemStatus (collection / consigned / loaned / sold).
    items = sanitizedItems;
    if(parsed.photos && typeof parsed.photos==='object'){ Object.keys(parsed.photos).forEach(id=>{ const v=parsed.photos[id]; if(typeof v==='string' && /^data:image\/[a-z+.-]+;base64,[A-Za-z0-9+\/=]+$/.test(v)){ photoCache[id]=v; photoDbPut(id, v); } }); }
    if(Array.isArray(parsed.wishlist)) wishlist = parsed.wishlist.slice();
    if(Array.isArray(parsed.expenses)) expenses = parsed.expenses.slice();
    if(Array.isArray(parsed.contacts)) contacts = parsed.contacts.slice();
    if(Array.isArray(parsed.ledgerEntries)) ledgerEntries = parsed.ledgerEntries.slice();
    if(Array.isArray(parsed.catalogues)){ catalogues = parsed.catalogues.filter(c=>c && Array.isArray(c.entries) && Array.isArray(c.sections)); activeCatId = null; activeCatSection = null; saveCatalogues(); }

    saveItems(); saveWishlist(); saveExpenses(); saveContacts(); saveLedgerEntries();
    if(parsed.goal && goalInput){
      goalInput.value = parsed.goal;
      try{ localStorage.setItem(GOAL_KEY, parsed.goal); }catch(err){}
    }

    updateSourceSuggestions(); updateBrandSuggestions(); updateProductionSuggestions(typeSelect.value); updateLocationSuggestions(); updateSetSuggestions(); updateAppraiserSuggestions();
    updateHouseSuggestions(); updateBorrowerSuggestions();
    activeType = 'All';
    searchEl.value = '';
    typeFilterSelect.value = 'All';
    locationFilterSelect.value = 'All';
    itemStatusFilterSelect.value = 'all';
    renderSubFilter();
    render();
    if(typeof renderWishlist==='function') renderWishlist();
    if(typeof renderExpenses==='function') renderExpenses();
    if(typeof renderContactCards==='function') renderContactCards();
    renderConsignHouseFilter(); populateConsignItemSelect(); renderConsignments();
    populateLoanItemSelect(); renderLoans();
    renderGoal();
    renderCatalogue();

    return { ok:true, itemsCount: items.length, wishlistCount: wishlist.length, expensesCount: expenses.length, contactsCount: contacts.length, ledgerCount: ledgerEntries.length };
  }
  const importFile = document.getElementById('importJsonFile');
  const importStatus = document.getElementById('importStatus');
  function setImportStatus(msg, ok){
    importStatus.textContent = msg;
    importStatus.style.color = ok === true ? 'var(--accent)' : (ok === false ? 'var(--danger)' : 'var(--ink-muted)');
  }
  importFile.addEventListener('change', (e)=>{
    const file = e.target.files[0];
    if(!file){ return; }
    setImportStatus(`Reading "${file.name}"...`, null);
    const reader = new FileReader();
    reader.onload = ()=>{
      try{
        const raw = reader.result.trim();
        const parsed = JSON.parse(raw);
        const isFullBackup = !!(parsed && !Array.isArray(parsed) && Array.isArray(parsed.items) && (
          parsed.artefaktBackup === true ||
          Array.isArray(parsed.wishlist) ||
          Array.isArray(parsed.expenses) ||
          Array.isArray(parsed.contacts) ||
          Array.isArray(parsed.ledgerEntries)
        ));

        if(isFullBackup){
          const result = applyFullBackupData(parsed);
          if(!result.ok){
            setImportStatus(`\u2717 "${file.name}" failed validation: ${result.error}.`, false);
            return;
          }
          setImportStatus(`\u2713 Full backup restored from "${file.name}" \u2014 ${result.itemsCount} item(s), ${result.wishlistCount} wishlist, ${result.expensesCount} expenses, ${result.contactsCount} ledger contacts, ${result.ledgerCount} ledger entries. This backup is now the complete application state.`, true);
          return;
        }

        /* ===== Legacy backup: bare array of items, or partial JSON with just an `items` key.
           No authoritative-state metadata, so we fall back to the merge/replace toggle for items only. ===== */
        const parsedItems = Array.isArray(parsed) ? parsed : (Array.isArray(parsed && parsed.items) ? parsed.items : null);
        if(parsedItems){
          const sanitized = parsedItems.map(it => ({
            ...it,
            price: num(it.price),
            insuredValue: num(it.insuredValue),
            minOffer: num(it.minOffer)
          }));
          const replaceMode = document.getElementById('importReplaceMode').checked;
          let skippedDupes = 0;
          if(replaceMode || items.length===0){
            items = sanitized;
          } else {
            const existingIds = new Set(items.map(it=>it.id));
            const newOnes = sanitized.filter(it=>{
              const isDupe = it.id!=null && existingIds.has(it.id);
              if(isDupe) skippedDupes++;
              return !isDupe;
            });
            items = [...items, ...newOnes];
          }
          saveItems();
          updateSourceSuggestions(); updateBrandSuggestions(); updateProductionSuggestions(typeSelect.value); updateLocationSuggestions(); updateSetSuggestions(); updateAppraiserSuggestions();
          activeType = 'All';
          searchEl.value = '';
          typeFilterSelect.value = 'All';
          locationFilterSelect.value = 'All';
          itemStatusFilterSelect.value = 'all';
          renderSubFilter();
          render();
          renderConsignHouseFilter(); populateConsignItemSelect(); renderConsignments();
          populateLoanItemSelect(); renderLoans();

          // Safety net: even in the legacy path, never silently drop wishlist/expenses/ledger data if present.
          const extras = [];
          if(parsed && !Array.isArray(parsed)){
            if(Array.isArray(parsed.wishlist)){ wishlist = parsed.wishlist.slice(); saveWishlist(); extras.push(`${wishlist.length} wishlist`); if(typeof renderWishlist==='function') renderWishlist(); }
            if(Array.isArray(parsed.expenses)){ expenses = parsed.expenses.slice(); saveExpenses(); extras.push(`${expenses.length} expenses`); if(typeof renderExpenses==='function') renderExpenses(); }
            if(Array.isArray(parsed.contacts)){ contacts = parsed.contacts.slice(); saveContacts(); extras.push(`${contacts.length} ledger contacts`); }
            if(Array.isArray(parsed.ledgerEntries)){ ledgerEntries = parsed.ledgerEntries.slice(); saveLedgerEntries(); extras.push(`${ledgerEntries.length} ledger entries`); }
            if(typeof renderContactCards==='function') renderContactCards();
          }
          const extrasNote = extras.length ? ` Also restored: ${extras.join(', ')}.` : '';

          const addedCount = replaceMode ? sanitized.length : (sanitized.length - skippedDupes);
          const dupeNote = skippedDupes > 0 ? ` (${skippedDupes} already in your collection were skipped, not duplicated)` : '';
          setImportStatus(`\u2713 ${replaceMode ? 'Replaced with' : 'Merged in'} ${addedCount} item(s) from "${file.name}"${dupeNote} \u2014 ${items.length} total now.${extrasNote} Filters were reset so everything is visible.`, true);
        } else {
          setImportStatus(`\u2717 "${file.name}" doesn't look like a Rack Ledger backup (expected a JSON array of items).`, false);
        }
      }catch(err){
        setImportStatus(`\u2717 Could not read "${file.name}": ${err.message}`, false);
      }
    };
    reader.onerror = ()=>{ setImportStatus(`\u2717 Could not open "${file.name}" for reading.`, false); };
    reader.readAsText(file);
    importFile.value = '';
  });

  /* ================= WISHLIST ================= */
  const WISHLIST_KEY = 'rackLedgerWishlist_v1';
  let wishlist = [];
  function loadWishlist(){ try{ const raw=localStorage.getItem(WISHLIST_KEY); wishlist = raw?JSON.parse(raw):[]; }catch(e){ wishlist=[]; } }
  function saveWishlist(){ try{ localStorage.setItem(WISHLIST_KEY, JSON.stringify(wishlist)); }catch(e){} schedulePersist(); }
  loadWishlist();

  const wType = document.getElementById('wType');
  const wCat = document.getElementById('wCat');
  Object.keys(TYPES).forEach(t=>{ const o=document.createElement('option'); o.value=t; o.textContent=t; wType.appendChild(o); });
  populateSubcategories(wCat, wType.value);
  wType.addEventListener('change', ()=> populateSubcategories(wCat, wType.value));

  const PRIORITY_COLOR = {High:'#e2604c', Medium:'#dcc07a', Low:'#96938c'};
  let editingWishlistId = null;

  function renderWishlistStats(){
    const box = document.getElementById('wishlistStatCards');
    const sums = {USD:0, EUR:0, GBP:0};
    wishlist.forEach(w=>{ const c=CURRENCIES.includes(w.currency)?w.currency:'USD'; sums[c]+=num(w.price); });
    const totalUSD = wishlist.reduce((s,w)=> s + convertToUSD(num(w.price), w.currency||'USD'), 0);
    let html = CURRENCIES.map(c => `
      <div class="ccard"><div class="num">${fmtMoney(sums[c], c)}</div><div class="lbl">${c} wishlist total</div></div>
    `).join('');
    html += `<div class="ccard divider"><div class="num">${fmtMoney(totalUSD,'USD')}</div><div class="lbl">Est. total (USD) \u2014 if bought</div></div>`;
    html += `<div class="ccard"><div class="num small">${wishlist.length}</div><div class="lbl">Pieces wanted</div></div>`;
    box.innerHTML = html;
  }

  function renderWishlist(){
    const box = document.getElementById('wishlist-list');
    box.innerHTML = '';
    if(wishlist.length===0){
      const empty = document.createElement('div'); empty.className='empty';
      empty.textContent = "Wishlist is empty. Add pieces you're hunting for.";
      box.appendChild(empty);
      renderWishlistStats();
      return;
    }
    const sorted = [...wishlist].sort((a,b)=>{
      const order = {High:0, Medium:1, Low:2};
      return order[a.priority]-order[b.priority] || b.id-a.id;
    });
    sorted.forEach(w=>{
      if(w.id===editingWishlistId){ const er = buildWishlistEditRow(w); attachPhotoManager(er, w, saveWishlist); box.appendChild(er); } else { box.appendChild(buildWishlistRow(w)); }
    });
    renderWishlistStats();
  }

  function buildWishlistRow(w){
    const color = PRIORITY_COLOR[w.priority] || '#78725f';
    const subParts = [w.brand, w.production, w.source ? ('via '+w.source) : null].filter(Boolean).join(' \u00B7 ');
    const row = document.createElement('div');
    row.className = 'row wishlist-row';
    row.innerHTML = `
      <div class="tab" style="background:${typeColor(w.type)}"></div>
      <div class="col-name">
        ${wishThumbHtml(w)}
        <div class="item-name">${escapeHtml(w.name)}</div>
        <div class="item-sub">${escapeHtml(w.type)} \u00B7 ${escapeHtml(w.category)}</div>
        ${subParts ? `<div class="item-sub">${escapeHtml(subParts)}</div>` : ''}
      </div>
      <div class="col-cat"><span class="badge" style="background:${color}1a;color:${color};border:1px solid ${color}55">${escapeHtml(w.priority)}</span></div>
      <div class="price">${fmtMoney(w.price, w.currency)}</div>
      <div class="loc">${escapeHtml(w.notes || '\u2014')}</div>
      <div class="row-actions">
        <button class="icon-btn acquire" title="Mark acquired \u2014 move to collection">Got it</button>
        <button class="icon-btn edit">Edit</button>
        <button class="icon-btn del">&times;</button>
      </div>
    `;
    row.querySelector('.acquire').onclick = ()=>{
      const acquiredItem = {
        photoIds: (w.photoIds || []).slice(),
        id: Date.now()+Math.random(), name: w.name, brand: w.brand||'', production: w.production||'', source: w.source||'',
        type: w.type, category: w.category, price: w.price, currency: w.currency,
        insuredValue:0, location:'', minOffer:0,
        date: new Date().toISOString().slice(0,10)
      };
      items.push(acquiredItem);
      catalogueOnWishlistAcquired(w.id, acquiredItem.id);
      wishlist = wishlist.filter(x=>x.id!==w.id);
      saveItems(); saveWishlist();
      updateSourceSuggestions(); updateBrandSuggestions(); updateProductionSuggestions(typeSelect.value); updateLocationSuggestions(); updateSetSuggestions(); updateAppraiserSuggestions();
      render(); renderWishlist();
    };
    row.querySelector('.edit').onclick = ()=>{ editingWishlistId = w.id; renderWishlist(); };
    row.querySelector('.del').onclick = ()=>{ purgePhotos(w.photoIds); wishlist = wishlist.filter(x=>x.id!==w.id); saveWishlist(); renderWishlist(); };
    return row;
  }

  function buildWishlistEditRow(w){
    const wrap = document.createElement('div');
    wrap.className = 'edit-row';
    const typeOptsHtml = Object.keys(TYPES).map(t=> `<option value="${t}" ${t===w.type?'selected':''}>${t}</option>`).join('');
    wrap.innerHTML = `
      <div class="edit-grid-4">
        <div class="field"><label>Item</label><input type="text" class="we-name" value="${escapeHtml(w.name)}"></div>
        <div class="field"><label>Brand</label><input type="text" class="we-brand" list="brandSuggestions" value="${escapeHtml(w.brand||'')}"></div>
        <div class="field"><label>Production</label><input type="text" class="we-production" list="productionSuggestions" value="${escapeHtml(w.production||'')}"></div>
        <div class="field"><label>Source</label><input type="text" class="we-source" list="sourceSuggestions" value="${escapeHtml(w.source||'')}"></div>
      </div>
      <div class="edit-grid-2">
        <div class="field"><label>Type</label><select class="we-type">${typeOptsHtml}</select></div>
        <div class="field"><label>Category</label><select class="we-cat"></select></div>
        <div class="field"><label>Est. price</label>
          <div class="price-row">
            <select class="we-currency"><option value="USD" ${w.currency==='USD'?'selected':''}>$ USD</option><option value="EUR" ${w.currency==='EUR'?'selected':''}>EUR</option><option value="GBP" ${w.currency==='GBP'?'selected':''}>GBP</option></select>
            <input type="number" class="we-price" value="${w.price}" min="0" step="0.01">
          </div>
        </div>
        <div class="field"><label>Priority</label>
          <select class="we-priority">
            <option value="High" ${w.priority==='High'?'selected':''}>High</option>
            <option value="Medium" ${w.priority==='Medium'?'selected':''}>Medium</option>
            <option value="Low" ${w.priority==='Low'?'selected':''}>Low</option>
          </select>
        </div>
      </div>
      <div class="edit-grid-3">
        <div class="field" style="grid-column:span 2;"><label>Notes</label><input type="text" class="we-notes" value="${escapeHtml(w.notes||'')}"></div>
        <div class="field"></div>
      </div>
      <div class="edit-actions">
        <button class="btn-cancel">Cancel</button>
        <button class="btn-save">Save changes</button>
      </div>
    `;
    const weType = wrap.querySelector('.we-type');
    const weCat = wrap.querySelector('.we-cat');
    populateSubcategories(weCat, w.type, w.category);
    weType.addEventListener('change', ()=> populateSubcategories(weCat, weType.value));
    wrap.querySelector('.btn-cancel').onclick = ()=>{ editingWishlistId=null; renderWishlist(); };
    wrap.querySelector('.btn-save').onclick = ()=>{
      w.name = wrap.querySelector('.we-name').value.trim() || w.name;
      w.brand = wrap.querySelector('.we-brand').value.trim();
      w.production = wrap.querySelector('.we-production').value.trim();
      w.source = wrap.querySelector('.we-source').value.trim();
      w.type = weType.value;
      w.category = weCat.value;
      w.price = parseFloat(wrap.querySelector('.we-price').value) || 0;
      w.currency = wrap.querySelector('.we-currency').value;
      w.priority = wrap.querySelector('.we-priority').value;
      w.notes = wrap.querySelector('.we-notes').value.trim();
      editingWishlistId = null;
      saveWishlist();
      updateSourceSuggestions(); updateBrandSuggestions(); updateProductionSuggestions(typeSelect.value); updateLocationSuggestions(); updateSetSuggestions(); updateAppraiserSuggestions();
      renderWishlist();
    };
    return wrap;
  }

  document.getElementById('addWishlistBtn').addEventListener('click', ()=>{
    const name = document.getElementById('wName').value.trim();
    if(!name) return;
    wishlist.push({
      id: Date.now()+Math.random(), name,
      brand: document.getElementById('wBrand').value.trim(),
      production: document.getElementById('wProduction').value.trim(),
      source: document.getElementById('wSource').value.trim(),
      type: wType.value, category: wCat.value,
      price: parseFloat(document.getElementById('wPrice').value)||0,
      currency: document.getElementById('wCurrency').value,
      priority: document.getElementById('wPriority').value,
      notes: document.getElementById('wNotes').value.trim(),
      date: new Date().toISOString().slice(0,10)
    });
    { const nw = wishlist[wishlist.length-1]; const wf = wishPhotoStage.files(); wishPhotoStage.clear(); if(wf.length){ storePhotos(wf).then(ids=>{ nw.photoIds = ids; saveWishlist(); renderWishlist(); }); } }
    saveWishlist();
    updateSourceSuggestions(); updateBrandSuggestions(); updateProductionSuggestions(typeSelect.value); updateLocationSuggestions(); updateSetSuggestions(); updateAppraiserSuggestions();
    document.getElementById('wName').value=''; document.getElementById('wBrand').value='';
    document.getElementById('wProduction').value=''; document.getElementById('wSource').value='';
    document.getElementById('wPrice').value=''; document.getElementById('wNotes').value='';
    renderWishlist();
  });

  /* ================= CATALOGUES ================= */
  const CATALOGUES_KEY = 'artefaktCatalogues_v1';
  let catalogues = [];
  function loadCatalogues(){
    try{ const raw = localStorage.getItem(CATALOGUES_KEY); const p = raw ? JSON.parse(raw) : []; catalogues = Array.isArray(p) ? p : []; }
    catch(e){ catalogues = []; }
  }
  function saveCatalogues(){ try{ localStorage.setItem(CATALOGUES_KEY, JSON.stringify(catalogues)); }catch(e){} schedulePersist(); }
  loadCatalogues();

  let activeCatId = null, activeCatSection = null, catFilter = 'all', catSearch = '', catCountry = 'all', catNotice = '';
  let catCreating = false, catRenaming = false, catAddingSection = false, catShowAdd = false;
  let editingCatEntryId = null, linkingCatEntryId = null, pendingCatalogueLink = null;
  const CAT_TYPE = 'Literary Memorabilia';

  let catSeq = 0;
  function catUid(){ return 'c' + Date.now().toString(36) + (catSeq++).toString(36) + Math.random().toString(36).slice(2,6); }
  function catAttr(s){ return escapeHtml(s).replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
  function getActiveCat(){ return catalogues.find(c=>c.id===activeCatId) || catalogues[0] || null; }
  function catEntryItem(e){ return e.itemId ? (items.find(i=>i.id===e.itemId) || null) : null; }
  function catIsOwned(e){ const it = catEntryItem(e); return !!(e.owned || (it && it.itemStatus !== 'sold')); }
  function catLabel(e){ return e.title + (e.edition ? ' \u2014 ' + e.edition : '') + (e.year ? ' (' + e.year + ')' : ''); }
  function catNote(e, cat){ return 'Catalogue: ' + cat.name + (e.group ? ' \u00B7 ' + e.group : '') + (e.ref ? ' \u00B7 ' + e.ref : '') + (e.country ? ' \u00B7 ' + e.country : ''); }
  function catCountryList(list){ const have = new Set(list.map(e=>e.country || 'none')); if(have.size===1 && have.has('none')) return []; return ['UK','USA','Other','none'].filter(c=>have.has(c)); }
  function catScope(cat){ return cat.entries.filter(e=>e.section===activeCatSection && (catCountry==='all' || (e.country||'none')===catCountry)); }
  function catFind(id){ const c = getActiveCat(); return c ? c.entries.find(e=>e.id===id) : null; }
  function catVal(id){ const el = document.getElementById(id); return el ? el.value.trim() : ''; }

  /* ---- J.K. Rowling bibliography (editions list). c=code t=title y=year k=kind hp=Harry Potter e=[ref,country U/A/O,description,year] ---- */
