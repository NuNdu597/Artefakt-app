,"y":"1999","k":"B","hp":0,"e":[["B3(a)","U","First English edition for 2000","1999"],["B3(b)","U","First English edition for 2005","2004"],["B3(c)","U","First English edition for 2006","2005"],["B3(d)","U","First English edition for 2007","2006"],["B3(e)","U","First English edition for 2008","2007"],["B3(f)","U","First English edition for 2009","2008"],["B3(g)","U","First English edition for 2010","2009"],["B3(h)","U","First English edition for 2011","2010"],["B3(i)","U","First English edition for 2012","2011"],["B3(j)","U","First English edition for 2013","2012"],["B3(k)","U","First English edition for 2014","2013"],["B3(l)","U","First English edition for 2015","2014"],["B3(m)","U","First English edition for 2016","2015"],["B3(n)","U","First English edition for 2017","2016"]]},{"c":"B4","t":"Lindsay Fraser, An Interview with J.K. Rowling","y":"2000","k":"B","hp":0,"e":[["B4(a)","U","First English edition","2000"],["B4(b)","U","Second English edition","2001"],["B4(c)","U","Third English edition","2002"]]},{"c":"B5","t":"[National Council for One Parent Families], Families Just Like Us","y":"2000","k":"B","hp":0,"e":[["B5(a)","U","First English edition","2000"]]},{"c":"B6","t":"Lindsay Fraser, Conversations with J.K. Rowling","y":"2001","k":"B","hp":0,"e":[["B6(a)","A","First American edition","2001"]]},{"c":"B7","t":"Sarah Brown and Gil McNeil, Magic","y":"2002","k":"B","hp":0,"e":[["B7(a)","A","First American edition","2002"]]},{"c":"B8","t":"Children's Writers' and Artists' Yearbook","y":"2004","k":"B","hp":0,"e":[["B8(a)","U","First English edition for 2005","2004"],["B8(b)","U","First English edition for 2006","2005"],["B8(c)","U","First English edition for 2007","2006"],["B8(d)","U","First English edition for 2008","2007"],["B8(e)","U","First English edition for 2009","2008"],["B8(f)","U","First English edition for 2010","2009"],["B8(g)","U","First English edition for 2011","2010"],["B8(h)","U","First English edition for 2012","2011"],["B8(i)","U","First English edition for 2013","2012"],["B8(j)","U","First English edition for 2014","2013"],["B8(k)","U","First English edition for 2015","2014"],["B8(l)","U","First English edition for 2016","2015"],["B8(m)","U","First English edition for 2017","2016"]]},{"c":"B9","t":"[One City Trust], One City","y":"2005","k":"B","hp":0,"e":[["B9(a)","U","First English edition","2005"]]},{"c":"B10","t":"Gordon Brown (ed.Wilf Stevenson), Gordon Brown Speeches 1997-2006","y":"2006","k":"B","hp":0,"e":[["B10(a)","U","First English edition","2006"]]},{"c":"B11","t":"Gordon Brown (ed.Wilf Stevenson), Moving Britain Forward: Selected Speeches 1997-2006","y":"2006","k":"B","hp":0,"e":[["B11(a)","U","First English edition","2006"]]},{"c":"B12","t":"Willa Shalit, Becoming Myself","y":"2006","k":"B","hp":0,"e":[["B12(a)","A","First American edition","2006"],["B12(b)","A","Second American edition","2007"]]},{"c":"B13","t":"Over 70 Tried and Tested Great Books to Read Again","y":"2006","k":"B","hp":0,"e":[["B13(a)","U","First English edition","2006"]]},{"c":"B14","t":"Lindsay Fraser and Kathryn Ross, Reading Round Edinburgh","y":"2007","k":"B","hp":0,"e":[["B14(a)","U","First English edition","2007"]]},{"c":"B15","t":"Sotheby's catalogue: The Tales of Beedle the Bard","y":"2007","k":"B","hp":1,"e":[["B15(a)","U","First English edition","2007"]]},{"c":"B16","t":"Sotheby's catalogue: English Literature\u2026 13 December 2007","y":"2007","k":"B","hp":1,"e":[["B16(a)","U","First English edition","2006"]]},{"c":"B17","t":"Michael Morpurgo and Quentin Blake, The Birthday Book","y":"2008","k":"B","hp":0,"e":[["B17(a)","U","First English edition","2008"]]},{"c":"B18","t":"[Waterstone's], What's Your Story?","y":"2008","k":"B","hp":0,"e":[["B18(a)","U","First English edition","2008"]]},{"c":"B19","t":"Melisa Anelli, Harry, A History","y":"2008","k":"B","hp":0,"e":[["B19(a)","A","First American edition","2008"],["B19(b)","U","First English edition","2008"]]},{"c":"B20","t":"Joseph Galliano, Dear Me: More Letters to My Sixteen-Year-Old Self","y":"2011","k":"B","hp":0,"e":[["B20(a)","U","First English edition","2011"]]},{"c":"B21","t":"Philip W. Errington, J.K. Rowling - A Bibliography 1997-2013","y":"2015","k":"B","hp":1,"e":[["B21(a)","U","First English edition (hardback)","2015"]]},{"c":"B22","t":"Jack Thorne, Harry Potter and the Cursed Child","y":"2016","k":"B","hp":1,"e":[["B22(a)","U","First English edition (hardback)","2016"],["B22(aa)","A","First American edition (hardback)","2016"]]}];
  const ROW_OTHER_NAME = 'J.K. Rowling \u2014 other works';
  const BIB_COUNTRY = { U:'UK', A:'USA', O:'Other' };
  const STARTER_REFS = {
    "UK first editions (Bloomsbury)|Harry Potter and the Philosopher's Stone":'A1(a)', "UK first editions (Bloomsbury)|Harry Potter and the Chamber of Secrets":'A2(a)',
    "UK first editions (Bloomsbury)|Harry Potter and the Prisoner of Azkaban":'A7(a)', "UK first editions (Bloomsbury)|Harry Potter and the Goblet of Fire":'A9(a)',
    "UK first editions (Bloomsbury)|Harry Potter and the Order of the Phoenix":'A12(a)', "UK first editions (Bloomsbury)|Harry Potter and the Half-Blood Prince":'A13(a)',
    "UK first editions (Bloomsbury)|Harry Potter and the Deathly Hallows":'A14(a)',
    "US first editions (Scholastic)|Harry Potter and the Sorcerer's Stone":'A4(a)', "US first editions (Scholastic)|Harry Potter and the Chamber of Secrets":'A2(c)',
    "US first editions (Scholastic)|Harry Potter and the Prisoner of Azkaban":'A7(b)', "US first editions (Scholastic)|Harry Potter and the Goblet of Fire":'A9(aa)',
    "US first editions (Scholastic)|Harry Potter and the Order of the Phoenix":'A12(aaa)', "US first editions (Scholastic)|Harry Potter and the Half-Blood Prince":'A13(aaa)',
    "US first editions (Scholastic)|Harry Potter and the Deathly Hallows":'A14(aaaa)',
    "Companion books (UK first editions)|Fantastic Beasts and Where to Find Them":'A10(a)', "Companion books (UK first editions)|Quidditch Through the Ages":'A11(a)',
    "Companion books (UK first editions)|The Tales of Beedle the Bard":'A15(a)', "Companion books (UK first editions)|Harry Potter and the Cursed Child \u2014 Parts One and Two":'B22(a)',
    "Illustrated editions (Bloomsbury)|Harry Potter and the Philosopher's Stone":'A1(q)', "Illustrated editions (Bloomsbury)|Harry Potter and the Chamber of Secrets":'A2(v)'
  };
  function bibCategory(desc){ return /^first (english|american) edition/i.test(desc) ? 'Rare/First Edition Book' : 'Other'; }
  function bibGroup(w){ return w.c + ' \u00B7 ' + w.t + (w.y ? ' (' + w.y + ')' : '') + (w.k==='AA' ? ' \u2014 proofs & advance copies' : ''); }
  function importRowlingBibliography(){
    let hp = catalogues.find(c=>c.name==='Harry Potter');
    if(!hp){ hp = makeHarryPotterCatalogue(); catalogues.push(hp); }
    if(!hp.sections.includes('Books')) hp.sections.unshift('Books');
    const index = {}, order = {}; let n = 0;
    ROWLING_BIB.forEach(w=>w.e.forEach(ed=>{ index[ed[0]] = { w, ed }; order[ed[0]] = n++; }));
    let matched = 0;
    hp.entries.forEach(e=>{
      if(e.ref) return;
      const ref = STARTER_REFS[(e.group||'') + '|' + e.title], hit = ref && index[ref];
      if(hit){ e.title = hit.w.t; e.edition = hit.ed[2]; e.year = hit.ed[3]; e.group = bibGroup(hit.w); e.country = BIB_COUNTRY[hit.ed[1]]; e.ref = ref; e.category = bibCategory(hit.ed[2]); matched++; }
      else if(!e.country && e.section==='Books') e.country = 'UK';
    });
    let other = catalogues.find(c=>c.name===ROW_OTHER_NAME);
    const added = { hp:0, other:0 };
    ROWLING_BIB.forEach(w=>{
      let target = w.hp ? hp : other;
      if(!target){ other = { id:catUid(), name:ROW_OTHER_NAME, description:'The rest of the J.K. Rowling bibliography: other novels, proofs, pamphlets and contributions, split by country.', sections:['Books'], entries:[] }; catalogues.push(other); target = other; }
      const have = new Set(target.entries.map(x=>x.ref).filter(Boolean));
      w.e.forEach(ed=>{
        if(have.has(ed[0])) return;
        target.entries.push({ id:catUid(), section:'Books', group:bibGroup(w), title:w.t, edition:ed[2], year:ed[3], notes:'', category:bibCategory(ed[2]),
          country:BIB_COUNTRY[ed[1]], ref:ed[0], owned:false, itemId:null, wishId:null });
        added[w.hp ? 'hp' : 'other']++;
      });
    });
    const rank = x=> (x.ref in order) ? order[x.ref] : Infinity;
    [hp, other].filter(Boolean).forEach(c=>c.entries.sort((a,b)=>{ const A = rank(a), B = rank(b); return A===B ? 0 : (A<B ? -1 : 1); }));
    activeCatId = hp.id; activeCatSection = 'Books'; catCountry = 'all'; catFilter = 'all'; catSearch = '';
    catNotice = (added.hp || added.other)
      ? 'Imported ' + added.hp + ' editions into Harry Potter' + (matched ? ' (' + matched + ' of your starter entries matched and kept their progress)' : '') + ' and ' + added.other + ' into \u201C' + ROW_OTHER_NAME + '\u201D.'
      : 'Already up to date \u2014 every bibliography edition is in your catalogues.';
    saveCatalogues();
  }

  function makeHarryPotterCatalogue(){
    const FE = 'Rare/First Edition Book';
    const mk = (group, title, edition, year, notes, category)=>({
      id: catUid(), section:'Books', group, title, edition: edition||'', year: year ? String(year) : '',
      notes: notes||'', category: category||'Other', owned:false, itemId:null, wishId:null
    });
    const E = [];
    [["Harry Potter and the Philosopher's Stone",1997],["Harry Potter and the Chamber of Secrets",1998],["Harry Potter and the Prisoner of Azkaban",1999],
     ["Harry Potter and the Goblet of Fire",2000],["Harry Potter and the Order of the Phoenix",2003],["Harry Potter and the Half-Blood Prince",2005],
     ["Harry Potter and the Deathly Hallows",2007]].forEach(([t,y],i)=>
      E.push(mk('UK first editions (Bloomsbury)', t, 'First edition, first printing, hardback', y, i===0 ? 'Very small first print run \u2014 check points of issue with a specialist before buying.' : '', FE)));
    [["Harry Potter and the Sorcerer's Stone",1998],["Harry Potter and the Chamber of Secrets",1999],["Harry Potter and the Prisoner of Azkaban",1999],
     ["Harry Potter and the Goblet of Fire",2000],["Harry Potter and the Order of the Phoenix",2003],["Harry Potter and the Half-Blood Prince",2005],
     ["Harry Potter and the Deathly Hallows",2007]].forEach(([t,y])=>
      E.push(mk('US first editions (Scholastic)', t, 'First edition, first printing, hardback', y, '', FE)));
    [["Fantastic Beasts and Where to Find Them",2001],["Quidditch Through the Ages",2001],["The Tales of Beedle the Bard",2008],
     ["Harry Potter and the Cursed Child \u2014 Parts One and Two",2016]].forEach(([t,y])=>
      E.push(mk('Companion books (UK first editions)', t, 'UK first edition', y, '', FE)));
    [["Harry Potter and the Philosopher's Stone",2015,''],["Harry Potter and the Chamber of Secrets",2016,''],["Harry Potter and the Prisoner of Azkaban",2017,''],
     ["Harry Potter and the Goblet of Fire",2019,''],["Harry Potter and the Order of the Phoenix",2022,'Illustrated with Neil Packer.']].forEach(([t,y,n])=>
      E.push(mk('Illustrated editions (Bloomsbury)', t, 'Illustrated edition (Jim Kay)', y, n, 'Other')));
    E.push(mk('Illustrated editions (Bloomsbury)', 'Harry Potter and the Half-Blood Prince', 'Illustrated edition (Levi Pinfold)', '', 'Announced for October 2026 \u2014 verify release and edition details.', 'Other'));
    E.push(mk('Illustrated editions (Bloomsbury)', 'Harry Potter and the Deathly Hallows', 'Illustrated edition (Levi Pinfold)', '', 'Announced \u2014 release date to be confirmed.', 'Other'));
    ['Gryffindor','Hufflepuff','Ravenclaw','Slytherin'].forEach(h=>
      E.push(mk('20th Anniversary House Editions', "Harry Potter and the Philosopher's Stone", h + ' House Edition', 2017, '', 'Other')));
    return { id: catUid(), name:'Harry Potter', description:'Editions and collectibles to track for Harry Potter. Edit, add or remove entries freely.', sections:['Books'], entries:E };
  }

  function catNewFormHtml(){
    return `<div class="panel"><div class="panel-label">New catalogue</div>
      <div class="form-grid-4">
        <div class="field"><label>Name</label><input type="text" id="catNewName" placeholder="e.g. Lord of the Rings"></div>
        <div class="field"><label>First section</label><input type="text" id="catNewSection" value="Books"></div>
        <div class="field" style="grid-column:span 2;"><label>Description (optional)</label><input type="text" id="catNewDesc"></div>
      </div>
      <div class="cat-actions" style="justify-content:flex-start;"><button class="cat-btn primary" data-act="create-cat">Create</button><button class="cat-btn" data-act="new-cancel">Cancel</button></div></div>`;
  }

  function catAddFormHtml(se){
    const groups = [...new Set(se.map(e=>e.group).filter(Boolean))];
    return `<div class="panel"><div class="panel-label">Add entry to ${escapeHtml(activeCatSection)}</div>
      <div class="form-grid-4">
        <div class="field"><label>Title</label><input type="text" id="caTitle"></div>
        <div class="field"><label>Edition / variant</label><input type="text" id="caEdition" placeholder="e.g. UK first edition"></div>
        <div class="field"><label>Year</label><input type="text" id="caYear" placeholder="e.g. 1997"></div>
        <div class="field"><label>Group</label><input type="text" id="caGroup" list="caGroupList" placeholder="e.g. Illustrated editions">
          <datalist id="caGroupList">${groups.map(g=>`<option value="${catAttr(g)}">`).join('')}</datalist></div>
      </div>
      <div style="display:flex;gap:12px;align-items:flex-end;">
        <div class="field" style="flex:1;"><label>Notes</label><input type="text" id="caNotes" placeholder="Points of issue, where to look, etc."></div>
        <div class="field" style="width:120px;"><label>Country</label><select id="caCountry"><option value="">\u2014</option>${['UK','USA','Other'].map(c=>`<option ${catCountry===c?'selected':''}>${c}</option>`).join('')}</select></div>
        <div class="field" style="width:110px;"><label>Ref</label><input type="text" id="caRef" placeholder="e.g. A1(a)"></div>
        <button class="cat-btn primary" data-act="add-entry" style="margin-bottom:2px;">Add entry</button>
      </div></div>`;
  }

  function renderCatalogue(){
    const root = document.getElementById('catalogueRoot'); if(!root) return;
    const cat = getActiveCat();
    if(cat){ activeCatId = cat.id; if(!cat.sections.includes(activeCatSection)) activeCatSection = cat.sections[0] || null; }
    let h = '';
    if(!catalogues.length){
      h += `<div class="panel"><div class="panel-label">Catalogues</div>
        <p class="cat-sub" style="margin:0 0 14px;">A catalogue is a checklist of the pieces you want to collect for a theme. Tick them off as you find them, or send them to your wishlist and collection.</p>
        <div class="cat-head"><button class="cat-btn primary" data-act="new-hp">Start with Harry Potter \u2014 Books (full bibliography)</button><button class="cat-btn" data-act="new-open">Create blank catalogue</button></div></div>`;
    } else {
      const hasHP = catalogues.some(c=>c.name==='Harry Potter');
      h += `<div class="cat-head">` + catalogues.map(c=>`<button class="chip ${c.id===cat.id?'active':''}" data-act="pick-cat" data-id="${catAttr(c.id)}">${escapeHtml(c.name)}</button>`).join('')
        + `<button class="chip" data-act="new-open">+ New catalogue</button>` + (hasHP ? '' : `<button class="chip" data-act="new-hp">+ Harry Potter starter</button>`) + `</div>`;
    }
    if(catCreating) h += catNewFormHtml();
    if(cat){
      const all = cat.entries, ownedAll = all.filter(catIsOwned).length, pct = all.length ? Math.round(ownedAll/all.length*100) : 0;
      h += `<div class="panel"><div class="cat-titlerow">`
        + (catRenaming
          ? `<input type="text" id="catRenameInput" value="${catAttr(cat.name)}" style="max-width:320px;"><button class="cat-btn primary" data-act="rename-save">Save</button><button class="cat-btn" data-act="rename-cancel">Cancel</button>`
          : `<div class="cat-name">${escapeHtml(cat.name)}</div>${cat.name==='Harry Potter' ? '<button class="cat-btn primary" data-act="import-bib">Import J.K. Rowling bibliography</button>' : ''}<button class="cat-btn" data-act="rename-open">Rename</button><button class="cat-btn danger" data-act="delete-cat">Delete catalogue</button>`)
        + `</div>`
        + (cat.description ? `<div class="cat-sub" style="margin-top:6px;">${escapeHtml(cat.description)}</div>` : '')
        + (catNotice ? `<div class="cat-sub" style="margin-top:8px;color:var(--accent);">${escapeHtml(catNotice)}</div>` : '')
        + `<div class="cat-progress"><div style="width:${pct}%"></div></div><div class="cat-meta">${ownedAll} of ${all.length} owned \u00B7 ${pct}%</div></div>`;
      h += `<div class="cat-head">` + cat.sections.map(sn=>{
        const se = all.filter(e=>e.section===sn);
        return `<button class="chip ${sn===activeCatSection?'active':''}" data-act="pick-section" data-id="${catAttr(sn)}">${escapeHtml(sn)} ${se.filter(catIsOwned).length}/${se.length}</button>`;
      }).join('')
        + (catAddingSection
          ? `<input type="text" id="catNewSecName" placeholder="Section name"><button class="cat-btn primary" data-act="section-add-save">Add</button><button class="cat-btn" data-act="section-add-cancel">Cancel</button>`
          : `<button class="chip" data-act="section-add-open">+ Section</button>`)
        + `</div>`;
      if(activeCatSection){
        const secAll = all.filter(e=>e.section===activeCatSection), ctry = catCountryList(secAll);
        if(catCountry !== 'all' && !ctry.includes(catCountry)) catCountry = 'all';
        if(ctry.length){
          h += `<div class="cat-head"><span class="cat-tag">Country</span><button class="chip ${catCountry==='all'?'active':''}" data-act="country" data-id="all">All ${secAll.length}</button>`
            + ctry.map(c=>{ const ce = secAll.filter(e=>(e.country||'none')===c); return `<button class="chip ${catCountry===c?'active':''}" data-act="country" data-id="${catAttr(c)}">${c==='none'?'Unassigned':escapeHtml(c)} ${ce.filter(catIsOwned).length}/${ce.length}</button>`; }).join('') + `</div>`;
        }
        const se = catScope(cat), nOwned = se.filter(catIsOwned).length;
        h += `<div class="cat-head">
          <button class="chip ${catFilter==='all'?'active':''}" data-act="filter" data-id="all">All ${se.length}</button>
          <button class="chip ${catFilter==='missing'?'active':''}" data-act="filter" data-id="missing">Missing ${se.length-nOwned}</button>
          <button class="chip ${catFilter==='owned'?'active':''}" data-act="filter" data-id="owned">Owned ${nOwned}</button>
          <input type="text" id="catSearch" placeholder="Search this section\u2026" value="${catAttr(catSearch)}">
          <button class="cat-btn ${catShowAdd?'primary':''}" data-act="toggle-add">${catShowAdd ? '\u2212 Add entry' : '+ Add entry'}</button></div>`;
        if(catShowAdd) h += catAddFormHtml(secAll);
      }
    }
    root.innerHTML = h + '<div id="catBody"></div>';
    renderCatalogueBody();
  }

  function catEntryHtml(e){
    const id = catAttr(e.id);
    if(editingCatEntryId === e.id){
      return `<div class="cat-entry cat-edit"><div class="cat-main">
        <div class="form-grid-4">
          <div class="field"><label>Title</label><input type="text" class="ce-title" value="${catAttr(e.title)}"></div>
          <div class="field"><label>Edition / variant</label><input type="text" class="ce-edition" value="${catAttr(e.edition)}"></div>
          <div class="field"><label>Year</label><input type="text" class="ce-year" value="${catAttr(e.year)}"></div>
          <div class="field"><label>Group</label><input type="text" class="ce-group" value="${catAttr(e.group)}"></div>
        </div>
        <div style="display:flex;gap:12px;"><div class="field" style="flex:1;"><label>Notes</label><input type="text" class="ce-notes" value="${catAttr(e.notes)}"></div>
          <div class="field" style="width:120px;"><label>Country</label><select class="ce-country"><option value="">\u2014</option>${['UK','USA','Other'].map(c=>`<option ${e.country===c?'selected':''}>${c}</option>`).join('')}</select></div>
          <div class="field" style="width:110px;"><label>Ref</label><input type="text" class="ce-ref" value="${catAttr(e.ref||'')}"></div></div>
        <div class="cat-actions" style="margin-top:10px;justify-content:flex-start;"><button class="cat-btn primary" data-act="edit-save" data-id="${id}">Save</button><button class="cat-btn" data-act="edit-cancel">Cancel</button></div>
      </div></div>`;
    }
    const it = catEntryItem(e), owned = catIsOwned(e);
    const onWish = !!(e.wishId && wishlist.some(w=>w.id===e.wishId));
    const dup = !!(e.ref && e.group && e.title && e.group.indexOf(e.title) !== -1);
    const primary = dup ? (e.edition || e.title) : e.title;
    const cty = catCountry === 'all' ? e.country : '';
    const sub = (dup ? [e.ref, e.year, cty] : [e.edition, e.year, e.ref, cty]).filter(Boolean).join(' \u00B7 ');
    let actions = '';
    if(linkingCatEntryId === e.id){
      const used = new Set(); catalogues.forEach(c=>c.entries.forEach(x=>{ if(x.itemId) used.add(x.itemId); }));
      const opts = items.filter(i=>!used.has(i.id)).sort((a,b)=>String(a.name).localeCompare(String(b.name)))
        .map(i=>`<option value="${catAttr(i.id)}">${escapeHtml(i.name)}</option>`).join('');
      actions = `<select data-act="link-select" data-id="${id}"><option value="">Choose item\u2026</option>${opts}</select><button class="cat-btn" data-act="link-cancel">Cancel</button>`;
    } else {
      if(!owned){
        actions += `<button class="cat-btn primary" data-act="add-coll" data-id="${id}">Add to collection</button>`;
        actions += onWish ? `<span class="cat-tag">On wishlist</span>` : `<button class="cat-btn" data-act="wish" data-id="${id}">Wishlist</button>`;
      }
      if(!it) actions += `<button class="cat-btn" data-act="link-open" data-id="${id}">Link item</button>`;
      actions += `<button class="cat-btn" data-act="edit" data-id="${id}">Edit</button><button class="cat-btn danger" data-act="del" data-id="${id}" title="Remove entry">&times;</button>`;
    }
    return `<div class="cat-entry ${owned?'owned':''}">
      <button class="cat-check" data-act="toggle" data-id="${id}" title="${owned?'Mark as not owned':'Mark as owned'}">${owned?'\u2713':''}</button>
      <div class="cat-main"><div class="cat-title">${escapeHtml(primary)}</div>
        ${sub ? `<div class="cat-sub">${escapeHtml(sub)}</div>` : ''}
        ${e.notes ? `<div class="cat-sub cat-note">${escapeHtml(e.notes)}</div>` : ''}
        ${it ? `<div class="cat-sub">In your collection: ${escapeHtml(it.name)}${it.itemStatus==='sold' ? ' (sold)' : ''}</div>` : ''}
      </div><div class="cat-actions">${actions}</div></div>`;
  }

  function renderCatalogueBody(){
    const body = document.getElementById('catBody'); const cat = getActiveCat(); if(!body) return;
    if(!cat){ body.innerHTML = ''; return; }
    if(!activeCatSection){ body.innerHTML = `<div class="empty">Add a section (for example "Books") to start adding entries.</div>`; return; }
    const se = catScope(cat);
    if(!se.length){ body.innerHTML = `<div class="empty">No entries yet. Use "+ Add entry" above.</div>`; return; }
    const q = catSearch.trim().toLowerCase();
    const shown = se.filter(e=>{
      const o = catIsOwned(e);
      if(catFilter==='owned' && !o) return false;
      if(catFilter==='missing' && o) return false;
      if(q && ![e.title,e.edition,e.year,e.group,e.notes,e.ref,e.country].join(' ').toLowerCase().includes(q)) return false;
      return true;
    });
    if(!shown.length){ body.innerHTML = `<div class="empty">Nothing matches that filter or search.</div>`; return; }
    const order = []; se.forEach(e=>{ const g = e.group || ''; if(!order.includes(g)) order.push(g); });
    body.innerHTML = order.map(g=>{
      const inGroup = shown.filter(e=>(e.group||'')===g); if(!inGroup.length) return '';
      const grp = se.filter(e=>(e.group||'')===g);
      return `<div class="cat-group"><div class="cat-group-title"><span>${escapeHtml(g || 'Other entries')}</span><span>${grp.filter(catIsOwned).length}/${grp.length}</span></div>${inGroup.map(catEntryHtml).join('')}</div>`;
    }).join('');
  }

  function startCatalogueAdd(e, cat){
    pendingCatalogueLink = { entryId:e.id, catId:cat.id, name:catLabel(e) };
    document.querySelector(".tabbtn[data-tab='collection']").click();
    const form = document.getElementById('logPieceForm');
    if(!form.classList.contains('open')) document.getElementById('logPieceToggle').click();
    nameInput.value = catLabel(e);
    typeSelect.value = CAT_TYPE;
    populateSubcategories(catSelect, CAT_TYPE, e.category || 'Other');
    updateProductionSuggestions(CAT_TYPE);
    productionInput.value = cat.name;
    document.getElementById('fNotes').value = catNote(e, cat);
    form.scrollIntoView({ behavior:'smooth', block:'start' });
  }
  function applyPendingCatalogueLink(newItem){
    const pnd = pendingCatalogueLink; pendingCatalogueLink = null;
    if(!pnd || newItem.name !== pnd.name) return;
    const cat = catalogues.find(c=>c.id===pnd.catId); const e = cat && cat.entries.find(x=>x.id===pnd.entryId);
    if(!e) return;
    e.itemId = newItem.id; e.owned = false; saveCatalogues();
  }
  function catalogueOnWishlistAcquired(wishId, itemId){
    let changed = false;
    catalogues.forEach(c=>c.entries.forEach(e=>{ if(e.wishId === wishId){ e.itemId = itemId; e.owned = false; e.wishId = null; changed = true; } }));
    if(changed) saveCatalogues();
  }

  const catRoot = document.getElementById('catalogueRoot');
  const CAT_FOCUS = { 'new-open':'catNewName', 'section-add-open':'catNewSecName', 'rename-open':'catRenameInput', 'toggle-add':'caTitle', 'add-entry':'caTitle' };
  catRoot.addEventListener('click', ev=>{
    const b = ev.target.closest('[data-act]'); if(!b || b.tagName === 'SELECT') return;
    const act = b.dataset.act, id = b.dataset.id;
    const cat = getActiveCat();
    if(act !== 'import-bib' && act !== 'new-hp') catNotice = '';
    switch(act){
      case 'pick-cat': activeCatId = id; activeCatSection = null; catFilter = 'all'; catSearch = ''; catCountry = 'all'; catRenaming = false; catAddingSection = false; catShowAdd = false; editingCatEntryId = null; linkingCatEntryId = null; break;
      case 'new-open': catCreating = true; break;
      case 'new-cancel': catCreating = false; break;
      case 'new-hp': { importRowlingBibliography(); catCreating = false; break; }
      case 'import-bib': importRowlingBibliography(); break;
      case 'country': catCountry = id; break;
      case 'create-cat': {
        const name = catVal('catNewName'); if(!name){ document.getElementById('catNewName').focus(); return; }
        const sec = catVal('catNewSection');
        const c = { id:catUid(), name, description:catVal('catNewDesc'), sections: sec ? [sec] : [], entries:[] };
        catalogues.push(c); activeCatId = c.id; activeCatSection = null; catCreating = false; saveCatalogues(); break; }
      case 'rename-open': catRenaming = true; break;
      case 'rename-cancel': catRenaming = false; break;
      case 'rename-save': { const name = catVal('catRenameInput'); if(!name || !cat) return; cat.name = name; catRenaming = false; saveCatalogues(); break; }
      case 'delete-cat':
        if(!cat || !confirm('Delete the "' + cat.name + '" catalogue and all its entries? Items in your collection are not affected.')) return;
        catalogues = catalogues.filter(c=>c.id!==cat.id); activeCatId = null; activeCatSection = null; saveCatalogues(); break;
      case 'pick-section': activeCatSection = id; catFilter = 'all'; catSearch = ''; catCountry = 'all'; editingCatEntryId = null; linkingCatEntryId = null; break;
      case 'section-add-open': catAddingSection = true; break;
      case 'section-add-cancel': catAddingSection = false; break;
      case 'section-add-save': {
        const name = catVal('catNewSecName'); if(!name || !cat) return;
        if(!cat.sections.includes(name)) cat.sections.push(name);
        activeCatSection = name; catAddingSection = false; saveCatalogues(); break; }
      case 'filter': catFilter = id; break;
      case 'toggle-add': catShowAdd = !catShowAdd; break;
      case 'add-entry': {
        const title = catVal('caTitle'); if(!title){ document.getElementById('caTitle').focus(); return; }
        const edition = catVal('caEdition');
        cat.entries.push({ id:catUid(), section:activeCatSection, group:catVal('caGroup'), title, edition, year:catVal('caYear'), notes:catVal('caNotes'), country:catVal('caCountry'), ref:catVal('caRef'),
          category: /first edition/i.test(edition) ? 'Rare/First Edition Book' : 'Other', owned:false, itemId:null, wishId:null });
        saveCatalogues(); break; }
      case 'toggle': { const e = catFind(id); if(!e) return; if(catIsOwned(e)){ e.owned = false; e.itemId = null; } else { e.owned = true; } saveCatalogues(); break; }
      case 'edit': editingCatEntryId = id; break;
      case 'edit-cancel': editingCatEntryId = null; break;
      case 'edit-save': {
        const e = catFind(id), row = b.closest('.cat-edit'); if(!e || !row) return;
        const t = row.querySelector('.ce-title').value.trim(); if(!t) return;
        e.title = t; e.edition = row.querySelector('.ce-edition').value.trim(); e.year = row.querySelector('.ce-year').value.trim();
        e.group = row.querySelector('.ce-group').value.trim(); e.notes = row.querySelector('.ce-notes').value.trim(); e.country = row.querySelector('.ce-country').value; e.ref = row.querySelector('.ce-ref').value.trim();
        editingCatEntryId = null; saveCatalogues(); break; }
      case 'del': { if(!cat) return; cat.entries = cat.entries.filter(e=>e.id!==id); saveCatalogues(); break; }
      case 'link-open': linkingCatEntryId = id; break;
      case 'link-cancel': linkingCatEntryId = null; break;
      case 'wish': {
        const e = catFind(id); if(!e || !cat) return;
        const wid = Date.now() + Math.random();
        wishlist.push({ id:wid, name:catLabel(e), brand:'', production:cat.name, source:'', type:CAT_TYPE, category:e.category || 'Other',
          price:0, currency:'USD', priority:'Medium', notes:catNote(e, cat), date:new Date().toISOString().slice(0,10) });
        e.wishId = wid; saveWishlist(); saveCatalogues(); break; }
      case 'add-coll': { const e = catFind(id); if(e && cat) startCatalogueAdd(e, cat); return; }
      default: return;
    }
    renderCatalogue();
    if(CAT_FOCUS[act]){ const f = document.getElementById(CAT_FOCUS[act]); if(f){ f.focus(); if(f.select && act==='rename-open') f.select(); } }
  });
  catRoot.addEventListener('change', ev=>{
    const sel = ev.target;
    if(!sel.dataset || sel.dataset.act !== 'link-select' || !sel.value) return;
    const e = catFind(sel.dataset.id), it = items.find(i=>String(i.id) === sel.value);
    if(!e || !it) return;
    e.itemId = it.id; e.owned = false; linkingCatEntryId = null; saveCatalogues(); renderCatalogue();
  });
  catRoot.addEventListener('input', ev=>{
    if(ev.target.id === 'catSearch'){ catSearch = ev.target.value; renderCatalogueBody(); }
  });
  const CAT_ENTER = { caTitle:'add-entry', caEdition:'add-entry', caYear:'add-entry', caGroup:'add-entry', caNotes:'add-entry', catNewName:'create-cat', catNewSection:'create-cat', catNewDesc:'create-cat', catRenameInput:'rename-save', catNewSecName:'section-add-save' };
  catRoot.addEventListener('keydown', ev=>{
    if(ev.key !== 'Enter' || !CAT_ENTER[ev.target.id]) return;
    ev.preventDefault();
    const btn = catRoot.querySelector('[data-act="' + CAT_ENTER[ev.target.id] + '"]'); if(btn) btn.click();
  });

  /* ================= EXPENSES ================= */
  const EXPENSES_KEY = 'rackLedgerExpenses_v1';
  let expenses = [];
  function loadExpenses(){ try{ const raw=localStorage.getItem(EXPENSES_KEY); expenses = raw?JSON.parse(raw):[]; }catch(e){ expenses=[]; } }
  function saveExpenses(){ try{ localStorage.setItem(EXPENSES_KEY, JSON.stringify(expenses)); }catch(e){} schedulePersist(); }
  loadExpenses();

  const eType = document.getElementById('eType');
  Object.keys(EXPENSE_TYPES).forEach(t=>{ const o=document.createElement('option'); o.value=t; o.textContent=t; eType.appendChild(o); });

  const eLinked = document.getElementById('eLinked');
  function refreshLinkedItemOptions(){
    const current = eLinked.value;
    eLinked.innerHTML = '<option value="">None</option>';
    items.forEach(it=>{
      const o = document.createElement('option'); o.value = it.id; o.textContent = it.name;
      eLinked.appendChild(o);
    });
    if([...eLinked.options].some(o=>o.value===current)) eLinked.value = current;
  }

  function renderExpenseStats(){
    const box = document.getElementById('expenseStatCards');
    const now = new Date();
    const thisMonth = now.toISOString().slice(0,7);
    const thisYear = now.getFullYear().toString();

    const sums = {USD:0, EUR:0, GBP:0};
    expenses.forEach(e=>{ const c=CURRENCIES.includes(e.currency)?e.currency:'USD'; sums[c]+=num(e.amount); });

    const monthTotal = expenses.filter(e=>e.date && e.date.startsWith(thisMonth)).reduce((s,e)=> s+convertToUSD(num(e.amount), e.currency||'USD'),0);
    const yearTotal = expenses.filter(e=>e.date && e.date.startsWith(thisYear)).reduce((s,e)=> s+convertToUSD(num(e.amount), e.currency||'USD'),0);

    let html = CURRENCIES.map(c => `
      <div class="ccard"><div class="num">${fmtMoney(sums[c], c)}</div><div class="lbl">${c} total (exact)</div></div>
    `).join('');
    const canConvert = usdPerUnit.EUR || usdPerUnit.GBP || (sums.EUR===0 && sums.GBP===0);
    html += `<div class="ccard divider"><div class="num small">${canConvert ? fmtMoney(monthTotal,'USD') : '\u2014'}</div><div class="lbl">This month (est. USD)</div></div>`;
    html += `<div class="ccard"><div class="num small">${canConvert ? fmtMoney(yearTotal,'USD') : '\u2014'}</div><div class="lbl">This year (est. USD)</div></div>`;
    html += `<div class="ccard"><div class="num small">${expenses.length}</div><div class="lbl">Entries logged</div></div>`;
    box.innerHTML = html;
  }

  function renderExpenseBars(){
    const box = document.getElementById('expenseBars');
    const sums = {}; Object.keys(EXPENSE_TYPES).forEach(t=> sums[t]=0);
    expenses.forEach(e=>{ sums[e.type] = (sums[e.type]||0) + convertToUSD(num(e.amount), e.currency||'USD'); });
    box.innerHTML = barRowsHtml(sums, t=>EXPENSE_TYPES[t], expenseBarsShowAll, 'No spend logged yet.', 'type');
  }
  document.getElementById('expenseBars').addEventListener('click', e=>{ if(e.target.closest('[data-bars-toggle]')){ expenseBarsShowAll = !expenseBarsShowAll; renderExpenseBars(); } });

  let editingExpenseId = null;
  function renderExpenses(){
    refreshLinkedItemOptions();
    const box = document.getElementById('expense-list');
    box.innerHTML = '';
    const sorted = [...expenses].sort((a,b)=> b.date.localeCompare(a.date) || b.id-a.id);
    if(sorted.length===0){
      const empty = document.createElement('div'); empty.className='empty';
      empty.textContent = "No expenses logged yet \u2014 storage, shipping, customs, insurance...";
      box.appendChild(empty);
    } else {
      sorted.forEach(e=> box.appendChild(e.id===editingExpenseId ? buildExpenseEditRow(e) : buildExpenseRow(e)));
    }
    document.getElementById('expenseVisCount').textContent = `${expenses.length} expense${expenses.length===1?'':'s'} logged`;
    renderExpenseStats();
    renderExpenseBars();
  }

  function buildExpenseRow(e){
    const color = EXPENSE_TYPES[e.type] || '#6b6558';
    const linkedItem = items.find(it=>String(it.id)===String(e.linkedItemId));
    const row = document.createElement('div');
    row.className = 'row expense-row';
    row.innerHTML = `
      <div class="tab" style="background:${color}"></div>
      <div class="col-name">
        <div class="item-name">${escapeHtml(e.type)}${e.recurring ? ' <span class="badge-sub" style="display:inline;">(monthly)</span>' : ''}</div>
        ${e.note ? `<div class="item-sub">${escapeHtml(e.note)}</div>` : ''}
        ${linkedItem ? `<div class="item-sub">for: ${escapeHtml(linkedItem.name)}</div>` : ''}
      </div>
      <div></div>
      <div class="price outflow">-${fmtMoney(e.amount, e.currency)}</div>
      <div class="loc"></div>
      <div class="date">${fmtDate(e.date)}</div>
      <div class="row-actions">
        ${e.recurring ? '<button class="icon-btn dup" title="Log again this month">+1mo</button>' : ''}
        <button class="icon-btn edit">Edit</button>
        <button class="icon-btn del">&times;</button>
      </div>
    `;
    if(e.recurring){
      row.querySelector('.dup').onclick = ()=>{
        expenses.push({...e, id: Date.now()+Math.random(), date: new Date().toISOString().slice(0,10)});
        saveExpenses(); renderExpenses();
      };
    }
    row.querySelector('.edit').onclick = ()=>{ editingExpenseId = e.id; renderExpenses(); };
    row.querySelector('.del').onclick = ()=>{ expenses = expenses.filter(x=>x.id!==e.id); saveExpenses(); renderExpenses(); };
    return row;
  }

  function buildExpenseEditRow(e){
    const wrap = document.createElement('div');
    wrap.className = 'edit-row';
    const typeOpts = Object.keys(EXPENSE_TYPES).map(t=>`<option value="${t}" ${t===e.type?'selected':''}>${t}</option>`).join('');
    const linkedOpts = ['<option value="">None</option>', ...items.map(it=>`<option value="${it.id}" ${String(it.id)===String(e.linkedItemId)?'selected':''}>${escapeHtml(it.name)}</option>`)].join('');
    wrap.innerHTML = `
      <div class="edit-grid-2">
        <div class="field"><label>Type</label><select class="e-etype">${typeOpts}</select></div>
        <div class="field"><label>Amount</label>
          <div class="price-row">
            <select class="e-ecurrency"><option value="USD" ${e.currency==='USD'?'selected':''}>$ USD</option><option value="EUR" ${e.currency==='EUR'?'selected':''}>EUR</option><option value="GBP" ${e.currency==='GBP'?'selected':''}>GBP</option></select>
            <input type="number" class="e-eamount" value="${e.amount}" min="0" step="0.01">
          </div>
        </div>
        <div class="field"><label>Linked item</label><select class="e-elinked">${linkedOpts}</select></div>
        <div class="field checkfield"><input type="checkbox" class="e-erecurring" ${e.recurring?'checked':''}><label style="margin:0;">Monthly recurring</label></div>
      </div>
      <div class="edit-grid-3">
        <div class="field" style="grid-column:span 2;"><label>Note</label><input type="text" class="e-enote" value="${escapeHtml(e.note||'')}"></div>
        <div class="field"><label>Date</label><input type="date" class="e-edate" value="${e.date}"></div>
      </div>
      <div class="edit-actions">
        <button class="btn-cancel">Cancel</button>
        <button class="btn-save">Save changes</button>
      </div>
    `;
    wrap.querySelector('.btn-cancel').onclick = ()=>{ editingExpenseId=null; renderExpenses(); };
    wrap.querySelector('.btn-save').onclick = ()=>{
      e.type = wrap.querySelector('.e-etype').value;
      e.amount = parseFloat(wrap.querySelector('.e-eamount').value) || 0;
      e.currency = wrap.querySelector('.e-ecurrency').value;
      e.linkedItemId = wrap.querySelector('.e-elinked').value;
      e.recurring = wrap.querySelector('.e-erecurring').checked;
      e.note = wrap.querySelector('.e-enote').value.trim();
      e.date = wrap.querySelector('.e-edate').value || e.date;
      editingExpenseId = null; saveExpenses(); renderExpenses();
    };
    return wrap;
  }

  document.getElementById('addExpenseBtn').addEventListener('click', ()=>{
    const amount = parseFloat(document.getElementById('eAmount').value) || 0;
    if(amount<=0){ document.getElementById('eAmount').focus(); return; }
    expenses.push({
      id: Date.now()+Math.random(),
      type: eType.value,
      amount, currency: document.getElementById('eCurrency').value,
      linkedItemId: eLinked.value,
      recurring: document.getElementById('eRecurring').checked,
      note: document.getElementById('eNote').value.trim(),
      date: new Date().toISOString().slice(0,10)
    });
    saveExpenses();
    document.getElementById('eAmount').value=''; document.getElementById('eNote').value='';
    document.getElementById('eRecurring').checked=false;
    renderExpenses();
  });

  document.getElementById('exportExpenseCsv').addEventListener('click', (e)=>{
    const header = ['Type','Amount','Currency','Recurring','Linked Item','Note','Date'];
    const rows = expenses.map(ex=>{
      const linkedItem = items.find(it=>String(it.id)===String(ex.linkedItemId));
      return [ex.type, ex.amount, ex.currency, ex.recurring?'Yes':'No', linkedItem?linkedItem.name:'', ex.note, ex.date];
    });
    const csv = [header,...rows].map(r=> r.map(v=>`"${String(v==null?'':v).replace(/"/g,'""')}"`).join(',')).join('\n');
    prepareDownloadLink(e.currentTarget, csv, 'text/csv');
  });

  /* ================= EXIT VALUE ================= */
  function renderExit(){
    const box = document.getElementById('exit-list');
    const holdings = items.filter(it => it.itemStatus !== 'sold');
    const priced = holdings.filter(hasOffer);

    /* Whole-collection estimated value: min offer where set, paid price otherwise */
    let totalPaidAllUSD = 0, estValueUSD = 0;
    holdings.forEach(it=>{
      const paidUSD = convertToUSD(num(it.price), it.currency||'USD');
      totalPaidAllUSD += paidUSD;
      estValueUSD += hasOffer(it) ? convertToUSD(num(it.minOffer), it.currency||'USD') : paidUSD;
    });
    const changeUSD = estValueUSD - totalPaidAllUSD;
    const changePct = totalPaidAllUSD > 0 ? (changeUSD/totalPaidAllUSD*100) : 0;
    const banner = document.getElementById('exitValueBanner');
    banner.innerHTML = `
      <div class="goal-top">
        <div class="goal-title">Estimated collection value right now</div>
        <div class="goal-pct ${profitClass(changeUSD)}">${fmtMoney(estValueUSD,'USD')}</div>
      </div>
      <div class="goal-bottom">
        <span>${fmtMoney(totalPaidAllUSD,'USD')} paid \u2192 ${fmtMoney(estValueUSD,'USD')} estimated now \u2014 <span class="${profitClass(changeUSD)}">${changeUSD>=0?'+':''}${fmtMoney(changeUSD,'USD')} (${fmtPct(changePct)})</span></span>
        <span>${priced.length} of ${holdings.length} pieces have a min offer set \u2014 the rest are valued at what you paid</span>
      </div>
    `;

    let totalPaidUSD = 0, totalOfferUSD = 0;
    priced.forEach(it=>{
      totalPaidUSD += convertToUSD(num(it.price), it.currency||'USD');
      totalOfferUSD += convertToUSD(num(it.minOffer), it.currency||'USD');
    });
    const totalProfitUSD = totalOfferUSD - totalPaidUSD;
    const blendedPct = totalPaidUSD > 0 ? (totalProfitUSD/totalPaidUSD*100) : 0;
    const inProfit = priced.filter(it=>profitAmount(it)>0).length;
    const inLoss = priced.filter(it=>profitAmount(it)<0).length;

    const statBox = document.getElementById('exitStatCards');
    statBox.innerHTML = `
      <div class="ccard"><div class="num ${profitClass(totalProfitUSD)}">${totalProfitUSD>=0?'+':''}${fmtMoney(totalProfitUSD,'USD')}</div><div class="lbl">Potential profit (priced only)</div></div>
      <div class="ccard"><div class="num small ${profitClass(blendedPct)}">${priced.length?fmtPct(blendedPct):'\u2014'}</div><div class="lbl">Blended return</div></div>
      <div class="ccard divider"><div class="num small">${priced.length} / ${holdings.length}</div><div class="lbl">Items valued</div></div>
      <div class="ccard"><div class="num small profit-pos">${inProfit}</div><div class="lbl">In profit</div></div>
      <div class="ccard"><div class="num small profit-neg">${inLoss}</div><div class="lbl">In loss</div></div>
    `;

    renderSoldArchive();

    box.innerHTML = '';
    if(priced.length===0){
      const empty = document.createElement('div'); empty.className='empty';
      empty.textContent = holdings.length===0
        ? "No pieces logged yet."
        : "No min offer set on any piece yet \u2014 add one from the Collection tab to see potential profit here.";
      box.appendChild(empty);
      return;
    }
    const sorted = [...priced].sort((a,b)=> profitPct(b) - profitPct(a));
    sorted.forEach(it=>{
      const color = typeColor(it.type);
      const pAmt = profitAmount(it);
      const pPct = profitPct(it);
      const row = document.createElement('div');
      row.className = 'row exit-row';
      row.innerHTML = `
        <div class="tab" style="background:${pAmt>=0?'#6FBF73':'#E2604C'}"></div>
        <div class="col-name">
          <div class="item-name">${escapeHtml(it.name)}</div>
          <div class="item-sub">${escapeHtml(it.type)} \u00B7 ${escapeHtml(it.category)}</div>
        </div>
        <div class="price">${fmtMoney(it.price, it.currency)}</div>
        <div class="price">${fmtMoney(it.minOffer, it.currency)}</div>
        <div class="price ${profitClass(pAmt)}">${pAmt>=0?'+':''}${fmtMoney(pAmt, it.currency)}</div>
        <div class="price ${profitClass(pPct)}" style="font-size:14px;">${fmtPct(pPct)}</div>
      `;
      box.appendChild(row);
    });
  }

  function renderSoldArchive(){
    const box = document.getElementById('soldArchiveList');
    const sold = items.filter(it => it.itemStatus === 'sold');
    box.innerHTML = '';
    if(sold.length === 0){
      const empty = document.createElement('div'); empty.className = 'empty';
      empty.textContent = 'Nothing sold yet. Mark a piece as Sold from its edit form in the Collection tab.';
      box.appendChild(empty);
      return;
    }
    const sorted = [...sold].sort((a,b)=> (b.soldDate||'').localeCompare(a.soldDate||''));
    sorted.forEach(it=>{
      const p = soldProfitInfo(it);
      const row = document.createElement('div');
      row.className = 'row exit-row';
      row.innerHTML = `
        <div class="tab" style="background:${p && p.pct<0 ? '#E2604C' : '#6FBF73'}"></div>
        <div class="col-name">
          <div class="item-name">${escapeHtml(it.name)}</div>
          <div class="item-sub">${it.soldTo ? 'Sold to '+escapeHtml(it.soldTo)+' \u00B7 ' : ''}${fmtDate(it.soldDate)}</div>
        </div>
        <div class="price">${fmtMoney(it.price, it.currency)}</div>
        <div class="price">${fmtMoney(it.soldPrice, it.soldCurrency)}</div>
        <div class="price ${p?p.cls:''}">${p ? (p.pct>=0?'+':'') + fmtMoney(convertToUSD(num(it.soldPrice),it.soldCurrency||'USD') - convertToUSD(num(it.price),it.currency||'USD'), 'USD') : '\u2014'}</div>
        <div class="price ${p?p.cls:''}" style="font-size:14px;">${p ? p.text : '\u2014'}</div>
      `;
      box.appendChild(row);
    });
  }

  /* ================= LEDGER (people / running accounts) ================= */
  const CONTACTS_KEY = 'rackLedgerContacts_v1';
  const LEDGER_ENTRIES_KEY = 'rackLedgerEntries_v1';
  let contacts = [];
  let ledgerEntries = [];
  let selectedContactId = null;
  let editingLedgerEntryId = null;
  let ledgerEntryType = 'batch';

  function loadLedgerData(){
    try{ const raw = localStorage.getItem(CONTACTS_KEY); contacts = raw ? JSON.parse(raw) : []; }catch(e){ contacts = []; }
    try{ const raw = localStorage.getItem(LEDGER_ENTRIES_KEY); ledgerEntries = raw ? JSON.parse(raw) : []; }catch(e){ ledgerEntries = []; }
  }
  function saveContacts(){ try{ localStorage.setItem(CONTACTS_KEY, JSON.stringify(contacts)); }catch(e){} schedulePersist(); }
  function saveLedgerEntries(){ try{ localStorage.setItem(LEDGER_ENTRIES_KEY, JSON.stringify(ledgerEntries)); }catch(e){} schedulePersist(); }
  loadLedgerData();
  document.getElementById('ledgerDate').value = new Date().toISOString().slice(0,10);

  function contactBalances(contactId){
    const sums = {};
    ledgerEntries.filter(e=>e.contactId===contactId).forEach(e=>{
      const c = e.currency || 'USD';
      const amt = num(e.amount);
      sums[c] = (sums[c]||0) + (e.type==='batch' ? amt : -amt);
    });
    return Object.entries(sums)
      .filter(([c,v])=> Math.abs(v) > 0.01)
      .map(([currency,amount])=> ({ currency, amount, owed: amount>0 }));
  }

  document.getElementById('addContactBtn').addEventListener('click', ()=>{
    const nameEl = document.getElementById('newContactName');
    const name = nameEl.value.trim();
    if(!name) return;
    contacts.push({ id: Date.now()+Math.random(), name });
    saveContacts();
    nameEl.value = '';
    renderContactCards();
  });
  document.getElementById('newContactName').addEventListener('keydown', (e)=>{
    if(e.key === 'Enter') document.getElementById('addContactBtn').click();
  });

  function renderContactCards(){
    const box = document.getElementById('contactCards');
    box.innerHTML = '';
    if(contacts.length === 0){
      const empty = document.createElement('div'); empty.className = 'empty';
      empty.textContent = 'No people yet. Add someone above to start tracking a running account with them.';
      box.appendChild(empty);
      return;
    }
    contacts.forEach(c=>{
      const balances = contactBalances(c.id);
      const entryCount = ledgerEntries.filter(e=>e.contactId===c.id).length;
      const card = document.createElement('div');
      card.className = 'contact-card' + (c.id===selectedContactId ? ' selected' : '');
      const balanceHtml = balances.length === 0
        ? `<div class="contact-balance settled">Settled up</div>`
        : balances.map(b=>`
            <div class="contact-balance ${b.owed?'owe':'settled'}">${fmtMoney(Math.abs(b.amount), b.currency)}</div>
            <div class="contact-balance-lbl">${b.owed?'you owe':'they owe you'}</div>
          `).join('');
      card.innerHTML = `
        <div class="contact-name">${escapeHtml(c.name)}</div>
        ${balanceHtml}
        <div class="contact-sub">${entryCount} entr${entryCount===1?'y':'ies'} logged</div>
      `;
      card.addEventListener('click', ()=>{ selectedContactId = c.id; renderContactCards(); renderLedgerDetail(); });
      box.appendChild(card);
    });
  }

  document.getElementById('closeLedgerDetail').addEventListener('click', ()=>{
    selectedContactId = null;
    document.getElementById('ledgerDetailPanel').style.display = 'none';
    renderContactCards();
  });
  document.getElementById('deleteContactBtn').addEventListener('click', ()=>{
    if(!selectedContactId) return;
    contacts = contacts.filter(c=>c.id!==selectedContactId);
    ledgerEntries = ledgerEntries.filter(e=>e.contactId!==selectedContactId);
    saveContacts(); saveLedgerEntries();
    selectedContactId = null;
    document.getElementById('ledgerDetailPanel').style.display = 'none';
    renderContactCards();
  });

  document.getElementById('ledgerTypeBatch').addEventListener('click', ()=>{
    ledgerEntryType = 'batch';
    document.getElementById('ledgerTypeBatch').classList.add('active');
    document.getElementById('ledgerTypePayment').classList.remove('active');
  });
  document.getElementById('ledgerTypePayment').addEventListener('click', ()=>{
    ledgerEntryType = 'payment';
    document.getElementById('ledgerTypePayment').classList.add('active');
    document.getElementById('ledgerTypeBatch').classList.remove('active');
  });

  document.getElementById('addLedgerEntryBtn').addEventListener('click', ()=>{
    if(!selectedContactId) return;
    const amount = num(document.getElementById('ledgerAmount').value);
    if(amount <= 0) return;
    const currency = document.getElementById('ledgerCurrency').value;
    const date = document.getElementById('ledgerDate').value || new Date().toISOString().slice(0,10);
    const note = document.getElementById('ledgerNote').value.trim();
    ledgerEntries.push({ id: Date.now()+Math.random(), contactId: selectedContactId, type: ledgerEntryType, amount, currency, date, note });
    saveLedgerEntries();
    document.getElementById('ledgerAmount').value = '';
    document.getElementById('ledgerNote').value = '';
    document.getElementById('ledgerDate').value = new Date().toISOString().slice(0,10);
    renderContactCards();
    renderLedgerDetail();
  });

  function buildLedgerEditRow(e){
    const wrap = document.createElement('div');
    wrap.className = 'edit-row';
    wrap.innerHTML = `
      <div class="ledger-type-toggle">
        <button type="button" class="ledger-type-btn ${e.type==='batch'?'active':''}" data-entrytype="batch">Batch (they sold me)</button>
        <button type="button" class="ledger-type-btn ${e.type==='payment'?'active':''}" data-entrytype="payment">Payment (I paid them)</button>
      </div>
      <div class="form-grid-3">
        <div class="field"><label>Amount</label><input type="number" class="le-amount" value="${e.amount}" min="0" step="0.01"></div>
        <div class="field"><label>Currency</label>
          <select class="le-currency">
            <option value="GBP" ${e.currency==='GBP'?'selected':''}>GBP</option>
            <option value="USD" ${e.currency==='USD'?'selected':''}>USD</option>
            <option value="EUR" ${e.currency==='EUR'?'selected':''}>EUR</option>
          </select>
        </div>
        <div class="field"><label>Date</label><input type="date" class="le-date" value="${e.date}"></div>
      </div>
      <div class="form-grid-3">
        <div class="field" style="grid-column:1/3;"><label>Note (optional)</label><input type="text" class="le-note" value="${escapeHtml(e.note||'')}"></div>
      </div>
      <div class="edit-actions">
        <button class="btn-save">Save</button>
        <button class="btn-cancel">Cancel</button>
      </div>
    `;
    let editType = e.type;
    wrap.querySelectorAll('.ledger-type-btn').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        editType = btn.dataset.entrytype;
        wrap.querySelectorAll('.ledger-type-btn').forEach(b=>b.classList.toggle('active', b===btn));
      });
    });
    wrap.querySelector('.btn-save').addEventListener('click', ()=>{
      const amount = num(wrap.querySelector('.le-amount').value);
      if(amount <= 0) return;
      const orig = ledgerEntries.find(x=>x.id===e.id);
      if(orig){
        orig.type = editType;
        orig.amount = amount;
        orig.currency = wrap.querySelector('.le-currency').value;
        orig.date = wrap.querySelector('.le-date').value || orig.date;
        orig.note = wrap.querySelector('.le-note').value.trim();
      }
      saveLedgerEntries();
      editingLedgerEntryId = null;
      renderContactCards();
      renderLedgerDetail();
    });
    wrap.querySelector('.btn-cancel').addEventListener('click', ()=>{
      editingLedgerEntryId = null;
      renderLedgerDetail();
    });
    return wrap;
  }

  function renderLedgerDetail(){
    if(!selectedContactId) return;
    const contact = contacts.find(c=>c.id===selectedContactId);
    if(!contact){ selectedContactId = null; document.getElementById('ledgerDetailPanel').style.display='none'; return; }
    document.getElementById('ledgerDetailPanel').style.display = 'block';
    document.getElementById('ledgerDetailName').textContent = contact.name;
    document.getElementById('ledgerDate').value = document.getElementById('ledgerDate').value || new Date().toISOString().slice(0,10);

    const balances = contactBalances(contact.id);
    const balEl = document.getElementById('ledgerDetailBalance');
    if(balances.length === 0){
      balEl.className = 'ledger-detail-balance settled';
      balEl.textContent = 'Settled up';
    } else {
      balEl.className = 'ledger-detail-balance';
      balEl.innerHTML = balances.map(b=>`<span class="${b.owed?'owe':'settled'}">${fmtMoney(Math.abs(b.amount), b.currency)} \u2014 ${b.owed ? 'you owe' : 'they owe you'}</span>`).join('<br>');
    }

    const listBox = document.getElementById('ledgerEntryList');
    listBox.innerHTML = '';
    const entries = ledgerEntries.filter(e=>e.contactId===contact.id);
    if(entries.length === 0){
      const empty = document.createElement('div'); empty.className = 'empty';
      empty.textContent = 'No entries yet. Log a batch or a payment above.';
      listBox.appendChild(empty);
      return;
    }
    const chronological = [...entries].sort((a,b)=> a.date.localeCompare(b.date) || a.id-b.id);
    const runningByCurrency = {};
    const withRunning = chronological.map(e=>{
      const c = e.currency || 'USD';
      runningByCurrency[c] = (runningByCurrency[c]||0) + (e.type==='batch' ? num(e.amount) : -num(e.amount));
      return { ...e, runningNative: runningByCurrency[c] };
    });
    const newestFirst = [...withRunning].reverse();
    newestFirst.forEach(e=>{
      if(e.id === editingLedgerEntryId){
        listBox.appendChild(buildLedgerEditRow(e));
        return;
      }
      const row = document.createElement('div');
      row.className = 'row ledger-row';
      const isBatch = e.type === 'batch';
      row.innerHTML = `
        <div class="tab" style="background:${isBatch ? 'var(--gold)' : 'var(--profit-pos)'}"></div>
        <div class="date">${fmtDate(e.date)}</div>
        <div><span class="ledger-entry-badge" style="background:${isBatch ? 'rgba(220,192,122,0.14)' : 'rgba(111,191,115,0.14)'};color:${isBatch ? 'var(--gold)' : 'var(--profit-pos)'};border:1px solid ${isBatch ? 'rgba(220,192,122,0.4)' : 'rgba(111,191,115,0.4)'}">${isBatch ? 'Batch' : 'Payment'}</span></div>
        <div class="loc">${escapeHtml(e.note || '\u2014')}</div>
        <div class="price ${isBatch ? 'owe' : 'settled'}">${isBatch ? '+' : '\u2212'}${fmtMoney(num(e.amount), e.currency)}</div>
        <div class="ledger-running">${fmtMoney(Math.abs(e.runningNative), e.currency)} ${e.runningNative>0.01 ? 'owed' : (e.runningNative<-0.01 ? 'ahead' : 'even')}</div>
        <div class="row-actions">
          <button class="icon-btn edit">Edit</button>
          <button class="icon-btn del">&times;</button>
        </div>
      `;
      row.querySelector('.edit').addEventListener('click', ()=>{ editingLedgerEntryId = e.id; renderLedgerDetail(); });
      row.querySelector('.del').addEventListener('click', ()=>{
        ledgerEntries = ledgerEntries.filter(x=>x.id!==e.id);
        saveLedgerEntries();
        renderContactCards();
        renderLedgerDetail();
      });
      listBox.appendChild(row);
    });
  }

  /* ================= CONSIGNMENTS (auction house tracking, sourced from Collection items) ================= */
  let editingConsignId = null;
  let activeConsignStatus = 'All';
  const CONSIGN_STATUS_LABELS = { listed:'Awaiting sale', sold:'Sold', unsold:'Unsold (passed)', returning:'Returning to me' };
  let addFormListingType = 'auction';
  document.querySelectorAll('.listing-type-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      addFormListingType = btn.dataset.listingtype;
      document.querySelectorAll('.listing-type-btn').forEach(b=>b.classList.toggle('active', b===btn));
      const isBuyNow = addFormListingType === 'buyNow';
      document.getElementById('cnEstLowLabel').textContent = isBuyNow ? 'Price' : 'Estimate low';
      document.getElementById('cnEstHighField').style.display = isBuyNow ? 'none' : '';
    });
  });
  document.getElementById('cnSaleDate').value = new Date().toISOString().slice(0,10);

  function sendableItems(){
    return items.filter(it => !it.itemStatus || it.itemStatus==='collection');
  }
  function populateConsignItemSelect(){
    const sel = document.getElementById('cnItemSelect');
    const current = sel.value;
    sel.innerHTML = '<option value="">Select an item to consign\u2026</option>' +
      sendableItems().map(it=>`<option value="${it.id}">${escapeHtml(it.name)}</option>`).join('');
    if([...sel.options].some(o=>o.value===current)) sel.value = current;
  }

  function updateHouseSuggestions(){
    const dl = document.getElementById('houseSuggestions');
    const unique = uniqueCaseInsensitive(items.map(it=>it.consignHouse).filter(Boolean));
    dl.innerHTML = unique.map(s=>`<option value="${escapeHtml(s)}">`).join('');
  }

  function renderConsignStatusChips(){
    const box = document.getElementById('consignStatusChips');
    const opts = ['All','listed','sold','unsold','returning'];
    box.innerHTML = '';
    opts.forEach(s=>{
      const el = document.createElement('div');
      el.className = 'chip' + (s===activeConsignStatus ? ' active' : '');
      el.textContent = s==='All' ? 'All' : CONSIGN_STATUS_LABELS[s];
      el.onclick = ()=>{ activeConsignStatus = s; renderConsignStatusChips(); renderConsignments(); };
      box.appendChild(el);
    });
  }

  function consignedItems(){
    return items.filter(it => it.itemStatus === 'consigned');
  }

  function renderConsignHouseFilter(){
    const sel = document.getElementById('consignHouseFilter');
    const current = sel.value;
    const houses = uniqueCaseInsensitive(consignedItems().map(it=>it.consignHouse).filter(Boolean));
    sel.innerHTML = '<option value="All">All auction houses</option>' + houses.map(h=>`<option value="${escapeHtml(h)}">${escapeHtml(h)}</option>`).join('');
    if(houses.includes(current)) sel.value = current;
  }

  function renderConsignStats(){
    const box = document.getElementById('consignStatCards');
    const all = consignedItems();
    const listed = all.filter(it=>it.consignSaleStatus==='listed'||!it.consignSaleStatus);
    const sold = all.filter(it=>it.consignSaleStatus==='sold');
    const unsold = all.filter(it=>it.consignSaleStatus==='unsold');
    const returning = all.filter(it=>it.consignSaleStatus==='returning');
    const estLowSum = listed.reduce((s,it)=> s + convertToUSD(num(it.consignEstLow), it.consignCurrency||'USD'), 0);
    const estHighSum = listed.reduce((s,it)=> s + convertToUSD(num(it.consignEstHigh), it.consignCurrency||'USD'), 0);
    const realizedSum = sold.reduce((s,it)=> s + convertToUSD(num(it.consignSoldPrice), it.consignCurrency||'USD'), 0);
    box.innerHTML = `
      <div class="ccard"><div class="num">${listed.length}</div><div class="lbl">Awaiting sale</div></div>
      <div class="ccard divider"><div class="num small">${fmtMoney(estLowSum,'USD')}\u2013${fmtMoney(estHighSum,'USD')}</div><div class="lbl">Estimated range</div></div>
      <div class="ccard"><div class="num">${sold.length}</div><div class="lbl">Sold</div></div>
      <div class="ccard divider"><div class="num small">${fmtMoney(realizedSum,'USD')}</div><div class="lbl">Total realized</div></div>
      <div class="ccard"><div class="num">${unsold.length}</div><div class="lbl">Unsold</div></div>
      <div class="ccard"><div class="num">${returning.length}</div><div class="lbl">Returning to me</div></div>
    `;
  }

  function consignSaleComparison(it){
    const sold = num(it.consignSoldPrice);
    const low = num(it.consignEstLow);
    const high = num(it.consignEstHigh);
    if(sold <= 0) return null;
    const isBuyNow = it.consignListingType === 'buyNow';
    if(high > 0 && sold > high){
      const pct = ((sold-high)/high)*100;
      return { text: `+${pct.toFixed(0)}% above ${isBuyNow ? 'listed price' : 'high estimate'}`, cls: 'profit-pos' };
    }
    if(low > 0 && sold < low){
      const pct = ((low-sold)/low)*100;
      return { text: `\u2212${pct.toFixed(0)}% below ${isBuyNow ? 'listed price' : 'low estimate'}`, cls: 'profit-neg' };
    }
    return { text: isBuyNow ? 'Sold at listed price' : 'Within estimate', cls: 'muted' };
  }

  function consignGroupSummary(group){
    const auctionSums = {};
    const buyNowSums = {};
    group.forEach(it=>{
      const cur = it.consignCurrency || 'USD';
      if(it.consignListingType === 'buyNow'){
        buyNowSums[cur] = (buyNowSums[cur]||0) + num(it.consignEstLow);
      } else {
        if(!auctionSums[cur]) auctionSums[cur] = {low:0, high:0};
        auctionSums[cur].low += num(it.consignEstLow);
        auctionSums[cur].high += num(it.consignEstHigh);
      }
    });
    const parts = [];
    const auctionCurrencies = Object.keys(auctionSums);
    if(auctionCurrencies.length){
      const text = auctionCurrencies.map(cur => `${fmtMoney(auctionSums[cur].low, cur)}\u2013${fmtMoney(auctionSums[cur].high, cur)}`).join(', ');
      parts.push(`Auction: ${text}`);
    }
    const buyNowCurrencies = Object.keys(buyNowSums);
    if(buyNowCurrencies.length){
      const text = buyNowCurrencies.map(cur => fmtMoney(buyNowSums[cur], cur)).join(', ');
      parts.push(`Buy Now: ${text}`);
    }
    return parts;
  }

  function consignLocationInfo(it){
    const text = (it.consignCurrentLoc && it.consignCurrentLoc.trim()) ? it.consignCurrentLoc.trim() : (it.consignHouse || '');
    const atHouse = !!(it.consignHouse && text.toLowerCase() === it.consignHouse.trim().toLowerCase());
    return { text: text || '\u2014', atHouse };
  }

  function consignPriceLabel(it){
    return it.consignListingType === 'buyNow' ? 'Buy Now price' : 'Estimate';
  }
  function consignPriceText(it){
    if(it.consignListingType === 'buyNow') return fmtMoney(num(it.consignEstLow), it.consignCurrency);
    return `${fmtMoney(num(it.consignEstLow), it.consignCurrency)} \u2013 ${fmtMoney(num(it.consignEstHigh), it.consignCurrency)}`;
  }

  function returnItemToCollection(it){
    it.itemStatus = 'collection';
    saveItems();
    updateHouseSuggestions();
    renderConsignHouseFilter();
    populateConsignItemSelect();
    renderConsignments();
  }

  function openItemInCollectionEditor(itemId){
    editingId = itemId;
    [...document.querySelectorAll('.tabbtn')].forEach(b=>b.classList.remove('active'));
    [...document.querySelectorAll('.tabpane')].forEach(p=>p.classList.remove('active'));
    document.querySelector(".tabbtn[data-tab='collection']").classList.add('active');
    document.getElementById('tab-collection').classList.add('active');
    render();
  }

  function buildConsignCard(it){
    if(it.id === editingConsignId) return buildConsignInlineEditCard(it);
    const status = it.consignSaleStatus || 'listed';
    const card = document.createElement('div');
    card.className = 'consign-card status-' + status;
    const comparison = status==='sold' ? consignSaleComparison(it) : null;
    const locInfo = consignLocationInfo(it);
    const buyNowTag = it.consignListingType==='buyNow' ? `<span class="buynow-badge">Buy Now</span>` : '';
    card.innerHTML = `
      <div class="consign-top">
        <div>
          <div class="consign-name">${escapeHtml(it.name)}</div>
          <div class="consign-house">${escapeHtml(it.consignHouse||'\u2014')}${it.consignLot ? ' \u00B7 ' + escapeHtml(it.consignLot) : ''}</div>
        </div>
        <div class="consign-status-stack" style="justify-content:flex-end;">
          <span class="status-badge status-${status}">${CONSIGN_STATUS_LABELS[status]}</span>
          ${buyNowTag}
        </div>
      </div>
      ${status==='sold' ? `
        <div class="consign-sold-row">
          <span class="consign-sold-price">${fmtMoney(num(it.consignSoldPrice), it.consignCurrency)}</span>
          ${comparison ? `<span class="${comparison.cls}" style="font-family:'IBM Plex Mono', monospace;font-size:11px;">${comparison.text}</span>` : ''}
        </div>
        <div class="consign-meta"><span>${consignPriceLabel(it)}: ${consignPriceText(it)}</span></div>
      ` : `
        <div class="consign-estimate">
          <div>
            <div class="consign-estimate-val">${consignPriceText(it)}</div>
            <div class="consign-estimate-lbl">${consignPriceLabel(it)}</div>
          </div>
        </div>
      `}
      <div class="consign-meta"><span>Sale date: ${fmtDate(it.consignSaleDate)}</span></div>
      <div class="consign-meta"><span class="consign-loc ${locInfo.atHouse ? 'at-house' : 'returned'}">${locInfo.atHouse ? 'Still at the auction house' : escapeHtml(locInfo.text)}</span></div>
      ${it.consignNote ? `<div class="consign-note">${escapeHtml(it.consignNote)}</div>` : ''}
      <div class="consign-actions">
        <button class="icon-btn verify" style="color:var(--profit-pos);border-color:var(--profit-pos);">Return to collection</button>
        <button class="icon-btn edit">Edit</button>
      </div>
    `;
    card.querySelector('.verify').addEventListener('click', ()=> returnItemToCollection(it));
    card.querySelector('.edit').addEventListener('click', ()=>{ editingConsignId = it.id; renderConsignments(); });
    return card;
  }

  function buildConsignInlineEditCard(it){
    const card = document.createElement('div');
    card.className = 'consign-card edit-row';
    const statusOptsHtml = Object.keys(CONSIGN_STATUS_LABELS).map(s=>`<option value="${s}" ${s===(it.consignSaleStatus||'listed')?'selected':''}>${CONSIGN_STATUS_LABELS[s]}</option>`).join('');
    card.innerHTML = `
      <div class="form-grid-2">
        <div class="field"><label>Item</label><input type="text" class="ce-name" value="${escapeHtml(it.name)}"></div>
        <div class="field"><label>Auction house</label><input type="text" class="ce-house" list="houseSuggestions" value="${escapeHtml(it.consignHouse||'')}"></div>
        <div class="field"><label>Lot number</label><input type="text" class="ce-lot" value="${escapeHtml(it.consignLot||'')}"></div>
        <div class="field"><label>Sale date</label><input type="date" class="ce-saledate" value="${it.consignSaleDate||''}"></div>
      </div>
      <div class="ledger-type-toggle">
        <button type="button" class="listing-type-btn ce-listingtype-btn ${it.consignListingType!=='buyNow'?'active':''}" data-listingtype="auction">Auction (estimate range)</button>
        <button type="button" class="listing-type-btn ce-listingtype-btn ${it.consignListingType==='buyNow'?'active':''}" data-listingtype="buyNow">Buy Now (fixed price)</button>
      </div>
      <div class="form-grid-2">
        <div class="field"><label class="ce-estlow-label">${it.consignListingType==='buyNow'?'Price':'Estimate low'}</label><input type="number" class="ce-estlow" value="${it.consignEstLow||''}" min="0" step="0.01"></div>
        <div class="field ce-esthigh-field" style="${it.consignListingType==='buyNow'?'display:none;':''}"><label>Estimate high</label><input type="number" class="ce-esthigh" value="${it.consignEstHigh||''}" min="0" step="0.01"></div>
        <div class="field"><label>Currency</label>
          <select class="ce-currency">
            <option value="USD" ${it.consignCurrency==='USD'?'selected':''}>$ USD</option>
            <option value="EUR" ${it.consignCurrency==='EUR'?'selected':''}>EUR</option>
            <option value="GBP" ${it.consignCurrency==='GBP'?'selected':''}>GBP</option>
          </select>
        </div>
        <div class="field"><label>Status</label><select class="ce-status">${statusOptsHtml}</select></div>
      </div>
      <div class="form-grid-2">
        <div class="field" style="grid-column: span 2;"><label>Current location</label><input type="text" class="ce-loc" list="locationSuggestions" value="${escapeHtml(it.consignCurrentLoc||'')}" placeholder="Leave blank to assume it's still at the auction house"></div>
      </div>
      <div class="form-grid-2">
        <div class="field"><label>Sold price</label><input type="number" class="ce-soldprice" value="${it.consignSoldPrice||''}" min="0" step="0.01"></div>
        <div class="field"><label>Note</label><input type="text" class="ce-note" value="${escapeHtml(it.consignNote||'')}"></div>
      </div>
      <div class="edit-actions">
        <button class="btn-cancel">Cancel</button>
        <button class="btn-save">Save changes</button>
      </div>
    `;
    let editListingType = it.consignListingType==='buyNow' ? 'buyNow' : 'auction';
    card.querySelectorAll('.ce-listingtype-btn').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        editListingType = btn.dataset.listingtype;
        card.querySelectorAll('.ce-listingtype-btn').forEach(b=>b.classList.toggle('active', b===btn));
        const isBuyNow = editListingType === 'buyNow';
        card.querySelector('.ce-estlow-label').textContent = isBuyNow ? 'Price' : 'Estimate low';
        card.querySelector('.ce-esthigh-field').style.display = isBuyNow ? 'none' : '';
      });
    });
    card.querySelector('.btn-cancel').onclick = ()=>{ editingConsignId = null; renderConsignments(); };
    card.querySelector('.btn-save').onclick = ()=>{
      it.name = card.querySelector('.ce-name').value.trim() || it.name;
      it.consignHouse = card.querySelector('.ce-house').value.trim();
      it.consignLot = card.querySelector('.ce-lot').value.trim();
      it.consignSaleDate = card.querySelector('.ce-saledate').value;
      const priceVal = parseFloat(card.querySelector('.ce-estlow').value) || 0;
      it.consignEstLow = priceVal;
      it.consignEstHigh = editListingType==='buyNow' ? priceVal : (parseFloat(card.querySelector('.ce-esthigh').value) || 0);
      it.consignListingType = editListingType;
      it.consignCurrency = card.querySelector('.ce-currency').value;
      it.consignSaleStatus = card.querySelector('.ce-status').value;
      it.consignCurrentLoc = card.querySelector('.ce-loc').value.trim();
      it.consignSoldPrice = parseFloat(card.querySelector('.ce-soldprice').value) || 0;
      it.consignNote = card.querySelector('.ce-note').value.trim();
      editingConsignId = null;
      saveItems();
      updateHouseSuggestions();
      renderConsignHouseFilter();
      renderConsignments();
    };
    return card;
  }

  function buildConsignRow(it){
    if(it.id === editingConsignId) return buildConsignInlineEditCard(it);
    const status = it.consignSaleStatus || 'listed';
    const row = document.createElement('div');
    row.className = 'row consign-row';
    const comparison = status==='sold' ? consignSaleComparison(it) : null;
    const locInfo = consignLocationInfo(it);
    const statusColor = status==='sold' ? 'var(--profit-pos)' : (status==='unsold' ? 'var(--danger)' : (status==='returning' ? '#dcc07a' : 'var(--gold)'));
    const valueHtml = status==='sold'
      ? `<span class="price-num">${fmtMoney(num(it.consignSoldPrice), it.consignCurrency)}</span>${comparison ? `<div class="item-sub ${comparison.cls}">${comparison.text}</div>` : ''}`
      : `<span class="price-num">${consignPriceText(it)}</span>`;
    const buyNowTag = it.consignListingType==='buyNow' ? `<span class="buynow-badge">Buy Now</span>` : '';
    row.innerHTML = `
      <div class="tab" style="background:${statusColor}"></div>
      <div class="col-name">
        <div class="item-name">${escapeHtml(it.name)}</div>
        <div class="item-sub">${escapeHtml(it.consignHouse||'\u2014')}${it.consignLot ? ' \u00B7 ' + escapeHtml(it.consignLot) : ''}</div>
      </div>
      <div class="consign-status-stack"><span class="status-badge status-${status}">${CONSIGN_STATUS_LABELS[status]}</span>${buyNowTag}</div>
      <div class="col-price price">${valueHtml}</div>
      <div class="consign-loc ${locInfo.atHouse ? 'at-house' : 'returned'}">${locInfo.atHouse ? 'Still at auction house' : escapeHtml(locInfo.text)}</div>
      <div class="date">${fmtDate(it.consignSaleDate)}</div>
      <div class="row-actions">
        <button class="icon-btn verify" style="color:var(--profit-pos);border-color:var(--profit-pos);" title="Return to collection">\u21A9</button>
        <button class="icon-btn edit">Edit</button>
      </div>
    `;
    row.querySelector('.verify').addEventListener('click', ()=> returnItemToCollection(it));
    row.querySelector('.edit').addEventListener('click', ()=>{ editingConsignId = it.id; renderConsignments(); });
    return row;
  }

  const CONSIGN_VIEW_KEY = 'rackLedgerConsignView_v1';
  let consignViewMode = 'gallery';
  try{ consignViewMode = localStorage.getItem(CONSIGN_VIEW_KEY) || 'gallery'; }catch(e){}
  function syncConsignViewButtons(){
    document.querySelectorAll('.consign-vt-btn').forEach(b=> b.classList.toggle('active', b.dataset.view===consignViewMode));
  }
  document.querySelectorAll('.consign-vt-btn').forEach(b=>{
    b.addEventListener('click', ()=>{
      consignViewMode = b.dataset.view;
      try{ localStorage.setItem(CONSIGN_VIEW_KEY, consignViewMode); }catch(e){}
      syncConsignViewButtons();
      renderConsignments();
    });
  });

  function renderConsignments(){
    renderConsignStats();
    const box = document.getElementById('consignCards');
    box.className = consignViewMode==='gallery' ? 'consign-grid' : 'list-view';
    const q = document.getElementById('consignSearch').value.trim().toLowerCase();
    const houseFilter = document.getElementById('consignHouseFilter').value;
    const sortMode = document.getElementById('consignSort').value;
    const all = consignedItems();
    let filtered = all.filter(it=>{
      const status = it.consignSaleStatus || 'listed';
      const matchesStatus = activeConsignStatus==='All' || status===activeConsignStatus;
      const matchesHouse = houseFilter==='All' || it.consignHouse===houseFilter;
      const hay = [it.name, it.consignHouse, it.consignLot].filter(Boolean).join(' ').toLowerCase();
      const matchesSearch = !q || hay.includes(q);
      return matchesStatus && matchesHouse && matchesSearch;
    });
    filtered.sort((a,b)=>{
      if(sortMode==='newest') return (a.consignSaleDate||'').localeCompare(b.consignSaleDate||'');
      if(sortMode==='oldest') return (b.consignSaleDate||'').localeCompare(a.consignSaleDate||'');
      const aUsd = convertToUSD(num(a.consignEstHigh), a.consignCurrency||'USD');
      const bUsd = convertToUSD(num(b.consignEstHigh), b.consignCurrency||'USD');
      if(sortMode==='high') return bUsd - aUsd;
      if(sortMode==='low') return aUsd - bUsd;
      return 0;
    });
    box.innerHTML = '';
    if(filtered.length === 0){
      const empty = document.createElement('div'); empty.className = 'empty';
      empty.textContent = all.length===0 ? 'Nothing consigned yet. Send an item from your collection above.' : 'No consignments match your filters.';
      box.appendChild(empty);
      return;
    }
    const groups = new Map();
    filtered.forEach(it=>{
      const key = (it.consignHouse && it.consignHouse.trim()) ? it.consignHouse.trim() : 'No auction house set';
      if(!groups.has(key)) groups.set(key, []);
      groups.get(key).push(it);
    });
    const houseNames = [...groups.keys()].sort((a,b)=> a.localeCompare(b));
    houseNames.forEach(houseName=>{
      const group = groups.get(houseName);
      const header = document.createElement('div');
      header.className = 'consign-group-header';
      const summaryParts = consignGroupSummary(group);
      header.innerHTML = `
        <span class="consign-group-name">${escapeHtml(houseName)}</span>
        <span class="consign-group-count">${group.length} item${group.length===1?'':'s'}</span>
        ${summaryParts.length ? `<span class="consign-group-summary">${summaryParts.map(escapeHtml).join(' &middot; ')}</span>` : ''}
      `;
      box.appendChild(header);
      group.forEach(it=> box.appendChild(consignViewMode==='gallery' ? buildConsignCard(it) : buildConsignRow(it)));
    });
  }

  document.getElementById('addConsignBtn').addEventListener('click', ()=>{
    const sel = document.getElementById('cnItemSelect');
    const itemId = parseFloat(sel.value);
    if(!itemId){ sel.focus(); return; }
    const it = items.find(x=>x.id===itemId);
    if(!it) return;
    const house = document.getElementById('cnHouse').value.trim();
    const lot = document.getElementById('cnLot').value.trim();
    const saleDate = document.getElementById('cnSaleDate').value || new Date().toISOString().slice(0,10);
    const isBuyNow = addFormListingType === 'buyNow';
    const priceVal = parseFloat(document.getElementById('cnEstLow').value) || 0;
    it.consignEstLow = priceVal;
    it.consignEstHigh = isBuyNow ? priceVal : (parseFloat(document.getElementById('cnEstHigh').value) || 0);
    it.consignCurrency = document.getElementById('cnCurrency').value;
    it.consignSaleStatus = document.getElementById('cnStatus').value;
    it.consignCurrentLoc = document.getElementById('cnCurrentLoc').value.trim();
    it.consignSoldPrice = parseFloat(document.getElementById('cnSoldPrice').value) || 0;
    it.consignNote = document.getElementById('cnNote').value.trim();
    it.consignHouse = house;
    it.consignLot = lot;
    it.consignSaleDate = saleDate;
    it.consignListingType = addFormListingType;
    it.itemStatus = 'consigned';
    saveItems();
    updateHouseSuggestions();
    renderConsignHouseFilter();
    populateConsignItemSelect();
    sel.value=''; document.getElementById('cnLot').value=''; document.getElementById('cnEstLow').value='';
    document.getElementById('cnEstHigh').value=''; document.getElementById('cnSoldPrice').value=''; document.getElementById('cnNote').value='';
    document.getElementById('cnCurrentLoc').value='';
    document.getElementById('cnStatus').value = 'listed';
    renderConsignments();
  });
  document.getElementById('consignSearch').addEventListener('input', renderConsignments);
  document.getElementById('consignHouseFilter').addEventListener('change', renderConsignments);
  document.getElementById('consignSort').addEventListener('change', renderConsignments);

  /* ================= LOANS (out to museums / exhibitions, sourced from Collection items) ================= */
  let activeLoanStatus = 'All';
  const LOAN_STATUS_LABELS = { onloan: 'On loan', returned: 'Returned' };
  document.getElementById('lnLoanDate').value = new Date().toISOString().slice(0,10);

  function populateLoanItemSelect(){
    const sel = document.getElementById('lnItemSelect');
    const current = sel.value;
    sel.innerHTML = '<option value="">Select an item to loan out\u2026</option>' +
      sendableItems().map(it=>`<option value="${it.id}">${escapeHtml(it.name)}</option>`).join('');
    if([...sel.options].some(o=>o.value===current)) sel.value = current;
  }

  function updateBorrowerSuggestions(){
    const dl = document.getElementById('borrowerSuggestions');
    const unique = uniqueCaseInsensitive(items.map(it=>it.loanBorrower).filter(Boolean));
    dl.innerHTML = unique.map(s=>`<option value="${escapeHtml(s)}">`).join('');
  }

  function loanStatusOf(it){
    return it.loanReturnedDate ? 'returned' : 'onloan';
  }
  function loanedItems(){
    return items.filter(it => it.itemStatus === 'loaned');
  }

  function renderLoanStatusChips(){
    const box = document.getElementById('loanStatusChips');
    const opts = ['All','onloan','returned'];
    box.innerHTML = '';
    opts.forEach(s=>{
      const el = document.createElement('div');
      el.className = 'chip' + (s===activeLoanStatus ? ' active' : '');
      el.textContent = s==='All' ? 'All' : LOAN_STATUS_LABELS[s];
      el.onclick = ()=>{ activeLoanStatus = s; renderLoanStatusChips(); renderLoans(); };
      box.appendChild(el);
    });
  }

  function renderLoanStats(){
    const box = document.getElementById('loanStatCards');
    const all = loanedItems();
    const onLoan = all.filter(it=>loanStatusOf(it)==='onloan');
    const returned = all.filter(it=>loanStatusOf(it)==='returned');
    const overdue = onLoan.filter(it=> it.loanReturnDate && it.loanReturnDate < new Date().toISOString().slice(0,10));
    box.innerHTML = `
      <div class="ccard"><div class="num">${onLoan.length}</div><div class="lbl">Currently on loan</div></div>
      <div class="ccard divider"><div class="num">${returned.length}</div><div class="lbl">Returned</div></div>
      <div class="ccard"><div class="num small ${overdue.length ? 'owe' : ''}">${overdue.length}</div><div class="lbl">Overdue return</div></div>
    `;
  }

  function returnLoanToCollection(it){
    it.itemStatus = 'collection';
    saveItems();
    populateLoanItemSelect();
    renderLoans();
  }

  let editingLoanId = null;

  function buildLoanCard(it){
    if(it.id === editingLoanId) return buildLoanInlineEditCard(it);
    const status = loanStatusOf(it);
    const card = document.createElement('div');
    card.className = 'consign-card status-' + status;
    const isOverdue = status==='onloan' && it.loanReturnDate && it.loanReturnDate < new Date().toISOString().slice(0,10);
    card.innerHTML = `
      <div class="consign-top">
        <div>
          <div class="consign-name">${escapeHtml(it.name)}</div>
          <div class="consign-house">${escapeHtml(it.loanBorrower||'\u2014')}</div>
        </div>
        <span class="status-badge status-${status==='onloan'?'onloan':'returned'}">${LOAN_STATUS_LABELS[status]}</span>
      </div>
      <div class="consign-meta"><span>Loaned: ${fmtDate(it.loanDate)}</span></div>
      <div class="consign-meta"><span class="${isOverdue?'owe':''}">${status==='returned' ? 'Returned: '+fmtDate(it.loanReturnedDate) : (it.loanReturnDate ? 'Expected back: '+fmtDate(it.loanReturnDate)+(isOverdue?' (overdue)':'') : 'No return date set')}</span></div>
      ${it.loanNote ? `<div class="consign-note">${escapeHtml(it.loanNote)}</div>` : ''}
      <div class="consign-actions">
        <button class="icon-btn verify" style="color:var(--profit-pos);border-color:var(--profit-pos);">Return to collection</button>
        <button class="icon-btn edit">Edit</button>
      </div>
    `;
    card.querySelector('.verify').addEventListener('click', ()=> returnLoanToCollection(it));
    card.querySelector('.edit').addEventListener('click', ()=>{ editingLoanId = it.id; renderLoans(); });
    return card;
  }

  function buildLoanInlineEditCard(it){
    const card = document.createElement('div');
    card.className = 'consign-card edit-row';
    card.innerHTML = `
      <div class="form-grid-2">
        <div class="field"><label>Item</label><input type="text" class="le-name" value="${escapeHtml(it.name)}"></div>
        <div class="field"><label>Borrower / exhibition</label><input type="text" class="le-borrower" list="borrowerSuggestions" value="${escapeHtml(it.loanBorrower||'')}"></div>
        <div class="field"><label>Loan date</label><input type="date" class="le-loandate" value="${it.loanDate||''}"></div>
        <div class="field"><label>Expected return</label><input type="date" class="le-returndate" value="${it.loanReturnDate||''}"></div>
      </div>
      <div class="form-grid-2">
        <div class="field"><label>Returned on (leave blank if still out)</label><input type="date" class="le-returneddate" value="${it.loanReturnedDate||''}"></div>
        <div class="field"><label>Note</label><input type="text" class="le-note" value="${escapeHtml(it.loanNote||'')}"></div>
      </div>
      <div class="edit-actions">
        <button class="btn-cancel">Cancel</button>
        <button class="btn-save">Save changes</button>
      </div>
    `;
    card.querySelector('.btn-cancel').onclick = ()=>{ editingLoanId = null; renderLoans(); };
    card.querySelector('.btn-save').onclick = ()=>{
      it.name = card.querySelector('.le-name').value.trim() || it.name;
      it.loanBorrower = card.querySelector('.le-borrower').value.trim();
      it.loanDate = card.querySelector('.le-loandate').value || it.loanDate;
      it.loanReturnDate = card.querySelector('.le-returndate').value;
      it.loanReturnedDate = card.querySelector('.le-returneddate').value;
      it.loanNote = card.querySelector('.le-note').value.trim();
      editingLoanId = null;
      saveItems();
      updateBorrowerSuggestions();
      renderLoans();
    };
    return card;
  }

  function buildLoanRow(it){
    if(it.id === editingLoanId) return buildLoanInlineEditCard(it);
    const status = loanStatusOf(it);
    const isOverdue = status==='onloan' && it.loanReturnDate && it.loanReturnDate < new Date().toISOString().slice(0,10);
    const row = document.createElement('div');
    row.className = 'row consign-row';
    const statusColor = status==='returned' ? 'var(--profit-pos)' : (isOverdue ? 'var(--danger)' : '#dcc07a');
    row.innerHTML = `
      <div class="tab" style="background:${statusColor}"></div>
      <div class="col-name">
        <div class="item-name">${escapeHtml(it.name)}</div>
        <div class="item-sub">${escapeHtml(it.loanBorrower||'\u2014')}</div>
      </div>
      <div><span class="status-badge status-${status==='onloan'?'onloan':'returned'}">${LOAN_STATUS_LABELS[status]}</span></div>
      <div class="col-price price"><span class="price-num ${isOverdue?'owe':''}">${status==='returned' ? 'Returned '+fmtDate(it.loanReturnedDate) : (it.loanReturnDate ? fmtDate(it.loanReturnDate)+(isOverdue?' (overdue)':'') : '\u2014')}</span></div>
      <div class="consign-loc">${fmtDate(it.loanDate)}</div>
      <div class="date"></div>
      <div class="row-actions">
        <button class="icon-btn verify" style="color:var(--profit-pos);border-color:var(--profit-pos);" title="Return to collection">\u21A9</button>
        <button class="icon-btn edit">Edit</button>
      </div>
    `;
    row.querySelector('.verify').addEventListener('click', ()=> returnLoanToCollection(it));
    row.querySelector('.edit').addEventListener('click', ()=>{ editingLoanId = it.id; renderLoans(); });
    return row;
  }

  const LOAN_VIEW_KEY = 'rackLedgerLoanView_v1';
  let loanViewMode = 'gallery';
  try{ loanViewMode = localStorage.getItem(LOAN_VIEW_KEY) || 'gallery'; }catch(e){}
  function syncLoanViewButtons(){
    document.querySelectorAll('.loan-vt-btn').forEach(b=> b.classList.toggle('active', b.dataset.view===loanViewMode));
  }
  document.querySelectorAll('.loan-vt-btn').forEach(b=>{
    b.addEventListener('click', ()=>{
      loanViewMode = b.dataset.view;
      try{ localStorage.setItem(LOAN_VIEW_KEY, loanViewMode); }catch(e){}
      syncLoanViewButtons();
      renderLoans();
    });
  });

  function renderLoans(){
    renderLoanStats();
    const box = document.getElementById('loanCards');
    box.className = loanViewMode==='gallery' ? 'consign-grid' : 'list-view';
    box.innerHTML = '';
    const all = loanedItems();
    const filtered = all.filter(it=> activeLoanStatus==='All' || loanStatusOf(it)===activeLoanStatus);
    if(filtered.length === 0){
      const empty = document.createElement('div'); empty.className = 'empty';
      empty.textContent = all.length===0 ? 'Nothing on loan yet. Send an item from your collection above.' : 'No loans match this filter.';
      box.appendChild(empty);
      return;
    }
    const sorted = [...filtered].sort((a,b)=> (b.loanDate||'').localeCompare(a.loanDate||''));
    sorted.forEach(it=> box.appendChild(loanViewMode==='gallery' ? buildLoanCard(it) : buildLoanRow(it)));
  }

  document.getElementById('addLoanBtn').addEventListener('click', ()=>{
    const sel = document.getElementById('lnItemSelect');
    const itemId = parseFloat(sel.value);
    if(!itemId){ sel.focus(); return; }
    const it = items.find(x=>x.id===itemId);
    if(!it) return;
    it.loanBorrower = document.getElementById('lnBorrower').value.trim();
    it.loanDate = document.getElementById('lnLoanDate').value || new Date().toISOString().slice(0,10);
    it.loanReturnDate = document.getElementById('lnReturnDate').value;
    it.loanReturnedDate = '';
    it.loanNote = document.getElementById('lnNote').value.trim();
    it.itemStatus = 'loaned';
    saveItems();
    updateBorrowerSuggestions();
    populateLoanItemSelect();
    sel.value=''; document.getElementById('lnReturnDate').value=''; document.getElementById('lnNote').value='';
    renderLoans();
  });

  /* ================= OVERVIEW (dashboard) ================= */
  function renderOverview(){
    // Financial header: dominant total value (sold items excluded — no longer part of the active collection)
    const activeItems = items.filter(it => it.itemStatus !== 'sold');
    const totalUSD = activeItems.reduce((s,it)=> s + convertToUSD(num(it.price), it.currency||'USD'), 0);
    animateNumber(document.getElementById('ovTotalValue'), totalUSD, v=>fmtMoney(v,'USD'), 700);
    const nativeSums = {USD:0, EUR:0, GBP:0};
    activeItems.forEach(it=>{ const c=CURRENCIES.includes(it.currency)?it.currency:'USD'; nativeSums[c]+=num(it.price); });
    const breakdownParts = CURRENCIES.filter(c=>nativeSums[c]>0.004).map(c=> `${c} ${fmtMoney(nativeSums[c],c)}`);
    document.getElementById('ovCurrencyBreakdown').textContent = breakdownParts.length ? breakdownParts.join('   \u00B7   ') : '\u2014';

    // Flat collection-status row
    const unverified = activeItems.filter(it=>!it.verifiedDate).length;
    const onLoanCount = loanedItems().filter(it=>loanStatusOf(it)==='onloan').length;
    const consignedCount = consignedItems().length;
    let ledgerOwedTotal = 0;
    contacts.forEach(c=>{
      contactBalances(c.id).forEach(b=>{ if(b.owed) ledgerOwedTotal += convertToUSD(b.amount, b.currency); });
    });
    const statusRow = document.getElementById('ovStatusRow');
    const statusItems = [
      { id:'ovStatObjects', val: activeItems.length, warn:false, lbl:'Objects', isMoney:false },
      { id:'ovStatUnverified', val: unverified, warn: unverified>0, lbl:'Unverified', isMoney:false },
      { id:'ovStatOnLoan', val: onLoanCount, warn: onLoanCount>0, lbl:'On loan', isMoney:false },
      { id:'ovStatConsigned', val: consignedCount, warn: consignedCount>0, lbl:'Consigned', isMoney:false },
      { id:'ovStatLedger', val: ledgerOwedTotal, warn: ledgerOwedTotal>0.01, lbl:'Ledger owed', isMoney:true }
    ];
    if(!statusRow.dataset.built){
      statusRow.innerHTML = statusItems.map(s=>`
        <div class="ov-status-item"><div class="ov-status-val" id="${s.id}">0</div><div class="ov-status-lbl">${s.lbl}</div></div>
      `).join('');
      statusRow.dataset.built = '1';
    }
    statusItems.forEach(s=>{
      const el = document.getElementById(s.id);
      el.classList.toggle('warn', s.warn);
      animateNumber(el, s.val, s.isMoney ? (v=>fmtMoney(v,'USD')) : (v=>Math.round(v).toLocaleString()), 500);
    });

    // Most valuable
    const top = [...activeItems].sort((a,b)=> convertToUSD(num(b.price),b.currency||'USD') - convertToUSD(num(a.price),a.currency||'USD')).slice(0,5);
    const topBox = document.getElementById('ovTopPieces');
    topBox.innerHTML = top.length===0 ? `<div class="empty">No items logged yet.</div>` : top.map(it=>`
      <div class="ov-list-row">
        <div><div class="ov-list-name">${escapeHtml(it.name)}</div><div class="ov-list-sub">${escapeHtml(it.type)}</div></div>
        <div class="ov-list-val">${fmtMoney(num(it.price), it.currency)}</div>
      </div>
    `).join('');

    // Recently added
    const recent = [...items].sort((a,b)=> b.id - a.id).slice(0,5);
    const recentBox = document.getElementById('ovRecent');
    recentBox.innerHTML = recent.length===0 ? `<div class="empty">No items logged yet.</div>` : recent.map(it=>`
      <div class="ov-list-row">
        <div><div class="ov-list-name">${escapeHtml(it.name)}</div><div class="ov-list-sub">${fmtDate(it.date)}</div></div>
        <div class="ov-list-val">${fmtMoney(num(it.price), it.currency)}</div>
      </div>
    `).join('');

    // Upcoming consignment sales
    const upcoming = consignedItems().filter(it=>(it.consignSaleStatus||'listed')==='listed' && it.consignSaleDate).sort((a,b)=> a.consignSaleDate.localeCompare(b.consignSaleDate)).slice(0,5);
    const upBox = document.getElementById('ovUpcomingSales');
    upBox.innerHTML = upcoming.length===0 ? `<div class="empty">No upcoming sales.</div>` : upcoming.map(it=>`
      <div class="ov-list-row">
        <div><div class="ov-list-name">${escapeHtml(it.name)}</div><div class="ov-list-sub">${escapeHtml(it.consignHouse||'\u2014')} \u00B7 ${fmtDate(it.consignSaleDate)}</div></div>
        <div class="ov-list-val">${consignPriceText(it)}</div>
      </div>
    `).join('');

    // Ledger balances
    const ledgerBox = document.getElementById('ovLedgerBalances');
    if(contacts.length===0){
      ledgerBox.innerHTML = `<div class="empty">No people tracked yet.</div>`;
    } else {
      ledgerBox.innerHTML = contacts.map(c=>{
        const balances = contactBalances(c.id);
        const text = balances.length===0 ? 'Settled up' : balances.map(b=> `${fmtMoney(Math.abs(b.amount), b.currency)} ${b.owed?'owed':'ahead'}`).join(', ');
        return `
          <div class="ov-list-row">
            <div class="ov-list-name">${escapeHtml(c.name)}</div>
            <div class="ov-list-val" style="${balances.some(b=>b.owed) ? 'color:var(--danger);' : 'color:var(--profit-pos);'}">${text}</div>
          </div>
        `;
      }).join('');
    }
  }

  /* ================= BACKUP REMINDER ================= */
  const LAST_BACKUP_KEY = 'rackLedgerLastBackup_v1';
  function checkBackupReminder(){
    const notice = document.getElementById('backupNotice');
    if(items.length === 0){ notice.classList.remove('show'); return; }
    let lastBackup = null;
    try{ lastBackup = localStorage.getItem(LAST_BACKUP_KEY); }catch(e){}
    const daysSince = lastBackup ? Math.floor((Date.now() - new Date(lastBackup).getTime()) / 86400000) : null;
    if(daysSince === null){
      notice.textContent = '\u26A0 You haven\'t backed up your collection yet. Your data lives only in this browser \u2014 use "Backup (JSON)" in the Collection tab to keep a copy somewhere safe.';
      notice.classList.add('show');
    } else if(daysSince > 30){
      notice.textContent = `\u26A0 Your last backup was ${daysSince} days ago. Consider downloading a fresh "Backup (JSON)" from the Collection tab.`;
      notice.classList.add('show');
    } else {
      notice.classList.remove('show');
    }
  }
  function markBackedUp(){
    try{ localStorage.setItem(LAST_BACKUP_KEY, new Date().toISOString()); }catch(e){}
  }

  /* ================= AUTO-SAVE TO LOCAL FILE (File System Access API) ================= */
  const AUTOSAVE_DB_NAME = 'artefaktAutosave';
  const AUTOSAVE_DB_STORE = 'handles';
  const AUTOSAVE_DB_KEY = 'backupFile';
  const autosaveSupported = (typeof window.showSaveFilePicker === 'function');
  let autosaveHandle = null;
  let autosaveDebounceTimer = null;

  function idbOpen(){
    return new Promise((resolve, reject)=>{
      const req = indexedDB.open(AUTOSAVE_DB_NAME, 1);
      req.onupgradeneeded = ()=>{ req.result.createObjectStore(AUTOSAVE_DB_STORE); };
      req.onsuccess = ()=> resolve(req.result);
      req.onerror = ()=> reject(req.error);
    });
  }
  async function idbSetHandle(handle){
    const db = await idbOpen();
    return new Promise((resolve, reject)=>{
      const tx = db.transaction(AUTOSAVE_DB_STORE, 'readwrite');
      tx.objectStore(AUTOSAVE_DB_STORE).put(handle, AUTOSAVE_DB_KEY);
      tx.oncomplete = ()=> resolve();
      tx.onerror = ()=> reject(tx.error);
    });
  }
  async function idbGetHandle(){
    const db = await idbOpen();
    return new Promise((resolve, reject)=>{
      const tx = db.transaction(AUTOSAVE_DB_STORE, 'readonly');
      const req = tx.objectStore(AUTOSAVE_DB_STORE).get(AUTOSAVE_DB_KEY);
      req.onsuccess = ()=> resolve(req.result || null);
      req.onerror = ()=> reject(req.error);
    });
  }
  async function idbClearHandle(){
    const db = await idbOpen();
    return new Promise((resolve, reject)=>{
      const tx = db.transaction(AUTOSAVE_DB_STORE, 'readwrite');
      tx.objectStore(AUTOSAVE_DB_STORE).delete(AUTOSAVE_DB_KEY);
      tx.oncomplete = ()=> resolve();
      tx.onerror = ()=> reject(tx.error);
    });
  }

  function setAutosaveStatus(text, tone){
    const el = document.getElementById('autosaveStatus');
    if(!el) return;
    el.textContent = text;
    el.style.color = tone === 'ok' ? 'var(--accent)' : (tone === 'err' ? 'var(--danger)' : 'var(--ink-muted)');
  }

  function updateAutosaveButtons(state){
    const connectBtn = document.getElementById('autosaveConnectBtn');
    const disconnectBtn = document.getElementById('autosaveDisconnectBtn');
    if(!connectBtn || !disconnectBtn) return;
    if(state === 'unsupported'){
      connectBtn.style.display = 'none';
      disconnectBtn.style.display = 'none';
    } else if(state === 'connected'){
      connectBtn.style.display = 'none';
      disconnectBtn.style.display = 'inline-block';
    } else if(state === 'needs-permission'){
      connectBtn.textContent = 'Reconnect backup file';
      connectBtn.style.display = 'inline-block';
      disconnectBtn.style.display = 'inline-block';
    } else {
      connectBtn.textContent = 'Connect backup file';
      connectBtn.style.display = 'inline-block';
      disconnectBtn.style.display = 'none';
    }
  }

  async function writeAutosaveFile(){
    if(!autosaveHandle) return;
    try{
      const perm = await autosaveHandle.queryPermission({ mode: 'readwrite' });
      if(perm !== 'granted'){
        updateAutosaveButtons('needs-permission');
        setAutosaveStatus('\u26A0 Backup file needs permission again \u2014 click "Reconnect backup file".', 'err');
        return;
      }
      const writable = await autosaveHandle.createWritable();
      await writable.write(JSON.stringify(buildFullBackupObject(), null, 2));
      await writable.close();
      const now = new Date();
      setAutosaveStatus(`\u2713 Auto-saved to "${autosaveHandle.name}" at ${now.toLocaleTimeString()}`, 'ok');
      markBackedUp();
    }catch(e){
      setAutosaveStatus('\u26A0 Auto-save failed: ' + (e && e.message ? e.message : 'unknown error') + '. Your data is still safe in this browser \u2014 try reconnecting the backup file.', 'err');
    }
  }

  function scheduleAutosave(){
    if(!autosaveHandle) return;
    clearTimeout(autosaveDebounceTimer);
    autosaveDebounceTimer = setTimeout(writeAutosaveFile, 800);
  }

  async function connectAutosaveFile(){
    try{
      const handle = await window.showSaveFilePicker({
        suggestedName: 'artefakt-backup.json',
        types: [{ description: 'JSON backup', accept: { 'application/json': ['.json'] } }]
      });
      autosaveHandle = handle;
      await idbSetHandle(handle);
      updateAutosaveButtons('connected');
      await writeAutosaveFile();
    }catch(e){
      if(e && e.name === 'AbortError') return;
      setAutosaveStatus('\u26A0 Could not connect backup file: ' + (e && e.message ? e.message : 'unknown error'), 'err');
    }
  }

  async function disconnectAutosaveFile(){
    autosaveHandle = null;
    try{ await idbClearHandle(); }catch(e){}
    updateAutosaveButtons('disconnected');
    setAutosaveStatus('Auto-save disconnected. Your manual "Export full backup" still works as before.', null);
  }

  async function initAutosave(){
    if(!autosaveSupported){
      updateAutosaveButtons('unsupported');
      setAutosaveStatus('Auto-save to a local file needs Chrome or Edge on desktop. On this browser, keep using "Export full backup" regularly.', null);
      return;
    }
    let stored = null;
    try{ stored = await idbGetHandle(); }catch(e){}
    if(!stored){
      updateAutosaveButtons('disconnected');
      setAutosaveStatus('Not connected. Connect a file once and every change auto-saves to it.', null);
      return;
    }
    try{
      const perm = await stored.queryPermission({ mode: 'readwrite' });
      if(perm === 'granted'){
        autosaveHandle = stored;
        updateAutosaveButtons('connected');
        setAutosaveStatus(`\u2713 Auto-saving to "${stored.name}"`, 'ok');
      } else {
        autosaveHandle = stored;
        updateAutosaveButtons('needs-permission');
        setAutosaveStatus(`Backup file "${stored.name}" found \u2014 click "Reconnect backup file" to resume auto-saving.`, null);
      }
    }catch(e){
      updateAutosaveButtons('disconnected');
      setAutosaveStatus('Previous backup file connection could not be restored. Connect again.', null);
    }
  }

  document.getElementById('autosaveConnectBtn').addEventListener('click', async ()=>{
    if(autosaveHandle){
      try{
        const perm = await autosaveHandle.requestPermission({ mode: 'readwrite' });
        if(perm === 'granted'){
          updateAutosaveButtons('connected');
          await writeAutosaveFile();
          return;
        }
      }catch(e){}
    }
    connectAutosaveFile();
  });
  document.getElementById('autosaveDisconnectBtn').addEventListener('click', disconnectAutosaveFile);

  /* ================= GOOGLE DRIVE SYNC ================= */
  const DRIVE_SCOPE = 'https://www.googleapis.com/auth/drive.file';
  const DRIVE_FILE_NAME = 'artefakt-backup.json';
  const DRIVE_FILE_ID_KEY = 'artefaktDriveFileId';
  const DRIVE_LAST_SYNC_KEY = 'artefaktDriveLastSyncedModifiedTime';
  let driveAccessToken = null;
  let driveTokenClient = null;
  let driveFileId = null;
  let driveDebounceTimer = null;
  let driveConnected = false;

  function setDriveStatus(text, tone){
    const el = document.getElementById('driveSyncStatus');
    if(!el) return;
    el.textContent = text;
    el.style.color = tone === 'ok' ? 'var(--accent)' : (tone === 'err' ? 'var(--danger)' : 'var(--ink-muted)');
  }
  function updateDriveButtons(state){
    const connectBtn = document.getElementById('driveConnectBtn');
    const disconnectBtn = document.getElementById('driveDisconnectBtn');
    if(!connectBtn || !disconnectBtn) return;
    if(state === 'connected'){
      connectBtn.style.display = 'none';
      disconnectBtn.style.display = 'inline-block';
    } else {
      connectBtn.textContent = 'Connect Google Drive';
      connectBtn.style.display = 'inline-block';
      disconnectBtn.style.display = 'none';
    }
  }
  function hideDriveConflictBanner(){
    document.getElementById('driveConflictBanner').style.display = 'none';
  }
  function showDriveConflictBanner(modifiedTime){
    const banner = document.getElementById('driveConflictBanner');
    const text = document.getElementById('driveConflictText');
    text.textContent = `A newer backup was found on Google Drive, saved ${new Date(modifiedTime).toLocaleString()} \u2014 probably from another device. Load it, or keep what's open here (this device will overwrite Drive on your next change).`;
    banner.style.display = 'block';
  }

  function getDriveTokenClient(){
    if(!window.google || !google.accounts || !google.accounts.oauth2){
      throw new Error('Google sign-in script has not loaded yet. Wait a moment and try again.');
    }
    if(GOOGLE_CLIENT_ID.indexOf('YOUR_CLIENT_ID') === 0){
      throw new Error('Google Drive sync needs a Client ID configured in the code first (see setup guide).');
    }
    if(!driveTokenClient){
      driveTokenClient = google.accounts.oauth2.initTokenClient({
        client_id: GOOGLE_CLIENT_ID,
        scope: DRIVE_SCOPE,
        callback: () => {} // overwritten per-request below
      });
    }
    return driveTokenClient;
  }

  function requestDriveToken(promptMode){
    return new Promise((resolve, reject)=>{
      let client;
      try{ client = getDriveTokenClient(); }catch(e){ reject(e); return; }
      client.callback = (resp)=>{
        if(resp && resp.error){ reject(new Error(resp.error)); return; }
        driveAccessToken = resp.access_token;
        resolve(resp.access_token);
      };
      client.requestAccessToken({ prompt: promptMode === undefined ? '' : promptMode });
    });
  }

  function driveHeaders(extra){
    return Object.assign({ 'Authorization': 'Bearer ' + driveAccessToken }, extra || {});
  }

  async function driveApiFetch(url, options){
    const res = await fetch(url, options);
    if(res.status === 401){
      const err = new Error('Google Drive session expired');
      err.code = 401;
      throw err;
    }
    if(!res.ok){
      const body = await res.text().catch(()=> '');
      throw new Error(`Drive API error ${res.status}: ${body.slice(0,200)}`);
    }
    return res;
  }

  async function driveFindExistingFile(){
    const q = encodeURIComponent(`name='${DRIVE_FILE_NAME}' and trashed=false`);
    const res = await driveApiFetch(`https://www.googleapis.com/drive/v3/files?q=${q}&fields=files(id,name,modifiedTime)&spaces=drive`, { headers: driveHeaders() });
    const data = await res.json();
    return (data.files && data.files[0]) || null;
  }

  async function driveCreateFile(content){
    const boundary = 'artefakt_boundary_' + Date.now();
    const metadata = { name: DRIVE_FILE_NAME, mimeType: 'application/json' };
    const body =
      `--${boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n${JSON.stringify(metadata)}\r\n` +
      `--${boundary}\r\nContent-Type: application/json\r\n\r\n${content}\r\n` +
      `--${boundary}--`;
    const res = await driveApiFetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,modifiedTime', {
      method: 'POST',
      headers: driveHeaders({ 'Content-Type': `multipart/related; boundary=${boundary}` }),
      body
    });
    return res.json();
  }

  async function driveUploadContent(fileId, content){
    const res = await driveApiFetch(`https://www.googleapis.com/upload/drive/v3/files/${fileId}?uploadType=media&fields=id,modifiedTime`, {
      method: 'PATCH',
      headers: driveHeaders({ 'Content-Type': 'application/json' }),
      body: content
    });
    return res.json();
  }

  async function driveGetFileMeta(fileId){
    const res = await driveApiFetch(`https://www.googleapis.com/drive/v3/files/${fileId}?fields=id,name,modifiedTime`, { headers: driveHeaders() });
    return res.json();
  }

  async function driveGetFileContent(fileId){
    const res = await driveApiFetch(`https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`, { headers: driveHeaders() });
    return res.json();
  }

  async function writeDriveBackup(){
    if(!driveConnected) return;
    try{
      const content = JSON.stringify(buildFullBackupObject(), null, 2);
      let meta;
      if(!driveFileId){
        meta = await driveCreateFile(content);
        driveFileId = meta.id;
        try{ localStorage.setItem(DRIVE_FILE_ID_KEY, driveFileId); }catch(e){}
      } else {
        meta = await driveUploadContent(driveFileId, content);
      }
      try{ localStorage.setItem(DRIVE_LAST_SYNC_KEY, meta.modifiedTime); }catch(e){}
      setDriveStatus(`\u2713 Synced to Google Drive at ${new Date().toLocaleTimeString()}`, 'ok');
      markBackedUp();
    }catch(e){
      if(e.code === 401){
        setDriveStatus('\u26A0 Google Drive session expired \u2014 click "Connect Google Drive" again to resume.', 'err');
        driveConnected = false;
        updateDriveButtons('disconnected');
      } else {
        setDriveStatus('\u26A0 Drive sync failed: ' + e.message, 'err');
      }
    }
  }

  function scheduleDriveSync(){
    if(!driveConnected) return;
    clearTimeout(driveDebounceTimer);
    driveDebounceTimer = setTimeout(writeDriveBackup, 1000);
  }

  async function checkDriveForNewerVersion(){
    if(!driveFileId) return;
    try{
      const meta = await driveGetFileMeta(driveFileId);
      let lastKnown = null;
      try{ lastKnown = localStorage.getItem(DRIVE_LAST_SYNC_KEY); }catch(e){}
      const remoteTime = new Date(meta.modifiedTime).getTime();
      const knownTime = lastKnown ? new Date(lastKnown).getTime() : 0;
      if(remoteTime > knownTime + 5000){
        showDriveConflictBanner(meta.modifiedTime);
      }
    }catch(e){ /* non-fatal — just skip the conflict check */ }
  }

  async function loadFromDrive(){
    if(!driveFileId) return;
    try{
      setDriveStatus('Loading latest version from Google Drive\u2026', null);
      const parsed = await driveGetFileContent(driveFileId);
      const result = applyFullBackupData(parsed);
      if(!result.ok){
        setDriveStatus('\u26A0 The Drive backup failed validation: ' + result.error, 'err');
        return;
      }
      const meta = await driveGetFileMeta(driveFileId);
      try{ localStorage.setItem(DRIVE_LAST_SYNC_KEY, meta.modifiedTime); }catch(e){}
      hideDriveConflictBanner();
      setDriveStatus(`\u2713 Loaded from Google Drive \u2014 ${result.itemsCount} item(s).`, 'ok');
    }catch(e){
      setDriveStatus('\u26A0 Could not load from Drive: ' + e.message, 'err');
    }
  }

  async function connectGoogleDrive(){
    try{
      setDriveStatus('Opening Google sign-in\u2026', null);
      await requestDriveToken('consent');
      let stored = null;
      try{ stored = localStorage.getItem(DRIVE_FILE_ID_KEY); }catch(e){}
      if(stored){
        driveFileId = stored;
      } else {
        const existing = await driveFindExistingFile();
        if(existing){
          driveFileId = existing.id;
          try{ localStorage.setItem(DRIVE_FILE_ID_KEY, driveFileId); }catch(e){}
        }
      }
      driveConnected = true;
      updateDriveButtons('connected');
      if(driveFileId){
        await checkDriveForNewerVersion();
        if(document.getElementById('driveConflictBanner').style.display !== 'block'){
          setDriveStatus('\u2713 Connected to Google Drive.', 'ok');
        }
      } else {
        await writeDriveBackup();
      }
    }catch(e){
      setDriveStatus('\u26A0 Could not connect: ' + e.message, 'err');
    }
  }

  function disconnectGoogleDrive(){
    const tokenToRevoke = driveAccessToken;
    driveConnected = false;
    driveAccessToken = null;
    updateDriveButtons('disconnected');
    hideDriveConflictBanner();
    setDriveStatus('Disconnected. Auto-sync to Google Drive is off; other backup options still work.', null);
    if(window.google && google.accounts && google.accounts.oauth2 && tokenToRevoke){
      google.accounts.oauth2.revoke(tokenToRevoke, ()=>{});
    }
  }

  document.getElementById('driveConnectBtn').addEventListener('click', connectGoogleDrive);
  document.getElementById('driveDisconnectBtn').addEventListener('click', disconnectGoogleDrive);
  document.getElementById('driveConflictLoadBtn').addEventListener('click', loadFromDrive);
  document.getElementById('driveConflictKeepBtn').addEventListener('click', ()=>{
    hideDriveConflictBanner();
    setDriveStatus('Keeping this device\u2019s version. It will overwrite Drive on your next change.', null);
    writeDriveBackup();
  });

  function schedulePersist(){
    scheduleAutosave();
    scheduleDriveSync();
  }

  (function initDriveFileIdFromStorage(){
    try{ driveFileId = localStorage.getItem(DRIVE_FILE_ID_KEY) || null; }catch(e){}
  })();

  async function tryReconnectDriveSilently(){
    let storedFileId = null;
    try{ storedFileId = localStorage.getItem(DRIVE_FILE_ID_KEY); }catch(e){}
    if(!storedFileId) return; // never connected on this device before — nothing to restore
    try{
      await requestDriveToken('');
      driveFileId = storedFileId;
      driveConnected = true;
      updateDriveButtons('connected');
      await checkDriveForNewerVersion();
      if(document.getElementById('driveConflictBanner').style.display !== 'block'){
        setDriveStatus('\u2713 Reconnected to Google Drive.', 'ok');
      }
    }catch(e){
      updateDriveButtons('disconnected');
      setDriveStatus('Previously connected to Google Drive \u2014 click "Connect Google Drive" to resume syncing this session.', null);
    }
  }

  /* ---------- Backup utility modal (global, reuses existing export/import elements) ---------- */
  (function(){
    const trigger = document.getElementById('backupUtilTrigger');
    const overlay = document.getElementById('backupModalOverlay');
    const closeBtn = document.getElementById('backupModalClose');
    function openModal(){ overlay.classList.add('open'); }
    function closeModal(){ overlay.classList.remove('open'); }
    trigger.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e)=>{ if(e.target === overlay) closeModal(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape' && overlay.classList.contains('open')) closeModal(); });
  })();

  /* ---------- init ---------- */
  loadCachedRates();
  syncRateInputs();
  fetchRates();
  populateTypeFilterOptions();
  populateLocationFilterOptions();
  syncViewButtons();
  renderConsignStatusChips();
  syncConsignViewButtons();
  updateHouseSuggestions();
  renderConsignHouseFilter();
  populateConsignItemSelect();
  renderLoanStatusChips();
  syncLoanViewButtons();
  updateBorrowerSuggestions();
  populateLoanItemSelect();
  renderOverview();
  checkBackupReminder();
  initAutosave();
  photoDbLoadAll().then(()=>render());
  setTimeout(tryReconnectDriveSilently, 300);
  render();
</script>
</body>
</html>
