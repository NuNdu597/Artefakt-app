<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Artefakt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0A0B;
    --surface:#151517;
    --surface-2:#1D1D20;
    --line:#333336;
    --ink:#F3F2EE;
    --ink-muted:#96938C;
    --accent:#D4AF62;
    --accent-soft:rgba(212,175,98,0.12);
    --gold:#DCC07A;
    --danger:#E2604C;
    --wishlist:#9585D6;
    --profit-pos:#6FBF73;
    --chrome-1:#FFFFFF;
    --chrome-2:#9A9A9A;
    --r-panel:3px;
    --r-control:4px;
    --r-tag:3px;
    --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px; --sp-5:24px; --sp-6:32px; --sp-7:48px; --sp-8:64px;
  }
  *{box-sizing:border-box;}
  button:focus-visible, input:focus-visible, select:focus-visible, a:focus-visible, [tabindex]:focus-visible{
    outline:1.5px solid var(--accent);outline-offset:1px;
  }
  .field input:focus-visible, .field select:focus-visible,
  .search-field input:focus-visible, .filter-popover select:focus-visible, .sort-select:focus-visible{
    outline:none;
  }
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    min-height:100vh;
    padding:36px 24px 90px;
  }
  .wrap{max-width:1100px;margin:0 auto;}

  header{
    border-bottom:2px solid var(--ink);
    padding-bottom:22px;
    margin-bottom:20px;
  }
  .header-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:16px;
    margin-bottom:22px;
  }
  .brand-block{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:7px;
  }
  .logo-img{
    display:block;
    height:clamp(24px,3.6vw,34px);
    width:auto;
  }
  .tagline{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--ink-muted);
    line-height:1;
    margin:0;
  }
  .item-count{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--ink-muted);
  }

  .currency-cards{display:flex;gap:12px;flex-wrap:wrap;}
  .ccard{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:3px;
    padding:12px 18px;
    min-width:112px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,0.04), 0 4px 14px rgba(0,0,0,0.45);
  }
  .ccard.divider{border-left:1px solid var(--line);margin-left:6px;padding-left:22px;}
  .ccard .num{
    font-family:'IBM Plex Mono', monospace;
    font-size:19px;
    font-weight:600;
    color:var(--gold);
    line-height:1.2;
  }
  .ccard .num.small{font-size:16px;}
  .ccard .lbl{
    font-family:'IBM Plex Mono', monospace;
    font-size:9.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--ink-muted);
    margin-top:3px;
  }

  .goal-section{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:3px;
    padding:22px 24px;
    margin-bottom:20px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,0.05), 0 6px 20px rgba(0,0,0,0.5);
  }
  .goal-top{
    display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:10px;margin-bottom:12px;
  }
  .goal-title{
    font-family:'IBM Plex Mono', monospace;
    font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:var(--ink-muted);
  }
  .goal-pct{
    font-family:'Archivo', sans-serif;
    font-style:normal;
    font-size:30px;
    font-weight:800;
    color:var(--accent);
  }
  .goal-bar-track{
    width:100%;height:10px;background:var(--surface-2);border:1px solid var(--line);border-radius:3px;overflow:hidden;margin-bottom:12px;
    box-shadow:inset 0 1px 4px rgba(0,0,0,0.6);
  }
  .goal-bar-fill{
    height:100%;background:linear-gradient(90deg, var(--accent), var(--gold));border-radius:3px 0 0 3px;transition:width 0.4s ease;
  }
  .goal-bottom{
    display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;
    font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);
  }
  .goal-bottom .link-btn, .ov-goal-bottom .link-btn{
    color:var(--accent);background:none;border:none;text-decoration:underline;cursor:pointer;
    font-family:'IBM Plex Mono', monospace;font-size:11px;padding:0;
  }
  .goal-bottom .link-btn:hover, .ov-goal-bottom .link-btn:hover{color:var(--gold);}
  .rate-inputs{display:inline-flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .goal-edit{display:inline-flex;align-items:center;gap:4px;white-space:nowrap;}
  .goal-edit input{
    width:70px;background:var(--surface-2);border:1px solid var(--line);border-radius:3px;color:var(--ink);
    padding:4px 6px;font-family:'IBM Plex Mono', monospace;font-size:11px;
  }
  #goalInput{width:100px;}
  .goal-settings{
    display:none;flex-wrap:wrap;align-items:center;gap:10px;
    margin-top:16px;padding-top:16px;border-top:1px solid var(--line);
    font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);
  }
  .goal-settings.open{display:flex;}

  .notice{
    background:var(--accent-soft);
    border:1px solid var(--accent);
    border-radius:3px;
    padding:11px 14px;
    font-size:12px;
    color:var(--ink-muted);
    margin-bottom:20px;
    display:none;
  }
  .notice.show{display:block;}

  /* Tabs */
  .tabnav{display:flex;gap:6px;margin-bottom:22px;border-bottom:1px solid var(--line);}
  .tabbtn{
    background:none;border:none;color:var(--ink-muted);
    font-family:'Archivo', sans-serif;font-weight:600;font-size:14px;letter-spacing:0.04em;text-transform:uppercase;
    padding:10px 4px;margin-right:26px;cursor:pointer;border-bottom:2px solid transparent;
  }
  .tabbtn.active{color:var(--ink);border-bottom-color:var(--accent);}
  .tabpane{display:none;}
  .tabpane.active{display:block; opacity:1;}
  @media (prefers-reduced-motion: reduce){
    .tabpane.active{opacity:1!important; transition:none!important;}
    *{animation-duration:0.001ms!important; transition-duration:0.001ms!important;}
  }

  .tabnav-spacer{flex:1;}
  .backup-util-trigger{
    background:none;border:none;border-left:1px solid var(--line);
    color:var(--ink-muted);font-family:'IBM Plex Mono', monospace;font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;
    padding:10px 4px 10px 18px;margin-bottom:1px;cursor:pointer;align-self:flex-start;
  }
  .backup-util-trigger:hover{color:var(--accent);}

  .backup-modal-overlay{
    display:flex;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:100;
    align-items:flex-start;justify-content:center;padding-top:12vh;
    opacity:0;visibility:hidden;pointer-events:none;
    transition:opacity 0.18s ease;
  }
  .backup-modal-overlay.open{opacity:1;visibility:visible;pointer-events:auto;}
  .backup-modal{
    background:var(--surface);border:1px solid var(--line);border-radius:var(--r-panel,3px);
    width:100%;max-width:460px;margin:0 20px;
    transform:translateY(-10px);transition:transform 0.22s ease;
  }
  .backup-modal-overlay.open .backup-modal{transform:translateY(0);}
  .backup-modal-head{
    display:flex;justify-content:space-between;align-items:center;
    padding:16px 18px;border-bottom:1px solid var(--line);
    font-family:'Archivo', sans-serif;font-weight:700;font-size:14px;letter-spacing:0.03em;text-transform:uppercase;color:var(--ink);
  }
  .backup-modal-close{background:none;border:none;color:var(--ink-muted);font-size:18px;line-height:1;cursor:pointer;padding:2px 4px;}
  .backup-modal-close:hover{color:var(--ink);}
  .backup-modal-body{padding:18px;}
  .backup-modal-section{margin-bottom:22px;}
  .backup-modal-section:last-child{margin-bottom:0;}
  .backup-modal-label{
    font-family:'IBM Plex Mono', monospace;font-size:9.5px;letter-spacing:0.14em;text-transform:uppercase;
    color:var(--ink-muted);margin-bottom:8px;
  }
  .backup-modal-note{
    font-family:'IBM Plex Sans', sans-serif;font-size:12px;color:var(--ink-muted);line-height:1.5;margin:0 0 12px;
  }
  .backup-modal-note-inline{font-family:'IBM Plex Mono', monospace;font-size:9.5px;color:var(--ink-muted);}
  .backup-modal-check{
    display:flex;align-items:center;gap:6px;margin-top:10px;
    font-family:'IBM Plex Mono', monospace;font-size:10.5px;color:var(--ink-muted);
  }
  #importStatus{font-family:'IBM Plex Mono', monospace;font-size:11px;margin-top:12px;line-height:1.5;}
  .footer-backup-hint{font-family:'IBM Plex Mono', monospace;font-size:10.5px;color:var(--ink-muted);}

  .panel{
    background:var(--surface);border:1px solid var(--line);border-radius:3px;padding:22px;margin-bottom:22px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,0.04), 0 4px 16px rgba(0,0,0,0.45);
  }
  .panel-label{
    font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;
    color:var(--ink-muted);margin-bottom:16px;
  }
  .form-grid{display:grid;grid-template-columns: 2fr 1fr 1fr;gap:12px;margin-bottom:12px;}
  .form-grid-4{display:grid;grid-template-columns: 1.6fr 1fr 1fr 1fr;gap:12px;margin-bottom:12px;}
  .edit-grid-4{display:grid;grid-template-columns: 1.6fr 1fr 1fr 1fr;gap:10px;margin-bottom:10px;}
  .form-grid-2{display:grid;grid-template-columns: 1fr 1fr 1fr 1fr;gap:12px;margin-bottom:12px;}
  .form-grid-3{display:grid;grid-template-columns: 1fr 1fr 1fr auto;gap:12px;align-items:end;}
  @media(max-width:900px){
    .form-grid, .form-grid-2, .form-grid-3, .form-grid-4, .edit-grid-4{grid-template-columns:1fr 1fr;}
  }
  @media(max-width:700px){
    .tabnav{flex-wrap:wrap; row-gap:6px; column-gap:16px;}
    .tabbtn{margin-right:0; font-size:12px; padding:8px 2px;}
    .bar-row{
      grid-template-columns: 1fr auto;
      grid-template-areas: "label amount" "track track";
      row-gap:5px; margin-bottom:14px;
    }
    .bar-label{grid-area:label; white-space:normal;}
    .bar-amount{grid-area:amount;}
    .bar-track{grid-area:track;}
  }
  .field label{
    display:block;font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.1em;
    text-transform:uppercase;color:var(--ink-muted);margin-bottom:7px;
  }
  .field input, .field select{
    width:100%;background:var(--surface-2);border:1px solid var(--line);border-radius:4px;color:var(--ink);
    padding:9px 10px;font-family:'IBM Plex Sans', sans-serif;font-size:14px;
  }
  .field input:focus, .field select:focus{outline:none;border-color:var(--accent);}
  .field.checkfield{display:flex;flex-direction:row;align-items:center;gap:8px;padding-bottom:9px;}
  .field.checkfield input{width:auto;}
  .price-row{display:grid;grid-template-columns: 88px 1fr;gap:6px;}
  .cat-hint{font-family:'IBM Plex Mono', monospace;font-size:10px;color:var(--ink-muted);margin-top:6px;min-height:14px;}
  button{cursor:pointer;font-family:'IBM Plex Mono', monospace;letter-spacing:0.08em;}
  .btn-add{
    background:var(--accent);color:#fff;border:none;border-radius:4px;padding:11px 18px;
    font-size:12px;font-weight:600;text-transform:uppercase;white-space:nowrap;
  }
  .btn-add:hover{background:#264033;}
  .btn-add.wishlist-btn{background:var(--wishlist);}
  .btn-add.wishlist-btn:hover{background:#48477a;}
  .btn-add.expense-btn{background:var(--danger);}
  .btn-add.expense-btn:hover{background:#652f24;}

  .controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px;}
  .controls input[type=text]{
    flex:1;min-width:180px;background:var(--surface);border:1px solid var(--line);
    border-radius:4px;color:var(--ink);padding:9px 12px;font-size:14px;
  }
  .controls select{
    background:var(--surface);border:1px solid var(--line);border-radius:4px;
    color:var(--ink);padding:9px 10px;font-family:'IBM Plex Mono', monospace;font-size:12px;
  }
  .view-toggle{display:inline-flex;gap:6px;margin-left:auto;}
  .vt-btn{
    background:var(--surface);border:1px solid var(--line);color:var(--ink-muted);
    font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;
    padding:8px 14px;border-radius:4px;cursor:pointer;
  }
  .vt-btn.active{border-color:var(--ink);color:var(--ink);}

  /* Collection screen title */
  .screen-header{
    display:flex;align-items:baseline;justify-content:space-between;
    margin-bottom:22px;padding-bottom:14px;border-bottom:1px solid var(--line);
  }
  .screen-title{
    font-family:'Archivo', sans-serif;font-weight:700;font-size:20px;letter-spacing:0.04em;
    color:var(--ink);margin:0;text-transform:uppercase;
  }
  .screen-count{
    font-family:'IBM Plex Mono', monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;
    color:var(--ink-muted);
  }

  /* Collection filter toolbar */
  .collection-toolbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px;}
  .search-field{flex:1;min-width:220px;}
  .search-field input{
    width:100%;background:var(--surface);border:1px solid var(--line);border-radius:4px;
    color:var(--ink);padding:9px 12px;font-family:'IBM Plex Sans', sans-serif;font-size:13.5px;
  }
  .search-field input:focus{outline:none;border-color:var(--accent);}
  .filter-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .filter-dd{position:relative;}
  .filter-trigger{
    background:var(--surface);border:1px solid var(--line);color:var(--ink-muted);
    font-family:'IBM Plex Mono', monospace;font-size:10.5px;letter-spacing:0.08em;text-transform:uppercase;
    padding:9px 14px;border-radius:4px;cursor:pointer;transition:border-color 0.15s ease, color 0.15s ease;
  }
  .filter-trigger:hover{border-color:var(--ink-muted);color:var(--ink);}
  .filter-trigger.has-value{border-color:var(--accent);color:var(--accent);}
  .filter-trigger.open{border-color:var(--accent);color:var(--ink);}
  .filter-trigger:focus-visible{outline:1px solid var(--accent);outline-offset:1px;}
  .filter-popover{
    display:none;position:absolute;top:calc(100% + 6px);left:0;z-index:20;
    background:var(--surface-2);border:1px solid var(--line);border-radius:4px;
    padding:14px;min-width:220px;box-shadow:0 10px 28px rgba(0,0,0,0.55);
  }
  .filter-popover.open{display:block;}
  .filter-pop-label{
    display:block;font-family:'IBM Plex Mono', monospace;font-size:9.5px;letter-spacing:0.1em;text-transform:uppercase;
    color:var(--ink-muted);margin-bottom:6px;
  }
  .filter-popover select{
    width:100%;background:var(--surface);border:1px solid var(--line);border-radius:3px;color:var(--ink);
    padding:8px 9px;font-family:'IBM Plex Mono', monospace;font-size:12px;margin-bottom:12px;
  }
  .filter-popover select:focus{outline:none;border-color:var(--accent);}
  .filter-popover select:last-of-type{margin-bottom:0;}
  .filter-check{
    display:flex;align-items:center;gap:7px;font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);
    margin-top:10px;cursor:pointer;
  }
  .filter-check input{accent-color:var(--profit-pos);}
  .sort-select{
    background:var(--surface);border:1px solid var(--line);border-radius:4px;
    color:var(--ink);padding:9px 10px;font-family:'IBM Plex Mono', monospace;font-size:11.5px;
  }
  .sort-select:focus{outline:none;border-color:var(--accent);}
  .active-filters{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:18px;}
  .active-filters:empty{margin-bottom:0;}
  .filter-tag{
    display:inline-flex;align-items:center;gap:6px;
    background:var(--surface-2);border:1px solid var(--line);border-radius:4px;
    padding:5px 5px 5px 9px;font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.04em;text-transform:uppercase;
    color:var(--ink-muted);
  }
  .filter-tag button{
    background:none;border:none;color:var(--ink-muted);cursor:pointer;font-size:13px;line-height:1;padding:2px 4px;
  }
  .filter-tag button:hover{color:var(--danger);}
  .clear-all-filters{
    background:none;border:none;color:var(--accent);cursor:pointer;
    font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;
    text-decoration:underline;padding:0;
  }
  .consign-vt-btn{
    background:var(--surface);border:1px solid var(--line);color:var(--ink-muted);
    font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;
    padding:8px 14px;border-radius:4px;cursor:pointer;
  }
  .consign-vt-btn.active{border-color:var(--ink);color:var(--ink);}
  .loan-vt-btn{
    background:var(--surface);border:1px solid var(--line);color:var(--ink-muted);
    font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;
    padding:8px 14px;border-radius:4px;cursor:pointer;
  }
  .loan-vt-btn.active{border-color:var(--ink);color:var(--ink);}
  .row.consign-row{grid-template-columns:4px 2fr 230px 140px minmax(140px,240px) 96px 96px;}
  .consign-loc{font-family:'IBM Plex Mono', monospace;font-size:11.5px;}
  .consign-loc.at-house{color:var(--gold);}
  .consign-loc.returned{color:var(--profit-pos);}

  /* Verify / warehouse-count feature */
  .icon-btn.verify{color:var(--ink-muted);}
  .icon-btn.verify:hover{color:var(--profit-pos);border-color:var(--profit-pos);background:rgba(111,191,115,0.08);}
  .icon-btn.verify.checked{background:rgba(111,191,115,0.14);border-color:var(--profit-pos);color:var(--profit-pos);}
  .verified-tag{color:var(--profit-pos);font-family:'IBM Plex Mono', monospace;font-size:10.5px;font-weight:600;letter-spacing:0.03em;text-transform:uppercase;margin-top:3px;display:inline-block;}
  .set-tag{color:var(--wishlist);font-family:'IBM Plex Mono', monospace;font-size:10.5px;margin-top:2px;}
  .row.verified{background-color:rgba(111,191,115,0.035);}
  .card.verified{border-color:rgba(111,191,115,0.4);box-shadow:inset 0 0 0 1px rgba(111,191,115,0.25), 0 2px 10px rgba(0,0,0,0.4);}
  .verify-filter-toggle{display:flex;align-items:center;gap:7px;font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);white-space:nowrap;}
  .verify-filter-toggle input{accent-color:var(--profit-pos);}

  /* Ledger tab */
  .ledger-add-contact{display:flex;gap:10px;margin-bottom:16px;}
  .ledger-add-contact input{
    background:var(--surface-2);border:1px solid var(--line);border-radius:4px;color:var(--ink);
    padding:9px 12px;font-family:'IBM Plex Sans', sans-serif;font-size:14px;
  }
  .ledger-add-contact input:focus{outline:none;border-color:var(--accent);}
  .ledger-add-contact input{flex:1;max-width:280px;}
  .contact-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(200px,1fr));gap:12px;}
  .contact-grid .empty{grid-column:1/-1;}
  .contact-card{
    background:var(--surface-2);border:1px solid var(--line);border-radius:3px;padding:16px;cursor:pointer;
    transition:border-color 0.15s ease;
  }
  .contact-card:hover{border-color:var(--accent);}
  .contact-card.selected{border-color:var(--accent);background:var(--accent-soft);}
  .contact-name{font-family:'Archivo', sans-serif;font-weight:700;font-size:15px;color:var(--ink);margin-bottom:8px;}
  .contact-balance{font-family:'IBM Plex Mono', monospace;font-size:17px;font-weight:600;}
  .contact-balance-lbl{font-family:'IBM Plex Mono', monospace;font-size:10px;color:var(--ink-muted);text-transform:uppercase;letter-spacing:0.06em;margin-top:2px;}
  .contact-sub{font-family:'IBM Plex Mono', monospace;font-size:10.5px;color:var(--ink-muted);margin-top:8px;}
  .owe{color:var(--danger);}
  .settled{color:var(--profit-pos);}
  .ledger-detail-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;flex-wrap:wrap;gap:12px;}
  .ledger-detail-balance{font-family:'IBM Plex Mono', monospace;font-size:24px;font-weight:700;margin-top:6px;line-height:1.6;}
  .ledger-detail-actions{display:flex;gap:8px;}
  .ledger-entry-form{background:var(--surface-2);border:1px solid var(--line);border-radius:3px;padding:16px;margin-bottom:18px;}
  .ledger-type-toggle{display:inline-flex;gap:6px;margin-bottom:14px;}
  .ledger-type-btn{
    background:var(--surface);border:1px solid var(--line);color:var(--ink-muted);
    font-family:'IBM Plex Mono', monospace;font-size:10.5px;letter-spacing:0.04em;
    padding:9px 14px;border-radius:4px;cursor:pointer;
  }
  .ledger-type-btn.active[data-entrytype="batch"]{border-color:var(--gold);color:var(--gold);background:var(--accent-soft);}
  .ledger-type-btn.active[data-entrytype="payment"]{border-color:var(--profit-pos);color:var(--profit-pos);background:rgba(111,191,115,0.1);}
  .listing-type-btn{
    background:var(--surface);border:1px solid var(--line);color:var(--ink-muted);
    font-family:'IBM Plex Mono', monospace;font-size:10.5px;letter-spacing:0.04em;
    padding:9px 14px;border-radius:4px;cursor:pointer;
  }
  .listing-type-btn.active{border-color:var(--accent);color:var(--accent);background:var(--accent-soft);}
  .item-status-btn{
    background:var(--surface);border:1px solid var(--line);color:var(--ink-muted);
    font-family:'IBM Plex Mono', monospace;font-size:10.5px;letter-spacing:0.04em;
    padding:9px 14px;border-radius:4px;cursor:pointer;
  }
  .item-status-btn.active[data-status="collection"]{border-color:var(--profit-pos);color:var(--profit-pos);background:rgba(111,191,115,0.1);}
  .item-status-btn.active[data-status="consigned"]{border-color:var(--gold);color:var(--gold);background:var(--accent-soft);}
  .item-status-btn.active[data-status="loaned"]{border-color:#dcc07a;color:#dcc07a;background:rgba(220,192,122,0.1);}
  .item-status-btn.active[data-status="sold"]{border-color:var(--profit-pos);color:var(--profit-pos);background:rgba(111,191,115,0.1);}
  .item-status-tag{
    font-family:'IBM Plex Mono', monospace;font-size:10.5px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;
    display:inline-block;padding:4px 9px;border-radius:4px;margin-top:4px;
  }
  .item-status-tag.consigned{background:rgba(212,175,98,0.14);color:var(--gold);border:1px solid rgba(212,175,98,0.4);}
  .item-status-tag.loaned{background:rgba(220,192,122,0.14);color:#dcc07a;border:1px solid rgba(220,192,122,0.4);}
  .item-status-tag.sold{background:rgba(111,191,115,0.14);color:var(--profit-pos);border:1px solid rgba(111,191,115,0.4);}
  .sm-badge{
    font-family:'IBM Plex Mono', monospace;font-size:9.5px;letter-spacing:0.03em;text-transform:uppercase;
    display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:4px;margin-top:3px;cursor:pointer;
    border:1px solid var(--line);color:var(--ink-muted);background:none;
  }
  .sm-badge.active{border-color:#8fb3e6;color:#8fb3e6;background:rgba(143,179,230,0.12);}
  .sm-badge:hover{border-color:#8fb3e6;color:#8fb3e6;}
  .consign-group-header{
    display:flex;align-items:baseline;gap:10px;margin:22px 0 10px;padding-bottom:8px;border-bottom:1px solid var(--line);
    grid-column: 1 / -1;
  }
  .consign-group-header:first-child{margin-top:0;}
  .consign-group-name{font-family:'Archivo', sans-serif;font-weight:700;font-size:15px;color:var(--ink);}
  .consign-group-count{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);}
  .consign-group-summary{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--gold);margin-left:auto;}
  .buynow-badge{
    font-family:'IBM Plex Mono', monospace;font-size:9px;letter-spacing:0.04em;text-transform:uppercase;
    padding:3px 7px;border-radius:4px;background:rgba(111,144,191,0.14);color:#8fb3e6;border:1px solid rgba(111,144,191,0.4);
    white-space:nowrap;display:inline-block;
  }
  .row.ledger-row{grid-template-columns:4px 90px 100px 1fr 110px 110px 76px;}
  .ledger-entry-badge{font-family:'IBM Plex Mono', monospace;font-size:9.5px;letter-spacing:0.04em;text-transform:uppercase;padding:4px 8px;border-radius:3px;display:inline-block;}
  .ledger-running{font-family:'IBM Plex Mono', monospace;font-size:12px;color:var(--ink-muted);text-align:right;}

  /* Consignments tab */
  .consign-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(320px,1fr));gap:14px;}
  .consign-grid .empty{grid-column:1/-1;}
  .consign-card{
    background:var(--surface);border:1px solid var(--line);border-radius:3px;padding:18px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,0.03), 0 2px 10px rgba(0,0,0,0.4);
  }
  .consign-card.status-sold{border-color:rgba(111,191,115,0.4);}
  .consign-card.status-unsold{border-color:rgba(122,59,46,0.5);}
  .consign-card.status-returning{border-color:rgba(220,192,122,0.4);}
  .consign-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:10px;}
  .consign-name{font-family:'Archivo', sans-serif;font-weight:700;font-size:15px;color:var(--ink);line-height:1.3;}
  .consign-house{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);margin-top:4px;}
  .status-badge{
    font-family:'IBM Plex Mono', monospace;font-size:9.5px;letter-spacing:0.04em;text-transform:uppercase;
    padding:4px 9px;border-radius:3px;white-space:nowrap;flex-shrink:0;
  }
  .status-badge.status-listed{background:rgba(212,175,98,0.14);color:var(--gold);border:1px solid rgba(212,175,98,0.4);}
  .status-badge.status-sold{background:rgba(111,191,115,0.14);color:var(--profit-pos);border:1px solid rgba(111,191,115,0.4);}
  .status-badge.status-unsold{background:rgba(122,59,46,0.14);color:var(--danger);border:1px solid rgba(122,59,46,0.5);}
  .status-badge.status-returning{background:rgba(220,192,122,0.14);color:#dcc07a;border:1px solid rgba(220,192,122,0.4);}
  .consign-status-stack{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px;}
  .consign-estimate{
    display:flex;justify-content:space-between;align-items:center;
    background:var(--surface-2);border-radius:3px;padding:12px 14px;margin:12px 0;
  }
  .consign-estimate-val{font-family:'IBM Plex Mono', monospace;font-size:15px;font-weight:600;color:var(--ink);}
  .consign-estimate-lbl{font-family:'IBM Plex Mono', monospace;font-size:9.5px;color:var(--ink-muted);text-transform:uppercase;letter-spacing:0.05em;margin-top:2px;}
  .consign-sold-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
  .consign-sold-price{font-family:'IBM Plex Mono', monospace;font-size:17px;font-weight:700;color:var(--gold);}
  .consign-meta{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);display:flex;justify-content:space-between;margin-bottom:6px;}
  .consign-note{font-family:'IBM Plex Sans', sans-serif;font-size:12px;color:var(--ink-muted);margin-top:10px;line-height:1.4;}
  .consign-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:14px;}

  /* Overview tab */
  .ov-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px;}
  @media(max-width:900px){ .ov-grid{grid-template-columns:1fr;} .ov-editorial-grid{grid-template-columns:1fr!important;} .ov-status-row{flex-wrap:wrap;gap:22px 32px!important;} }

  .ov-fin-header{padding:8px 0 20px;}
  .ov-fin-value{font-family:'IBM Plex Mono', monospace;font-size:44px;font-weight:700;color:var(--gold);line-height:1.05;}
  .ov-fin-label{
    font-family:'IBM Plex Mono', monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;
    color:var(--ink-muted);margin-top:6px;
  }
  .ov-fin-breakdown{
    font-family:'IBM Plex Mono', monospace;font-size:12px;color:var(--ink-muted);margin-top:14px;
    padding-top:14px;border-top:1px solid var(--line);
  }

  .ov-goal-inline{padding:20px 0;border-top:1px solid var(--line);}
  .ov-goal-top{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:10px;margin-bottom:10px;}
  .ov-goal-title{font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:var(--ink-muted);}
  .ov-goal-pct{font-family:'Archivo', sans-serif;font-size:20px;font-weight:800;color:var(--accent);}
  .ov-goal-bottom{
    display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-top:10px;
    font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);
  }
  .goal-bar-track.thin{height:4px;}

  .ov-status-row{
    display:flex;align-items:baseline;gap:40px;padding:20px 0;border-top:1px solid var(--line);
    margin-bottom:8px;flex-wrap:wrap;
  }
  .ov-status-item{display:flex;flex-direction:column;gap:5px;}
  .ov-status-val{font-family:'IBM Plex Mono', monospace;font-size:19px;font-weight:600;color:var(--ink);}
  .ov-status-val.warn{color:var(--gold);}
  .ov-status-lbl{font-family:'IBM Plex Mono', monospace;font-size:9.5px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink-muted);}

  .ov-editorial-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:24px 0;border-top:1px solid var(--line);margin-bottom:22px;}
  .ov-col-heading{
    font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;
    color:var(--ink-muted);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--line);
  }

  .ov-list-row{
    display:flex;justify-content:space-between;align-items:center;gap:10px;
    padding:10px 0;border-bottom:1px solid var(--line);
  }
  .ov-list-row:last-child{border-bottom:none;}
  .ov-list-name{font-family:'Archivo', sans-serif;font-weight:700;font-size:13px;color:var(--ink);}
  .ov-list-sub{font-family:'IBM Plex Mono', monospace;font-size:10.5px;color:var(--ink-muted);margin-top:2px;}
  .ov-list-val{font-family:'IBM Plex Mono', monospace;font-size:13px;color:var(--ink);font-weight:600;white-space:nowrap;}

  /* Loans */
  .status-badge.status-onloan{background:rgba(220,192,122,0.14);color:#dcc07a;border:1px solid rgba(220,192,122,0.4);}
  .status-badge.status-returned{background:rgba(111,191,115,0.14);color:var(--profit-pos);border:1px solid rgba(111,191,115,0.4);}

  /* Provenance / notes badges on collection items */
  .coa-badge{
    font-family:'IBM Plex Mono', monospace;font-size:9px;letter-spacing:0.04em;text-transform:uppercase;
    padding:3px 7px;border-radius:4px;background:none;color:var(--profit-pos);border:1px solid rgba(111,191,115,0.35);
    display:inline-block;white-space:nowrap;margin-top:3px;
  }
  .item-note{font-family:'IBM Plex Sans', sans-serif;font-size:11.5px;color:var(--ink-muted);margin-top:4px;line-height:1.4;font-style:italic;}
  .doc-toggle{
    background:none;border:none;color:var(--accent);font-family:'IBM Plex Mono', monospace;font-size:10.5px;
    letter-spacing:0.05em;text-transform:uppercase;cursor:pointer;padding:0;margin:4px 0 10px;text-decoration:underline;
  }
  .doc-section{display:none;padding-top:12px;margin-top:4px;border-top:1px solid var(--line);}
  .doc-section.open{display:block;}

  .chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
  .chip{
    font-family:'IBM Plex Mono', monospace;font-size:10px;letter-spacing:0.06em;text-transform:uppercase;
    padding:6px 12px;border-radius:4px;border:1px solid var(--line);background:var(--surface);
    color:var(--ink-muted);cursor:pointer;white-space:nowrap;
  }
  .chip.active{border-color:var(--accent);color:var(--accent);background:var(--accent-soft);}

  /* Bars */
  .bars-panel{margin-bottom:22px;}
  .archival-section{margin-bottom:26px;padding-bottom:22px;border-bottom:1px solid var(--line);}
  .log-piece-section{margin-bottom:26px;}
  .log-piece-toggle{
    background:none;border:1px solid var(--line);color:var(--ink-muted);
    font-family:'IBM Plex Mono', monospace;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;
    padding:10px 16px;border-radius:4px;cursor:pointer;
  }
  .log-piece-toggle:hover{color:var(--accent);border-color:var(--accent);}
  .log-piece-toggle.open{color:var(--ink);border-color:var(--ink-muted);margin-bottom:20px;}
  .log-piece-form{max-height:0;opacity:0;overflow:hidden;transition:max-height 0.32s ease, opacity 0.22s ease;}
  .log-piece-form.open{opacity:1;}
  .bar-row{display:grid;grid-template-columns:210px 1fr 90px;align-items:center;gap:10px;margin-bottom:12px;}
  .bar-label{font-family:'IBM Plex Mono', monospace;font-size:10.5px;color:var(--ink-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .bar-track{height:3px;background:var(--surface-2);border:none;border-radius:2px;overflow:hidden;}
  .bar-fill{height:100%;border-radius:2px;opacity:0.85;}
  .bar-amount{font-family:'IBM Plex Mono', monospace;font-size:10.5px;color:var(--ink-muted);text-align:right;}

  /* List rows */
  #list.list-view, #wishlist-list, #expense-list, #consignCards.list-view{display:flex;flex-direction:column;}
  .row{
    display:grid;
    grid-template-columns: 4px 1.6fr 205px 110px 1fr 98px 132px;
    align-items:center;gap:14px;
    background:transparent;border:none;border-bottom:1px solid var(--line);
    border-radius:0;padding:14px 6px;box-shadow:none;
    transition:background-color 0.12s ease;
  }
  .row:hover{background-color:rgba(255,255,255,0.02);}
  #list.list-view .row:last-child, #wishlist-list .row:last-child, #expense-list .row:last-child{border-bottom:none;}
  .row.collection-row{grid-template-columns: 60px 1.9fr 145px 100px 1fr 88px 110px;}
  .row-thumb{
    width:56px;height:56px;border-radius:4px;display:flex;align-items:center;justify-content:center;
    flex-shrink:0;background:#141416;border:1px solid var(--line);
  }
  .row-thumb-empty{
    font-family:'IBM Plex Mono', monospace;font-weight:500;font-size:7px;letter-spacing:0.05em;
    color:#4a4a4d;text-align:center;line-height:1.35;
  }
  .row.wishlist-row{grid-template-columns:4px 2fr 120px 100px 1fr 148px;}
  .row.expense-row{grid-template-columns:4px 1.6fr 100px 90px 1fr 90px 76px;}
  .row.exit-row{grid-template-columns:4px 2fr 100px 100px 100px 110px;}
  .profit-pos{color:var(--profit-pos);}
  .profit-neg{color:var(--danger);}
  .profit-flat{color:var(--ink-muted);}
  @media(max-width:900px){
    .row, .row.wishlist-row, .row.expense-row, .row.exit-row, .row.consign-row, .row.ledger-row, .row.collection-row{grid-template-columns: 4px 1fr 132px; row-gap:6px;}
    .row.collection-row .row-thumb{display:none;}
    .row>div:not(.tab):not(.col-name):not(.row-actions):not(.row-thumb){grid-column: 2/3;}
    .row.ledger-row .date, .row.consign-row .date{text-align:left;}
    .row.ledger-row .ledger-running, .row.consign-row .col-price{text-align:left;}
  }
  .tab{width:4px;align-self:stretch;border-radius:2px;}
  .item-name{font-family:'Archivo', sans-serif;font-size:14.5px;font-weight:700;letter-spacing:0.003em;color:var(--ink);}
  .col-name{min-width:0;}
  .col-name .item-name{white-space:normal;line-height:1.3;}
  .col-name .item-sub{overflow:visible;text-overflow:clip;white-space:normal;line-height:1.4;}
  .item-sub{font-family:'IBM Plex Mono', monospace;font-size:10.5px;color:var(--ink-muted);margin-top:2px;}
  .accession-mark{
    font-family:'IBM Plex Mono', monospace;font-size:9.5px;letter-spacing:0.08em;color:#5c584c;
    margin-bottom:3px;
  }
  .provenance-line{font-family:'IBM Plex Sans', sans-serif;font-size:12px;color:var(--ink-muted);margin-top:3px;line-height:1.4;}
  .card-body .provenance-line{margin-bottom:14px;}
  .badge{
    font-family:'IBM Plex Mono', monospace;font-size:9px;letter-spacing:0.02em;text-transform:uppercase;
    padding:3px 7px;border-radius:4px;display:inline-block;white-space:nowrap;line-height:1.35;margin-bottom:3px;
    border:none!important;opacity:0.8;
  }
  .badge-sub{font-family:'IBM Plex Mono', monospace;font-size:10px;color:var(--ink-muted);display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .col-cat{min-width:0;}
  .price{font-family:'IBM Plex Mono', monospace;font-size:13.5px;color:var(--ink);text-align:right;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;}
  .price.outflow{color:var(--danger);}
  .row .col-price{white-space:normal;overflow:visible;text-overflow:clip;}
  .row .col-price .price-num{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .row .col-price .item-sub{white-space:normal;line-height:1.4;}
  .loc{font-size:13px;color:var(--ink-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;}
  .date{font-family:'IBM Plex Mono', monospace;font-size:11.5px;color:var(--ink-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;}
  .row-actions{display:flex;gap:4px;justify-content:flex-end;}
  .catalogue-head{
    padding:0 6px 10px;border-bottom:1px solid var(--line);margin-bottom:2px;display:none;
  }
  .catalogue-head:hover{background:none;}
  .col-head{
    font-family:'IBM Plex Mono', monospace;font-size:9.5px;letter-spacing:0.12em;text-transform:uppercase;
    color:var(--ink-muted);
  }
  .icon-btn{
    background:none;border:none;color:var(--ink-muted);
    font-size:10.5px;line-height:1;padding:4px 3px;font-family:'IBM Plex Mono', monospace;
    letter-spacing:0.04em;text-transform:uppercase;opacity:0.65;
    transition:opacity 0.12s ease, color 0.12s ease;
  }
  .row:hover .icon-btn, .card:hover .icon-btn, .consign-card:hover .icon-btn{opacity:1;}
  .icon-btn.verify.checked{opacity:1;color:var(--profit-pos);}
  .icon-btn.del:hover{color:var(--danger);text-decoration:underline;}
  .icon-btn.edit:hover{color:var(--accent);text-decoration:underline;}
  .icon-btn.acquire:hover{color:var(--wishlist);text-decoration:underline;}
  .icon-btn.dup:hover{color:var(--accent);text-decoration:underline;}

  .edit-row{background:var(--surface-2);border:1px solid var(--accent);border-radius:3px;padding:18px;}
  .edit-row-span{grid-column:1/-1;}
  .edit-grid{display:grid;grid-template-columns: 2fr 1fr 1fr;gap:10px;margin-bottom:10px;}
  .edit-grid-2{display:grid;grid-template-columns: 1fr 1fr 1fr 1fr;gap:10px;margin-bottom:10px;}
  .edit-grid-3{display:grid;grid-template-columns: 1fr 1fr 1fr;gap:10px;margin-bottom:12px;}
  @media(max-width:900px){
    .edit-grid, .edit-grid-2, .edit-grid-3{grid-template-columns:1fr 1fr;}
  }
  .edit-actions{display:flex;gap:8px;justify-content:flex-end;}
  .btn-save{background:var(--accent);color:#fff;border:none;border-radius:4px;padding:8px 16px;font-size:11px;font-weight:600;text-transform:uppercase;}
  .btn-cancel{background:none;border:1px solid var(--line);color:var(--ink-muted);border-radius:4px;padding:8px 16px;font-size:11px;text-transform:uppercase;}

  /* Gallery cards */
  #list{transition:opacity 0.18s ease;}
  #list.grid-view{display:grid;grid-template-columns:repeat(auto-fill, minmax(240px,1fr));gap:22px;}
  .card{
    background:var(--surface);border:1px solid var(--line);border-radius:3px;overflow:hidden;
    box-shadow:inset 0 1px 0 rgba(255,255,255,0.05), 0 6px 22px rgba(0,0,0,0.55);
    transition:box-shadow .2s ease, transform .2s ease;
  }
  .card:hover{box-shadow:0 18px 40px rgba(0,0,0,0.6), 0 0 0 1px rgba(212,175,98,0.25);transform:translateY(-3px);}
  .cat-head{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:14px;}
  .cat-head input[type=text], .cat-titlerow input[type=text], .cat-actions select{
    background:var(--surface-2);border:1px solid var(--line);border-radius:4px;color:var(--ink);
    padding:7px 10px;font-family:'IBM Plex Sans', sans-serif;font-size:13px;}
  .cat-head input[type=text]:focus, .cat-titlerow input[type=text]:focus, .cat-actions select:focus{outline:none;border-color:var(--accent);}
  .cat-head input[type=text]{flex:1;min-width:140px;max-width:260px;}
  .cat-titlerow{display:flex;flex-wrap:wrap;gap:10px;align-items:center;}
  .cat-name{font-size:22px;color:var(--ink);margin-right:auto;}
  .cat-progress{height:8px;border-radius:4px;background:var(--line);overflow:hidden;margin:12px 0 6px;}
  .cat-progress>div{height:100%;background:var(--accent);}
  .cat-meta{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-muted);}
  .cat-group{margin-bottom:22px;}
  .cat-group-title{display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted);padding:6px 2px;border-bottom:1px solid var(--line);}
  .cat-entry{display:flex;align-items:center;gap:12px;padding:10px 4px;border-bottom:1px solid var(--line);}
  .cat-entry.cat-edit{align-items:flex-start;}
  .cat-check{flex:none;width:24px;height:24px;border-radius:50%;border:1.5px solid var(--ink-muted);background:transparent;color:#0A0A0B;cursor:pointer;font-size:14px;line-height:20px;padding:0;}
  .cat-entry.owned .cat-check{background:var(--accent);border-color:var(--accent);}
  .cat-main{flex:1;min-width:0;}
  .cat-title{color:var(--ink);font-size:14px;}
  .cat-entry.owned .cat-title{color:var(--ink-muted);}
  .cat-sub{font-size:12px;color:var(--ink-muted);margin-top:2px;}
  .cat-note{font-style:italic;}
  .cat-actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center;justify-content:flex-end;}
  .cat-btn{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.06em;text-transform:uppercase;padding:6px 10px;border-radius:4px;border:1px solid var(--line);background:var(--surface);color:var(--ink-muted);cursor:pointer;}
  .cat-btn:hover{border-color:var(--accent);color:var(--accent);}
  .cat-btn.primary{border-color:var(--accent);color:var(--accent);}
  .cat-btn.danger:hover{border-color:#e2604c;color:#e2604c;}
  .cat-tag{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--ink-muted);text-transform:uppercase;letter-spacing:.06em;}
  @media(max-width:700px){.cat-entry{flex-wrap:wrap;}.cat-actions{justify-content:flex-start;width:100%;padding-left:36px;}}
  .wish-thumb{float:left;width:44px;height:44px;margin-right:10px;border-radius:4px;border:1px solid var(--line);background-size:cover;background-position:center;cursor:zoom-in;}
  .photo-stage-field{margin-bottom:14px;}
  .photo-count{position:absolute;right:8px;bottom:8px;background:rgba(0,0,0,.65);color:#fff;font:11px 'IBM Plex Mono',monospace;padding:2px 6px;border-radius:3px;}
  .photo-mgr{margin-bottom:12px;display:flex;flex-direction:column;gap:8px;}
  .photo-strip{display:flex;gap:8px;flex-wrap:wrap;}
  .photo-tile{position:relative;width:76px;height:76px;border:1px solid var(--line);border-radius:4px;background-size:cover;background-position:center;cursor:zoom-in;}
  .photo-tile.cover{outline:2px solid var(--accent);}
  .photo-tile button{position:absolute;top:2px;width:20px;height:20px;padding:0;border:0;border-radius:3px;background:rgba(0,0,0,.65);color:#fff;font-size:12px;line-height:20px;cursor:pointer;}
  .pt-star{left:2px;} .pt-del{right:2px;}
  .photo-add{align-self:flex-start;cursor:pointer;}
  .photo-hint{font-size:11px;color:var(--ink-muted);}
  .photo-lightbox{position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.92);display:flex;align-items:center;justify-content:center;}
  .photo-lightbox img{max-width:92vw;max-height:88vh;object-fit:contain;}
  .photo-lightbox button{position:absolute;background:none;border:0;color:#fff;font-size:34px;cursor:pointer;padding:12px;}
  .lb-prev{left:8px;top:50%;} .lb-next{right:8px;top:50%;} .lb-close{right:10px;top:6px;}
  .lb-count{position:absolute;bottom:14px;color:#fff;font:12px 'IBM Plex Mono',monospace;}
  .card-plate{position:relative;height:148px;display:flex;align-items:center;justify-content:center;background:#141416;border-bottom:1px solid var(--line);}
  .card-plate-empty{background:#141416;}
  .plate-tag{
    position:absolute;top:10px;left:12px;font-family:'IBM Plex Mono', monospace;font-size:8.5px;
    letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-muted);
  }
  .plate-mono-empty{font-family:'IBM Plex Mono', monospace;font-weight:500;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#4a4a4d;}
  .card-body{padding:16px;}
  .card-badge{font-family:'IBM Plex Mono', monospace;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:7px;}
  .card-title{font-family:'Archivo', sans-serif;font-weight:700;font-size:15px;letter-spacing:0.003em;color:var(--ink);line-height:1.3;margin-bottom:4px;min-height:39px;}
  .card-sub{font-family:'IBM Plex Sans', sans-serif;font-size:12px;color:var(--ink-muted);margin-bottom:14px;min-height:13px;}
  .card-stats{display:flex;align-items:center;padding-top:12px;border-top:1px solid var(--line);margin-bottom:10px;}
  .stat{flex:1;overflow:hidden;}
  .stat-val{font-family:'IBM Plex Mono', monospace;font-size:13px;color:var(--ink);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .stat-val.muted{color:var(--ink-muted);font-weight:400;}
  .stat-lbl{font-family:'IBM Plex Mono', monospace;font-size:8.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-muted);margin-top:2px;}
  .stat-divider{width:1px;align-self:stretch;background:var(--line);margin:0 12px;}
  .card-actions{display:flex;gap:6px;justify-content:flex-end;}

  .empty{text-align:center;padding:60px 20px;color:var(--ink-muted);font-family:'IBM Plex Mono', monospace;font-size:12px;letter-spacing:0.05em;}
  #list.grid-view .empty{grid-column:1/-1;}

  footer{
    margin-top:32px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;
    border-top:2px solid var(--ink);padding-top:18px;
  }
  .file-actions{display:flex;gap:8px;flex-wrap:wrap;}
  #importJsonFile{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);max-width:220px;}
  .btn-ghost{
    background:none;border:1px solid var(--line);color:var(--ink-muted);border-radius:3px;
    padding:8px 12px;font-size:11px;text-transform:uppercase;
    display:inline-block;text-decoration:none;cursor:pointer;font-family:'IBM Plex Mono', monospace;letter-spacing:0.08em;
  }
  .btn-ghost:hover{border-color:var(--accent);color:var(--accent);}
  .count{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);}
</style>
<script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
<div class="wrap">

  <header>
    <div class="header-top">
      <div class="brand-block">
        <img class="logo-img" src="data:image/png;base64," alt="ARTEFAKT">
        <div class="tagline">A collector's archive</div>
      </div>
      <div class="item-count" id="itemCount"></div>
    </div>
  </header>

  <div class="notice" id="storageNotice"></div>

  <div class="tabnav">
    <button class="tabbtn active" data-tab="overview">Overview</button>
    <button class="tabbtn" data-tab="collection">Collection</button>
    <button class="tabbtn" data-tab="wishlist">Wishlist</button>
    <button class="tabbtn" data-tab="catalogue">Catalogue</button>
    <button class="tabbtn" data-tab="expenses">Expenses</button>
    <button class="tabbtn" data-tab="exit">Exit Value</button>
    <button class="tabbtn" data-tab="ledger">Ledger</button>
    <button class="tabbtn" data-tab="consign">Consignments</button>
    <button class="tabbtn" data-tab="loans">Loans</button>
    <span class="tabnav-spacer"></span>
    <button type="button" class="backup-util-trigger" id="backupUtilTrigger">Backup</button>
  </div>

  <div class="backup-modal-overlay" id="backupModalOverlay">
    <div class="backup-modal">
      <div class="backup-modal-head">
        <span>Full backup</span>
        <button type="button" class="backup-modal-close" id="backupModalClose">&times;</button>
      </div>
      <div class="backup-modal-body">
        <div class="backup-modal-section">
          <div class="backup-modal-label">Cross-device sync (Google Drive)</div>
          <p class="backup-modal-note">Sign in once and this device and any other device you sign in on share the same backup file in your Google Drive &mdash; works on desktop and mobile browsers alike. The app can only see the one file it creates, nothing else in your Drive.</p>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <button type="button" class="btn-ghost" id="driveConnectBtn">Connect Google Drive</button>
            <button type="button" class="btn-ghost" id="driveDisconnectBtn" style="display:none;">Disconnect</button>
          </div>
          <div id="driveSyncStatus" style="font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);margin-top:8px;"></div>
          <div id="driveConflictBanner" style="display:none;margin-top:10px;padding:10px;border:1px solid var(--accent);background:var(--accent-soft);border-radius:4px;">
            <div id="driveConflictText" style="font-family:'IBM Plex Sans', sans-serif;font-size:12px;color:var(--ink);margin-bottom:8px;"></div>
            <div style="display:flex;gap:8px;">
              <button type="button" class="btn-ghost" id="driveConflictLoadBtn">Load from Drive</button>
              <button type="button" class="btn-ghost" id="driveConflictKeepBtn">Keep this device's version</button>
            </div>
          </div>
        </div>
        <div class="backup-modal-section">
          <div class="backup-modal-label">Auto-save (recommended)</div>
          <p class="backup-modal-note">Connect a file once on this computer and every change saves to it automatically &mdash; no more remembering to export. Needs Chrome or Edge on desktop.</p>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <button type="button" class="btn-ghost" id="autosaveConnectBtn">Connect backup file</button>
            <button type="button" class="btn-ghost" id="autosaveDisconnectBtn" style="display:none;">Disconnect</button>
          </div>
          <div id="autosaveStatus" style="font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--ink-muted);margin-top:8px;"></div>
        </div>
        <div class="backup-modal-section">
          <div class="backup-modal-label">Export</div>
          <p class="backup-modal-note">Downloads a complete backup of your Collection, Wishlist, Expenses, Ledger and settings.</p>
          <a class="btn-ghost" id="exportJson" href="#" download="rack-ledger-backup.json">Export full backup</a>
        </div>
        <div class="backup-modal-section">
          <div class="backup-modal-label">Import / Restore</div>
          <p class="backup-modal-note">A full backup file becomes the complete application state. Older item-only backups fall back to merge/replace below.</p>
          <input type="file" id="importJsonFile" accept=".json,application/json">
          <label class="backup-modal-check">
            <input type="checkbox" id="importReplaceMode"> replace instead of merge <span class="backup-modal-note-inline">(legacy item-only backups only)</span>
          </label>
          <div id="importStatus"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================== OVERVIEW TAB ===================== -->
  <div class="tabpane active" id="tab-overview">
    <div class="notice" id="backupNotice"></div>

    <div class="ov-fin-header">
      <div class="ov-fin-value" id="ovTotalValue">$0</div>
      <div class="ov-fin-label">Total collection value</div>
      <div class="ov-fin-breakdown" id="ovCurrencyBreakdown"></div>
    </div>

    <div class="ov-goal-inline">
      <div class="ov-goal-top">
        <span class="ov-goal-title">Collection value — toward the goal</span>
        <span class="ov-goal-pct" id="goalPct">0%</span>
      </div>
      <div class="goal-bar-track thin"><div class="goal-bar-fill" id="goalFill" style="width:0%"></div></div>
      <div class="ov-goal-bottom">
        <span id="goalSub">$0 of $1,000,000</span>
        <button class="link-btn" id="goalSettingsToggle">Settings</button>
      </div>
      <div class="goal-settings" id="goalSettingsPanel">
        <span class="goal-edit">1 EUR = <input type="number" id="eurRateInput" step="0.0001" min="0" placeholder="—"> USD</span>
        <span class="goal-edit">1 GBP = <input type="number" id="gbpRateInput" step="0.0001" min="0" placeholder="—"> USD</span>
        <button class="link-btn" id="refreshRates">fetch live</button>
        <span id="rateInfo">rates unavailable</span>
        <span class="goal-edit">goal: <input type="number" id="goalInput" value="1000000" min="1" step="1000"></span>
      </div>
    </div>

    <div class="ov-status-row" id="ovStatusRow"></div>

    <div class="ov-editorial-grid">
      <div class="ov-col">
        <div class="ov-col-heading">Most valuable pieces</div>
        <div id="ovTopPieces"></div>
      </div>
      <div class="ov-col">
        <div class="ov-col-heading">Recently added</div>
        <div id="ovRecent"></div>
      </div>
    </div>

    <div class="ov-grid">
      <div class="panel">
        <div class="panel-label">Upcoming consignment sales</div>
        <div id="ovUpcomingSales"></div>
      </div>
      <div class="panel">
        <div class="panel-label">Ledger balances</div>
        <div id="ovLedgerBalances"></div>
      </div>
    </div>
  </div>

  <!-- ===================== COLLECTION TAB ===================== -->
  <div class="tabpane" id="tab-collection">

    <div class="screen-header">
      <h2 class="screen-title">Collection</h2>
      <div class="screen-count" id="collectionScreenCount"></div>
    </div>

    <div class="archival-section">
      <div class="ov-col-heading">Value by type</div>
      <div id="typeBars"></div>
    </div>

    <div class="log-piece-section">
      <button type="button" class="log-piece-toggle" id="logPieceToggle">+ Log a new piece</button>
      <div class="log-piece-form" id="logPieceForm">
      <div class="field photo-stage-field"><label>Photos</label><div id="logPhotoStage"></div></div>
      <div class="form-grid-4">
        <div class="field"><label for="fName">Item</label>
          <input type="text" id="fName" placeholder="e.g. Fender Stratocaster"></div>
        <div class="field"><label for="fBrand">Brand</label>
          <input type="text" id="fBrand" list="brandSuggestions" placeholder="e.g. Fender">
          <datalist id="brandSuggestions"></datalist>
        </div>
        <div class="field"><label for="fProduction">Production</label>
          <input type="text" id="fProduction" list="productionSuggestions" placeholder="e.g. Coldplay">
          <datalist id="productionSuggestions"></datalist>
        </div>
        <div class="field"><label for="fSource">Source</label>
          <input type="text" id="fSource" list="sourceSuggestions" placeholder="e.g. Propstore">
          <datalist id="sourceSuggestions"></datalist>
        </div>
      </div>
      <div class="form-grid-4">
        <div class="field"><label for="fType">Type</label><select id="fType"></select></div>
        <div class="field"><label for="fCat">Category</label><select id="fCat"></select>
          <div class="cat-hint" id="catHint">&nbsp;</div></div>
        <div class="field"><label>Paid</label>
          <div class="price-row">
            <select id="fCurrency"><option value="USD">$ USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option></select>
            <input type="number" id="fPrice" placeholder="0" min="0" step="0.01">
          </div>
        </div>
        <div class="field"><label for="fInsured">Insured value (optional)</label>
          <input type="number" id="fInsured" placeholder="0" min="0" step="0.01"></div>
      </div>
      <div class="form-grid-2">
        <div class="field" style="grid-column: span 2;"><label for="fSet">Part of a set (optional)</label>
          <input type="text" id="fSet" list="setSuggestions" placeholder="e.g. Everyday Life Stage Outfit">
          <datalist id="setSuggestions"></datalist>
        </div>
      </div>
      <button type="button" class="doc-toggle" id="docToggle">+ Documentation & notes (optional)</button>
      <div class="doc-section" id="docSection">
        <div class="form-grid-4">
          <div class="field" style="align-self:center;padding-top:18px;">
            <label style="display:flex;align-items:center;gap:7px;cursor:pointer;">
              <input type="checkbox" id="fHasCoa" style="width:auto;"> Has COA / certificate
            </label>
          </div>
          <div class="field"><label for="fAppraisalDate">Appraisal date</label>
            <input type="date" id="fAppraisalDate"></div>
          <div class="field"><label for="fAppraisedBy">Appraised by</label>
            <input type="text" id="fAppraisedBy" list="appraiserSuggestions" placeholder="e.g. Heritage Auctions">
            <datalist id="appraiserSuggestions"></datalist>
          </div>
          <div class="field"><label for="fProvenance">Provenance / ownership history</label>
            <input type="text" id="fProvenance" placeholder="e.g. Purchased from original owner, 2019"></div>
        </div>
        <div class="form-grid-2">
          <div class="field" style="grid-column: span 2;"><label for="fNotes">Notes</label>
            <input type="text" id="fNotes" placeholder="Anything worth remembering about this piece"></div>
        </div>
      </div>
      <div class="form-grid-3">
        <div class="field"><label for="fLoc">Location</label>
          <input type="text" id="fLoc" list="locationSuggestions" placeholder="e.g. Rack 2, shelf B">
          <datalist id="locationSuggestions"></datalist>
        </div>
        <div class="field"><label for="fDate">Date acquired</label>
          <input type="date" id="fDate"></div>
        <div class="field"><label for="fMinOffer">Min offer (optional)</label>
          <input type="number" id="fMinOffer" placeholder="0" min="0" step="0.01"></div>
        <button class="btn-add" id="addBtn">Add to log</button>
      </div>
      </div>
    </div>

    <div class="collection-toolbar">
      <div class="search-field">
        <input type="text" id="search" placeholder="Search collection…">
      </div>
      <div class="filter-group">
        <div class="filter-dd">
          <button type="button" class="filter-trigger" id="catFilterTrigger">Category</button>
          <div class="filter-popover" id="catFilterPopover">
            <label class="filter-pop-label">Type</label>
            <select id="typeFilterSelect"></select>
            <label class="filter-pop-label">Subcategory</label>
            <select id="subFilter"></select>
          </div>
        </div>
        <div class="filter-dd">
          <button type="button" class="filter-trigger" id="locFilterTrigger">Location</button>
          <div class="filter-popover" id="locFilterPopover">
            <label class="filter-pop-label">Location</label>
            <select id="locationFilterSelect"><option value="All">All locations</option></select>
          </div>
        </div>
        <div class="filter-dd">
          <button type="button" class="filter-trigger" id="statusFilterTrigger">Status</button>
          <div class="filter-popover" id="statusFilterPopover">
            <label class="filter-pop-label">Item status</label>
            <select id="itemStatusFilterSelect">
              <option value="all">All statuses</option>
              <option value="collection">In collection</option>
              <option value="consigned">Consigned</option>
              <option value="loaned">On loan</option>
              <option value="sold">Sold</option>
            </select>
            <label class="filter-check"><input type="checkbox" id="unverifiedOnly"> Unverified only</label>
          </div>
        </div>
        <select id="sort" class="sort-select">
          <option value="date-desc">Newest first</option>
          <option value="date-asc">Oldest first</option>
          <option value="price-desc">Price: high to low</option>
          <option value="price-asc">Price: low to high</option>
          <option value="name-asc">Name: A-Z</option>
        </select>
        <div class="view-toggle">
          <button class="vt-btn" data-view="gallery" title="Gallery view">Gallery</button>
          <button class="vt-btn" data-view="list" title="List view">List</button>
        </div>
      </div>
    </div>
    <div class="active-filters" id="activeFilters"></div>

    <div class="row collection-row catalogue-head" id="catalogueHead">
      <div></div>
      <div class="col-head">Object</div>
      <div class="col-head">Classification</div>
      <div class="col-head" style="text-align:right;">Value</div>
      <div class="col-head">Location</div>
      <div class="col-head">Date</div>
      <div class="col-head" style="text-align:right;">Actions</div>
    </div>
    <div id="list"></div>

    <footer>
      <div class="count" id="visCount"></div>
      <div class="file-actions">
        <a class="btn-ghost" id="exportCsv" href="#" download="rack-ledger.csv">Export CSV</a>
        <span class="footer-backup-hint">Full backup &amp; restore: use <strong>Backup</strong> in the top navigation.</span>
      </div>
    </footer>
  </div>

  <!-- ===================== WISHLIST TAB ===================== -->
  <div class="tabpane" id="tab-wishlist">
    <div class="currency-cards" id="wishlistStatCards" style="margin-bottom:20px;"></div>

    <div class="panel">
      <div class="panel-label">Add to wishlist</div>
      <div class="field photo-stage-field"><label>Photos</label><div id="wishPhotoStage"></div></div>
      <div class="form-grid-4">
        <div class="field"><label for="wName">Item</label>
          <input type="text" id="wName" placeholder="e.g. 1959 Gibson Les Paul Standard"></div>
        <div class="field"><label for="wBrand">Brand</label>
          <input type="text" id="wBrand" list="brandSuggestions" placeholder="e.g. Gibson"></div>
        <div class="field"><label for="wProduction">Production</label>
          <input type="text" id="wProduction" list="productionSuggestions" placeholder="e.g. Coldplay"></div>
        <div class="field"><label for="wSource">Source</label>
          <input type="text" id="wSource" list="sourceSuggestions" placeholder="e.g. Propstore, eBay"></div>
      </div>
      <div class="form-grid-2">
        <div class="field"><label for="wType">Type</label><select id="wType"></select></div>
        <div class="field"><label for="wCat">Category</label><select id="wCat"></select></div>
        <div class="field"><label>Est. price</label>
          <div class="price-row">
            <select id="wCurrency"><option value="USD">$ USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option></select>
            <input type="number" id="wPrice" placeholder="0" min="0" step="0.01">
          </div>
        </div>
        <div class="field"><label for="wPriority">Priority</label>
          <select id="wPriority"><option value="High">High</option><option value="Medium" selected>Medium</option><option value="Low">Low</option></select></div>
      </div>
      <div class="form-grid-3">
        <div class="field" style="grid-column:span 2;"><label for="wNotes">Notes</label>
          <input type="text" id="wNotes" placeholder="where to find it, contact, link..."></div>
        <div class="field"></div>
        <button class="btn-add wishlist-btn" id="addWishlistBtn">Add to wishlist</button>
      </div>
    </div>
    <div id="wishlist-list"></div>
  </div>

  <!-- ===================== CATALOGUE TAB ===================== -->
  <div class="tabpane" id="tab-catalogue">
    <div id="catalogueRoot"></div>
  </div>

  <!-- ===================== EXPENSES TAB ===================== -->
  <div class="tabpane" id="tab-expenses">

    <div class="currency-cards" id="expenseStatCards" style="margin-bottom:20px;"></div>

    <div class="panel bars-panel">
      <div class="panel-label">Spend by type</div>
      <div id="expenseBars"></div>
    </div>

    <div class="panel">
      <div class="panel-label">Log an expense</div>
      <div class="form-grid-2">
        <div class="field"><label for="eType">Type</label><select id="eType"></select></div>
        <div class="field"><label>Amount</label>
          <div class="price-row">
            <select id="eCurrency"><option value="USD">$ USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option></select>
            <input type="number" id="eAmount" placeholder="0" min="0" step="0.01">
          </div>
        </div>
        <div class="field"><label for="eLinked">Linked item (optional)</label><select id="eLinked"><option value="">None</option></select></div>
        <div class="field checkfield"><input type="checkbox" id="eRecurring"><label for="eRecurring" style="margin:0;">Monthly recurring</label></div>
      </div>
      <div class="form-grid-3">
        <div class="field" style="grid-column:span 3;"><label for="eNote">Note</label>
          <input type="text" id="eNote" placeholder="e.g. Climate-controlled unit, Q3 rent"></div>
        <button class="btn-add expense-btn" id="addExpenseBtn">Add expense</button>
      </div>
    </div>

    <div id="expense-list"></div>

    <footer>
      <div class="count" id="expenseVisCount"></div>
      <div class="file-actions">
        <a class="btn-ghost" id="exportExpenseCsv" href="#" download="rack-ledger-expenses.csv">Export CSV</a>
      </div>
    </footer>
  </div>

  <!-- ===================== EXIT VALUE TAB ===================== -->
  <div class="tabpane" id="tab-exit">
    <div class="goal-section" id="exitValueBanner"></div>
    <div class="currency-cards" id="exitStatCards" style="margin-bottom:20px;"></div>
    <div class="row exit-row" style="background:none;border:none;box-shadow:none;padding:0 15px;margin-bottom:6px;">
      <div></div>
      <div class="bar-label">Item</div>
      <div class="bar-label" style="text-align:right;">Paid</div>
      <div class="bar-label" style="text-align:right;">Min offer</div>
      <div class="bar-label" style="text-align:right;">Profit</div>
      <div class="bar-label" style="text-align:right;">Return</div>
    </div>
    <div id="exit-list"></div>

    <div class="panel" style="margin-top:24px;">
      <div class="panel-label">Sold archive</div>
      <div class="row exit-row" style="background:none;border:none;box-shadow:none;padding:0 15px;margin-bottom:6px;">
        <div></div>
        <div class="bar-label">Item</div>
        <div class="bar-label" style="text-align:right;">Paid</div>
        <div class="bar-label" style="text-align:right;">Sold for</div>
        <div class="bar-label" style="text-align:right;">Profit</div>
        <div class="bar-label" style="text-align:right;">Return</div>
      </div>
      <div id="soldArchiveList"></div>
    </div>
  </div>

  <!-- ===================== LEDGER TAB ===================== -->
  <div class="tabpane" id="tab-ledger">
    <div class="panel">
      <div class="panel-label">People</div>
      <div class="ledger-add-contact">
        <input type="text" id="newContactName" placeholder="e.g. Lionel">
        <button class="btn-ghost" id="addContactBtn">Add person</button>
      </div>
      <div id="contactCards" class="contact-grid"></div>
    </div>

    <div class="panel" id="ledgerDetailPanel" style="display:none;">
      <div class="ledger-detail-header">
        <div>
          <div class="panel-label" id="ledgerDetailName">&nbsp;</div>
          <div class="ledger-detail-balance" id="ledgerDetailBalance"></div>
        </div>
        <div class="ledger-detail-actions">
          <button class="btn-ghost" id="closeLedgerDetail">Close</button>
          <button class="icon-btn del" id="deleteContactBtn">Delete person</button>
        </div>
      </div>

      <div class="ledger-entry-form">
        <div class="ledger-type-toggle">
          <button class="ledger-type-btn active" data-entrytype="batch" id="ledgerTypeBatch">Batch (they sold me)</button>
          <button class="ledger-type-btn" data-entrytype="payment" id="ledgerTypePayment">Payment (I paid them)</button>
        </div>
        <div class="form-grid-3">
          <div class="field"><label for="ledgerAmount">Amount</label><input type="number" id="ledgerAmount" placeholder="0" min="0" step="0.01"></div>
          <div class="field"><label for="ledgerCurrency">Currency</label>
            <select id="ledgerCurrency"><option value="GBP">GBP</option><option value="USD">USD</option><option value="EUR">EUR</option></select>
          </div>
          <div class="field"><label for="ledgerDate">Date</label><input type="date" id="ledgerDate"></div>
        </div>
        <div class="form-grid-3">
          <div class="field" style="grid-column:1/3;"><label for="ledgerNote">Note (optional)</label><input type="text" id="ledgerNote" placeholder="e.g. Batch 2 — 12 items"></div>
          <button class="btn-add" id="addLedgerEntryBtn" style="align-self:end;">Add entry</button>
        </div>
      </div>

      <div id="ledgerEntryList"></div>
    </div>
  </div>

  <!-- ===================== CONSIGNMENTS TAB ===================== -->
  <div class="tabpane" id="tab-consign">
    <div class="currency-cards" id="consignStatCards" style="margin-bottom:20px;"></div>

    <div class="panel">
      <div class="panel-label">Send a piece to auction</div>
      <div class="form-grid-4">
        <div class="field"><label for="cnItemSelect">Item (from your collection)</label>
          <select id="cnItemSelect"><option value="">Select an item to consign\u2026</option></select>
        </div>
        <div class="field"><label for="cnHouse">Auction house</label>
          <input type="text" id="cnHouse" list="houseSuggestions" placeholder="e.g. Julien's Auctions">
          <datalist id="houseSuggestions"></datalist>
        </div>
        <div class="field"><label for="cnLot">Lot number (optional)</label>
          <input type="text" id="cnLot" placeholder="e.g. Lot 214"></div>
        <div class="field"><label for="cnSaleDate">Sale date</label>
          <input type="date" id="cnSaleDate"></div>
      </div>
      <div class="ledger-type-toggle">
        <button type="button" class="listing-type-btn active" data-listingtype="auction">Auction (estimate range)</button>
        <button type="button" class="listing-type-btn" data-listingtype="buyNow">Buy Now (fixed price)</button>
      </div>
      <div class="form-grid-4">
        <div class="field"><label for="cnEstLow" id="cnEstLowLabel">Estimate low</label>
          <input type="number" id="cnEstLow" placeholder="0" min="0" step="0.01"></div>
        <div class="field" id="cnEstHighField"><label for="cnEstHigh">Estimate high</label>
          <input type="number" id="cnEstHigh" placeholder="0" min="0" step="0.01"></div>
        <div class="field"><label for="cnCurrency">Currency</label>
          <select id="cnCurrency"><option value="USD">$ USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option></select></div>
        <div class="field"><label for="cnStatus">Status</label>
          <select id="cnStatus">
            <option value="listed">Awaiting sale</option>
            <option value="sold">Sold</option>
            <option value="unsold">Unsold (passed)</option>
            <option value="returning">Returning to me</option>
          </select>
        </div>
      </div>
      <div class="form-grid-2">
        <div class="field" style="grid-column: span 2;"><label for="cnCurrentLoc">Current location (optional)</label>
          <input type="text" id="cnCurrentLoc" list="locationSuggestions" placeholder="Leave blank to assume it's still at the auction house">
        </div>
      </div>
      <div class="form-grid-3">
        <div class="field"><label for="cnSoldPrice">Sold price (if sold)</label><input type="number" id="cnSoldPrice" placeholder="0" min="0" step="0.01"></div>
        <div class="field" style="grid-column:2/4;"><label for="cnNote">Note (optional)</label><input type="text" id="cnNote" placeholder="e.g. Sent via courier, consignment ID #4521"></div>
        <button class="btn-add" id="addConsignBtn">Send to consignment</button>
      </div>
    </div>

    <div class="chips" id="consignStatusChips"></div>
    <div class="controls">
      <input type="text" id="consignSearch" placeholder="Search item, auction house, lot...">
      <select id="consignHouseFilter"><option value="All">All auction houses</option></select>
      <select id="consignSort">
        <option value="newest">Sale date: soonest first</option>
        <option value="oldest">Sale date: latest first</option>
        <option value="high">Estimate: high to low</option>
        <option value="low">Estimate: low to high</option>
      </select>
      <div class="view-toggle">
        <button class="consign-vt-btn" data-view="gallery">Gallery</button>
        <button class="consign-vt-btn" data-view="list">List</button>
      </div>
    </div>

    <div id="consignCards" class="consign-grid"></div>
  </div>

  <!-- ===================== LOANS TAB ===================== -->
  <div class="tabpane" id="tab-loans">
    <div class="currency-cards" id="loanStatCards" style="margin-bottom:20px;"></div>

    <div class="panel">
      <div class="panel-label">Loan a piece out</div>
      <div class="form-grid-4">
        <div class="field"><label for="lnItemSelect">Item (from your collection)</label>
          <select id="lnItemSelect"><option value="">Select an item to loan out\u2026</option></select>
        </div>
        <div class="field"><label for="lnBorrower">Borrower / Exhibition</label>
          <input type="text" id="lnBorrower" list="borrowerSuggestions" placeholder="e.g. Rock & Roll Hall of Fame">
          <datalist id="borrowerSuggestions"></datalist>
        </div>
        <div class="field"><label for="lnLoanDate">Loan date</label>
          <input type="date" id="lnLoanDate"></div>
        <div class="field"><label for="lnReturnDate">Expected return</label>
          <input type="date" id="lnReturnDate"></div>
      </div>
      <div class="form-grid-3">
        <div class="field" style="grid-column:1/3;"><label for="lnNote">Note (optional)</label><input type="text" id="lnNote" placeholder="e.g. Insured in transit by the museum"></div>
        <button class="btn-add" id="addLoanBtn">Send on loan</button>
      </div>
    </div>

    <div class="chips" id="loanStatusChips"></div>
    <div class="controls" style="justify-content:flex-end;">
      <div class="view-toggle">
        <button class="loan-vt-btn" data-view="gallery">Gallery</button>
        <button class="loan-vt-btn" data-view="list">List</button>
      </div>
    </div>
    <div id="loanCards" class="consign-grid"></div>
  </div>

</div>

